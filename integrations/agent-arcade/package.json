{
  "name": "agent-arcade",
  "version": "0.4.0-preview.61.personal.32",
  "description": "One desktop home for AI companions, social accounts and agent tasks.",
  "main": "src/bootstrap.cjs",
  "private": true,
  "author": "Agent Arcade contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm --prefix social start",
    "test": "npm --prefix social test",
    "build:pets": "node scripts/build-pets.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ray0766/agent-arcade.git"
  },
  "homepage": "https://github.com/Ray0766/agent-arcade#readme",
  "bugs": "https://github.com/Ray0766/agent-arcade/issues",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "playwright": "1.64.1",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "io.github.agentarcade.desktop",
    "productName": "Agent Arcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "LICENSE-MIT-HISTORICAL",
      "THIRD_PARTY_NOTICES.md",
      "LICENSES/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk{,-*}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "src/assets/voice/serena-reference.wav",
      "src/bot/native-channel.cjs",
      "src/core/personas.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/app.ico",
      "signExecutable": false
    },
    "mac": {
      "extraResources": [
        {
          "from": "node_modules/three/examples/jsm",
          "to": "desktop-pet-addons",
          "filter": [
            "loaders/GLTFLoader.js",
            "utils/BufferGeometryUtils.js",
            "utils/SkeletonUtils.js"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/app-mac.png",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "additionalArguments": [
        "--options",
        "runtime,hard,kill"
      ],
      "artifactName": "Agent-Arcade-Personal-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "artifactName": "Agent-Arcade-Personal-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@serialport/bindings-cpp": "13.0.1",
    "qrcode": "1.5.4",
    "silk-wasm": "3.7.1",
    "three": "0.187.0",
    "ws": "8.22.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
