SOCIAL_HOST=127.0.0.1
SOCIAL_PORT=8787
SOCIAL_PUBLIC_ORIGIN=https://social.example.com
# Optional: the same world origin embedded in the desktop release.
# LITTLE_WORLDS_ORIGIN=https://world.example.com
SOCIAL_DB=/var/lib/agent-arcade-social/social.sqlite
# Optional for local testing. Set both for a public deployment.
# SOCIAL_PUBLIC_OPERATOR_NAME=
# SOCIAL_PUBLIC_PRIVACY_CONTACT=
# Optional. Leave unset on a human-only service.
# SOCIAL_DEEPSEEK_KEY=
# Optional single-workspace Anthropic API key for Ju in direct and group chats.
# SOCIAL_ANTHROPIC_KEY=
# Optional OpenAI Responses API credential for Dragon Girl in direct and group chats.
# SOCIAL_OPENAI_KEY=
# Optional group cloud drawing via a Workers AI token kept on the service host.
# SOCIAL_CLOUDFLARE_ACCOUNT_ID=
# SOCIAL_CLOUDFLARE_API_TOKEN=
# SOCIAL_CLOUDFLARE_DRAW_DAILY=12
# Optional Azure Speech resource for natural Mandarin AI replies.
# SOCIAL_AZURE_SPEECH_REGION=
# SOCIAL_AZURE_SPEECH_KEY=
