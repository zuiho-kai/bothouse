diff --git a/packages/acp/acp/src/live-text.ts b/packages/acp/acp/src/live-text.ts
new file mode 100644
index 0000000000..8bacfd1193
--- /dev/null
+++ b/packages/acp/acp/src/live-text.ts
@@ -0,0 +1,113 @@
+/** Ordered transient text projection; committed events supply non-text content. */
+import type { AssistantStreamFrame } from '@deepseek-ai/dsh-agent'
+import type { SessionUpdate } from '@agentclientprotocol/sdk'
+import type { ContentBlock } from '@deepseek-ai/dsh-llm'
+import { publicReplyText } from './public-reply.ts'
+
+/** One opt-in attempt's text offsets, owned by its ACP session. */
+export class AcpLiveText {
+  private readonly blocks = new Map<number, { type: string; text: string; sent: number; closed: boolean }>()
+  private attempt: Extract<AssistantStreamFrame, { type: 'start' }> | undefined
+
+  constructor(private readonly publicReplyJson = false) {}
+
+  /**
+   * Whether the live attempt owns this committed message.
+   * @param turn - Committed message's turn.
+   * @param step - Committed message's step.
+   * @returns Whether both belong to the live attempt.
+   */
+  matches(turn: number, step: number): boolean {
+    return this.attempt?.turn === turn && this.attempt.step === step
+  }
+
+  /**
+   * Reject late frames from a replaced attempt.
+   * @param frame - Incoming transient frame.
+   * @returns Whether the current attempt owns the frame.
+   */
+  owns(frame: AssistantStreamFrame): boolean {
+    return this.attempt?.attemptId === frame.attemptId
+  }
+
+  /**
+   * Flush authoritative text, including blocks whose earlier peer never closed.
+   * @param content - Committed blocks assembled from the same attempt.
+   * @returns Newly available text updates in block order.
+   */
+  complete(content: readonly ContentBlock[]): SessionUpdate[] {
+    const texts = content.filter(block => block.type === 'text')
+    let index = 0
+    for (const block of this.blocks.values()) {
+      if (block.type === 'text') {
+        const text = publicReplyText(texts[index++]?.text ?? '', this.publicReplyJson)
+        if (!text.startsWith(block.text.slice(0, block.sent))) throw new Error('committed text changed its streamed prefix')
+        block.text = text
+      }
+      block.closed = true
+    }
+    return this.flush()
+  }
+
+  /**
+   * Apply an owned attempt frame; reasoning and tool deltas stay unpublished.
+   * @param frame - Incoming frame owned by this session.
+   * @returns Newly available text updates in block order.
+   */
+  push(frame: AssistantStreamFrame): SessionUpdate[] {
+    if (frame.type === 'start') {
+      this.blocks.clear()
+      this.attempt = frame
+      return []
+    }
+    if (this.attempt?.attemptId !== frame.attemptId) return []
+    if (frame.type === 'end') {
+      this.attempt = undefined
+      return []
+    }
+    const chunk = frame.chunk
+    if (!('index' in chunk)) return []
+    const type = chunk.type === 'block-start' ? chunk.blockType
+      : chunk.type === 'block-end' ? chunk.block.type
+        : chunk.type === 'text-delta' ? 'text' : chunk.type === 'reasoning-delta' ? 'reasoning' : 'tool-call'
+    let block = this.blocks.get(chunk.index)
+    if (block === undefined) {
+      block = { type, text: '', sent: 0, closed: false }
+      this.blocks.set(chunk.index, block)
+    }
+    if (block.closed) return []
+    if (chunk.type === 'text-delta') block.text += chunk.text
+    if (chunk.type === 'block-end') {
+      if (chunk.block.type === 'text') {
+        const text = publicReplyText(chunk.block.text, this.publicReplyJson)
+        if (!text.startsWith(block.text.slice(0, block.sent))) throw new Error('streamed text was rewritten')
+        block.text = text
+      }
+      block.closed = true
+    }
+    return this.flush()
+  }
+
+  private flush(): SessionUpdate[] {
+    const attempt = this.attempt
+    if (attempt === undefined) return []
+    const updates: SessionUpdate[] = []
+    for (const [index, current] of this.blocks) {
+      if (current.type === 'text' && current.text.length > current.sent) {
+        updates.push({
+          sessionUpdate: 'agent_message_chunk',
+          messageId: `${attempt.attemptId}:${index}`,
+          content: { type: 'text', text: current.text.slice(current.sent) },
+        })
+        current.sent = current.text.length
+      }
+      if (!current.closed) break
+    }
+    return updates
+  }
+
+  /** A failed published prefix cannot be silently replaced by a retry. */
+  get published(): boolean {
+    return [...this.blocks.values()].some(block => block.sent > 0)
+  }
+}
diff --git a/packages/acp/acp/src/public-reply.ts b/packages/acp/acp/src/public-reply.ts
new file mode 100644
index 0000000000..9342b422aa
--- /dev/null
+++ b/packages/acp/acp/src/public-reply.ts
@@ -0,0 +1,19 @@
+/**
+ * Decode the opt-in public-reply envelope only for ACP presentation.
+ * @param text - Authoritative text from the paired public-output producer.
+ * @param enabled - Whether this deployment retains JSON in model history.
+ * @returns Public text without changing the durable model message.
+ * @throws When an enabled producer supplies an invalid envelope; stop delivery.
+ */
+export function publicReplyText(text: string, enabled: boolean): string {
+  if (!enabled || text === 'NO_REPLY') return text
+  let value: unknown
+  try { value = JSON.parse(text) } catch (_error) {
+    // JSON parser errors may quote rejected model text; keep diagnostics fixed.
+    throw new Error('ACP public reply envelope is not valid JSON')
+  }
+  if (value === null || typeof value !== 'object' || Array.isArray(value)
+    || Object.keys(value).length !== 1 || !('reply' in value) || typeof value.reply !== 'string'
+    || value.reply.trim().length === 0) throw new Error('ACP public reply envelope requires one nonempty reply')
+  return value.reply
+}
