+/** Transient text preserves block order and committed prefixes. */
+import { expect, it } from 'vitest'
+import { LlmAttemptId, type StreamChunk } from '@deepseek-ai/dsh-llm'
+import { AcpLiveText } from '../src/live-text.ts'
+
+const attemptId = LlmAttemptId('fixture:1')
+const start = { type: 'start' as const, attemptId, revision: 1, turn: 1, step: 1 }
+const chunk = (value: StreamChunk) => ({ type: 'chunk' as const, attemptId, revision: 2, index: 0, time: 0, chunk: value })
+
+it('holds later blocks until an earlier delta-only reasoning block commits', () => {
+  const live = new AcpLiveText()
+  live.push(start)
+  expect(live.push(chunk({ type: 'reasoning-delta', index: 3, text: 'private' }))).toEqual([])
+  expect(live.push(chunk({ type: 'text-delta', index: 7, text: 'public' }))).toEqual([])
+  const updates = live.complete([{ type: 'reasoning', text: 'private' }, { type: 'text', text: 'public' }])
+  expect(updates).toHaveLength(1)
+  expect(updates[0]).toMatchObject({ sessionUpdate: 'agent_message_chunk', content: { text: 'public' } })
+  expect(live.complete([{ type: 'reasoning', text: 'private' }, { type: 'text', text: 'public' }])).toEqual([])
+})
+
+it('never accepts an authoritative rewrite of already published text', () => {
+  const live = new AcpLiveText()
+  live.push(start)
+  live.push(chunk({ type: 'text-delta', index: 0, text: 'yes' }))
+  expect(() => live.push(chunk({ type: 'block-end', index: 0, block: { type: 'text', text: 'no' } }))).toThrow('rewritten')
+  expect(() => live.complete([{ type: 'text', text: 'no' }])).toThrow('changed')
+})
+
+it('ignores frames from a different attempt and keeps sessions independent', () => {
+  const first = new AcpLiveText(), second = new AcpLiveText()
+  first.push(start)
+  second.push({ ...start, attemptId: LlmAttemptId('fixture:2') })
+  const frame = chunk({ type: 'text-delta', index: 0, text: 'one' })
+  expect(first.push(frame)).toHaveLength(1)
+  expect(second.push(frame)).toEqual([])
+  expect(second.published).toBe(false)
+  expect(first.matches(1, 1)).toBe(true)
+  expect(first.matches(1, 2)).toBe(false)
+})
