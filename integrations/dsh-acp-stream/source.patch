+import { PROTOCOL_VERSION } from '@agentclientprotocol/sdk'
+import { mkdtemp } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { makeBridgeHarness, textResponse, errorResponse, type BridgeHarness } from './harness.ts'
+
+let harness: BridgeHarness | undefined
+afterEach(async () => { await harness?.dispose(); harness = undefined })
+
+it('streams the first character while the model is paused and does not replay committed text', async () => {
+  const release = Promise.withResolvers<undefined>()
+  const paused = Promise.withResolvers<undefined>()
+  const persistenceRoot = await mkdtemp(join(tmpdir(), 'dsh-live-stream-'))
+  harness = await makeBridgeHarness({ persistenceRoot, script: [textResponse('你好。')], config: { streamText: true } })
+  harness.ctx.on('llm/stream', async function* (_options, next) {
+    let first = true
+    for await (const chunk of next()) {
+      yield chunk
+      if (chunk.type === 'text-delta' && first) {
+        first = false
+        paused.resolve(undefined)
+        await release.promise
+      }
+    }
+  })
+  await harness.client.initialize({ protocolVersion: PROTOCOL_VERSION, clientCapabilities: {} })
+  const { sessionId } = await harness.client.newSession({ cwd: process.cwd(), mcpServers: [] })
+  let done = false
+  const prompt = harness.client.prompt({ sessionId, prompt: [{ type: 'text', text: 'hello' }] }).finally(() => { done = true })
+  const text = () => harness!.updates.flatMap(update => update.sessionUpdate === 'agent_message_chunk' && update.content.type === 'text' ? [update.content.text] : []).join('')
+  try {
+    await paused.promise
+    await vi.waitFor(() => { expect(text()).toBe('你') }, { timeout: 500 })
+    expect(done).toBe(false)
+  } finally {
+    release.resolve(undefined)
+    await prompt
+  }
+  expect(text()).toBe('你好。')
+})
+
+it('fails a published prefix instead of silently recovering into a different answer', async () => {
+  const persistenceRoot = await mkdtemp(join(tmpdir(), 'dsh-live-failure-'))
+  harness = await makeBridgeHarness({ persistenceRoot, script: [errorResponse('fixture failure'), textResponse('replacement')], config: { streamText: true } })
+  await harness.client.initialize({ protocolVersion: PROTOCOL_VERSION, clientCapabilities: {} })
+  const { sessionId } = await harness.client.newSession({ cwd: process.cwd(), mcpServers: [] })
+  await expect(harness.client.prompt({ sessionId, prompt: [{ type: 'text', text: 'hello' }] })).rejects.toThrow()
+  const text = harness.updates.flatMap(update => update.sessionUpdate === 'agent_message_chunk' && update.content.type === 'text' ? [update.content.text] : []).join('')
+  expect(text).toBe('partial')
+  expect(harness.adapter.requests).toHaveLength(1)
+})
+
+it('cancels a live prefix and keeps the next prompt independent', async () => {
+  const persistenceRoot = await mkdtemp(join(tmpdir(), 'dsh-live-cancel-'))
+  harness = await makeBridgeHarness({ persistenceRoot, script: ['hang', textResponse('fresh')], config: { streamText: true } })
+  await harness.client.initialize({ protocolVersion: PROTOCOL_VERSION, clientCapabilities: {} })
+  const { sessionId } = await harness.client.newSession({ cwd: process.cwd(), mcpServers: [] })
+  const prompt = harness.client.prompt({ sessionId, prompt: [{ type: 'text', text: 'hello' }] })
+  await vi.waitFor(() => { expect(harness!.updates.some(update => update.sessionUpdate === 'agent_message_chunk')).toBe(true) })
+  await harness.client.cancel({ sessionId })
+  expect((await prompt).stopReason).toBe('cancelled')
+  const before = harness.updates.length
+  await harness.client.prompt({ sessionId, prompt: [{ type: 'text', text: 'again' }] })
+  const text = harness.updates.slice(before).flatMap(update => update.sessionUpdate === 'agent_message_chunk' && update.content.type === 'text' ? [update.content.text] : []).join('')
+  expect(text).toBe('fresh')
+})
