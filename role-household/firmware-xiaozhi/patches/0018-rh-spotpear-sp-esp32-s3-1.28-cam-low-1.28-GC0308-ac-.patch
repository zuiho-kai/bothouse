@@ -0,0 +1,72 @@
+#ifndef _BOARD_CONFIG_H_
+#define _BOARD_CONFIG_H_
+
+// Spotpear ESP32-S3 1.28" CAM (low = GC0308 0.3MP camera), board ac:a7:04:22:8c:f4.
+// Pins from Spotpear's own board (xiaozhi-esp32-2.1.0 archive linked from
+// https://spotpear.com/index.php/wiki/ESP32-S3-1.28-inch-Camera-LCD-Display-Deepseek.html,
+// main/boards/sp-esp32-s3-1.28-cam-low/config.h; the factory image on this board was built from that
+// directory: backup/full-aca704228cf4.bin has ./main/boards/sp-esp32-s3-1.28-cam-low/*.cc) and
+// checked against vendor/zhengchen-share/spotpear_ESP32S3-1.28inch-AI-CAM.pdf netlist.
+// Differences from sp-esp32-s3-1.28-box: LCD reset is an RC on the board (net LCD_RST only C22/R6,
+// no GPIO; GPIO38 is camera D6 here), no PA GPIO (GPIO46 is camera HREF), no LED GPIO
+// (GPIO48 is camera D7), no CST816D touch (GPIO6/7/11/12 are camera D1/D2/D3/XCLK).
+
+#include <driver/gpio.h>
+
+#define AUDIO_INPUT_SAMPLE_RATE  24000
+#define AUDIO_OUTPUT_SAMPLE_RATE 24000
+
+#define AUDIO_I2S_GPIO_MCLK GPIO_NUM_16 //MCLK
+#define AUDIO_I2S_GPIO_WS GPIO_NUM_45  //LRCK
+#define AUDIO_I2S_GPIO_BCLK GPIO_NUM_9 //SCLK
+#define AUDIO_I2S_GPIO_DIN  GPIO_NUM_10 //DOUT
+#define AUDIO_I2S_GPIO_DOUT GPIO_NUM_8  //DIN
+
+#define AUDIO_CODEC_PA_PIN       GPIO_NUM_NC
+#define AUDIO_CODEC_I2C_SDA_PIN  GPIO_NUM_15
+#define AUDIO_CODEC_I2C_SCL_PIN  GPIO_NUM_14
+#define AUDIO_CODEC_ES8311_ADDR  ES8311_CODEC_DEFAULT_ADDR
+
+#define BOOT_BUTTON_GPIO        GPIO_NUM_0
+
+
+#define DISPLAY_WIDTH   240
+#define DISPLAY_HEIGHT  240
+#define DISPLAY_MIRROR_X true
+#define DISPLAY_MIRROR_Y false
+#define DISPLAY_SWAP_XY false
+
+#define DISPLAY_OFFSET_X  0
+#define DISPLAY_OFFSET_Y  0
+
+
+#define DISPLAY_BACKLIGHT_PIN GPIO_NUM_42
+#define DISPLAY_BACKLIGHT_OUTPUT_INVERT true
+
+#define DISPLAY_SPI_SCLK_PIN    GPIO_NUM_4
+#define DISPLAY_SPI_MOSI_PIN    GPIO_NUM_2
+#define DISPLAY_SPI_CS_PIN      GPIO_NUM_5
+#define DISPLAY_SPI_DC_PIN      GPIO_NUM_47
+#define DISPLAY_SPI_RESET_PIN   GPIO_NUM_NC
+
+#define DISPLAY_SPI_SCLK_HZ     (40 * 1000 * 1000)
+
+// Camera (GC0308 DVP) not enabled yet; pins kept for later (vendor config.h).
+#define CAM_PIN_VSYNC   GPIO_NUM_43
+#define CAM_PIN_HREF    GPIO_NUM_46
+#define CAM_PIN_PCLK    GPIO_NUM_44
+#define CAM_PIN_XCLK    GPIO_NUM_12
+#define CAM_PIN_D0      GPIO_NUM_3
+#define CAM_PIN_D1      GPIO_NUM_6
+#define CAM_PIN_D2      GPIO_NUM_7
+#define CAM_PIN_D3      GPIO_NUM_11
+#define CAM_PIN_D4      GPIO_NUM_40
+#define CAM_PIN_D5      GPIO_NUM_39
+#define CAM_PIN_D6      GPIO_NUM_38
+#define CAM_PIN_D7      GPIO_NUM_48
+
+// 电量检测相关引脚定义
+#define BATTERY_ADC_PIN         GPIO_NUM_1  // 电池电压检测ADC引脚
+#define BATTERY_CHARGING_PIN    GPIO_NUM_41 // 充电状态检测引脚
+
+#endif // _BOARD_CONFIG_H_
