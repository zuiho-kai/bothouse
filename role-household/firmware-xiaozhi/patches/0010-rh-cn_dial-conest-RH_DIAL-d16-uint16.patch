+++ b/main/display/rh_dial_display.h
@@ -60,8 +60,13 @@ private:
         int ring_max;                                // widest thing on the rim (glow_max) + 1 AA px
     };
     static Sizes MakeSizes(const cn_dial::DialMetrics& m);
+    // The board's profile with w/h taken from the panel (the panel size wins; a mismatch is logged).
+    static cn_dial::ScreenProfile PanelProfile(cn_dial::ScreenProfile p, int width, int height);
     const cn_dial::DialMetrics metrics_;
     const Sizes sz_;
+    // False when the profile is invalid or the screen is below cn_dial's smallest supported short
+    // side (layout min_short_side): then no dial is built and the default UI stays.
+    const bool usable_;
 
     lv_obj_t* dial_ = nullptr;
     lv_obj_t* face_base_ = nullptr;
@@ -101,7 +106,9 @@ private:
     // What the edge drew last frame, to invalidate only when it changes.
     int64_t edge_key_ = -1;
     // Ring layers (see BuildRing): pixels within sz_.ring_max px of the rim, and three A8 layers.
-    struct RingPx { uint32_t idx; uint16_t ang10; uint8_t d16; };
+    // d16: depth below the rim in 1/16 px, < sz_.ring_max * 16. uint16_t: as uint8_t it wrapped
+    // from W = 1204 (ring_w 16, ring_max 17; conest firmware/dial TestRingDepth). Same 8 bytes.
+    struct RingPx { uint32_t idx; uint16_t ang10; uint16_t d16; };
     RingPx* ring_px_ = nullptr;
     int ring_n_ = 0;
     uint8_t* layer_px_[3] = {};
