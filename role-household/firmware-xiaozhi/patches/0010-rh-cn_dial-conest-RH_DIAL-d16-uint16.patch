+++ b/main/Kconfig.projbuild
@@ -61,13 +61,16 @@ config RH_REOPEN_DELAY_SEC
 config RH_DIAL
     bool "Show the role dial (same look as the hub web dial page) instead of the xiaozhi UI"
     default y
+    depends on BOARD_TYPE_SPOTPEAR_ESP32_S3_1_28_BOX
     help
         rh: draw the round dial of ~/code/role-household rh/static/dial.html with LVGL
         (avatar, name pill, idle breathe + glint, thinking spinner, speaking glow + bars,
         interrupted red ring) on top of the default emoji / subtitle / status bar UI,
         which stays hidden except in Wi-Fi config mode. Which role, name, colour, avatar
         and state come from the host ({"type":"rh_dial"} over the WebSocket); nothing
-        role-specific is compiled in. Only wired into spotpear sp-esp32-s3-1.28-box.
+        role-specific is compiled in. Only wired into spotpear sp-esp32-s3-1.28-box,
+        so only that board can turn it on (other boards then neither fetch conest's cn_dial
+        nor wait for the host's rh_dial before marking a new OTA image valid).
         Source: user 2026-10-19 「那个圆形表盘的那个动画啊，你给它放上去，而不是用现在默认傻逼小智的那个」;
         review ~/.claude/reviews/rh-board-dial.md (role pushed by host, not fixed in firmware).
 
diff --git a/main/display/rh_dial_display.cc b/main/display/rh_dial_display.cc
index 558980c..0d7ad5e 100644
--- a/main/display/rh_dial_display.cc
+++ b/main/display/rh_dial_display.cc
@@ -154,16 +154,36 @@ RhDialDisplay::RhDialDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_h
                              int width, int height, int offset_x, int offset_y, bool mirror_x,
                              bool mirror_y, bool swap_xy, const cn_dial::ScreenProfile& screen)
     : SpiLcdDisplay(panel_io, panel, width, height, offset_x, offset_y, mirror_x, mirror_y, swap_xy),
-      metrics_(screen),
+      metrics_(PanelProfile(screen, width, height)),
       sz_(MakeSizes(metrics_)),
+      usable_(metrics_.profile().Valid() && metrics_.Supported()),
       ring_upto_(sz_.ring_max + 1, 0) {
-    if (screen.w != width || screen.h != height) {
-        ESP_LOGE(TAG, "rh dial: screen profile %dx%d but panel %dx%d", screen.w, screen.h, width, height);
+    const char* why = nullptr;
+    if (!metrics_.profile().Valid(&why)) {
+        ESP_LOGE(TAG, "rh dial: screen profile invalid (%s), no dial", why);
+    } else if (!metrics_.Supported()) {
+        ESP_LOGE(TAG, "rh dial: short side %d px is below cn_dial's minimum %d px, no dial", metrics_.canvas(),
+                 cn_dial::layout::kMinShortSide);
+    }
+    // Pill text uses the board's theme font; the web pill font is 17 px (see the sizes note above).
+    if (!metrics_.pick_font(17).on_board) {
+        ESP_LOGW(TAG, "rh dial: the board has no font >= %d px (font_min_px); text may be too small",
+                 metrics_.profile().font_min_px);
     }
     color_ = lv_color_hex(kUnknownRole);
     dl_mutex_ = xSemaphoreCreateMutex();
 }
 
+cn_dial::ScreenProfile RhDialDisplay::PanelProfile(cn_dial::ScreenProfile p, int width, int height) {
+    if (p.w != width || p.h != height) {
+        ESP_LOGE(TAG, "rh dial: screen profile %dx%d but panel %dx%d, using the panel size", p.w, p.h, width,
+                 height);
+        p.w = width;
+        p.h = height;
+    }
+    return p;
+}
+
 RhDialDisplay::Sizes RhDialDisplay::MakeSizes(const cn_dial::DialMetrics& m) {
     namespace L = cn_dial::layout;
     Sizes z{};
@@ -226,6 +246,7 @@ void RhDialDisplay::BuildGlint() {
 
 void RhDialDisplay::SetupUI() {
     SpiLcdDisplay::SetupUI();  // default UI stays underneath (shown only in Wi-Fi config mode)
+    if (!usable_) return;      // logged in the constructor; dial_ stays nullptr, every entry point checks it
     DisplayLockGuard lock(this);
     const int W = width_, H = height_;
 
@@ -405,7 +426,7 @@ void RhDialDisplay::BuildRing() {
             // clockwise from 12 o'clock, 0.1 deg
             float a = atan2f(dx, -dy) * 180 / (float)M_PI;
             if (a < 0) a += 360;
-            px.push_back({(uint32_t)(y * W + x), (uint16_t)(a * 10), (uint8_t)(d * 16)});
+            px.push_back({(uint32_t)(y * W + x), (uint16_t)(a * 10), (uint16_t)(d * 16)});
         }
     }
     std::sort(px.begin(), px.end(), [](const RingPx& a, const RingPx& b) { return a.d16 < b.d16; });
diff --git a/main/display/rh_dial_display.h b/main/display/rh_dial_display.h
