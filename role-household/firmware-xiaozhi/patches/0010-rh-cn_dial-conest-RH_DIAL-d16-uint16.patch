+if(CONFIG_RH_DIAL)
+    list(APPEND MAIN_PRIV_REQUIRES_EXTRA cn_dial)
+endif()
 if(CONFIG_BOARD_TYPE_ESP32_P4_FUNCTION_EV_BOARD)
     list(APPEND MAIN_PRIV_REQUIRES_EXTRA
         esp_driver_sdmmc
@@ -1147,7 +1152,6 @@ idf_component_register(SRCS ${SOURCES}
                         bt
                         fatfs
                         xiaozhi-fonts
-                        cn_dial
                         ${MAIN_PRIV_REQUIRES_EXTRA}
                     )
 
