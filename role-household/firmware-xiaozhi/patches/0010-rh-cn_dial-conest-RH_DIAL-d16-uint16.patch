diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e3b3a8..f9ca3cf 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,17 +6,26 @@ cmake_minimum_required(VERSION 3.16)
 add_compile_options(-Wno-missing-field-initializers)
 
 # rh: the dial's screen profile / size maths (cn_dial) lives in the shared conest repo
-# (firmware/dial/components), so conest's dial changes are ours without copying. Default: the
-# local conest checkout next to this repo; override with CN_DIAL_COMPONENTS.
-if(DEFINED ENV{CN_DIAL_COMPONENTS})
-    set(CN_DIAL_COMPONENTS $ENV{CN_DIAL_COMPONENTS})
-else()
-    get_filename_component(CN_DIAL_COMPONENTS "${CMAKE_CURRENT_LIST_DIR}/../../ref-conest/src/firmware/dial/components" ABSOLUTE)
+# (firmware/dial/components/cn_dial). By default main/idf_component.yml fetches it from conest at a
+# pinned commit, and only when CONFIG_RH_DIAL is on (other boards never fetch conest).
+# To build against a local conest checkout instead, point CN_DIAL_COMPONENTS at its
+# firmware/dial/components: -DCN_DIAL_COMPONENTS=... (cache variable, wins) or the environment
+# variable of the same name (used when no -D/cache value is set). EXTRA_COMPONENT_DIRS outranks
+# managed_components (ESP-IDF build-system.rst "Multiple Components with the Same Name").
+set(_rh_cn_dial_dir "")
+if(DEFINED CACHE{CN_DIAL_COMPONENTS} AND NOT "$CACHE{CN_DIAL_COMPONENTS}" STREQUAL "")
+    set(_rh_cn_dial_dir "$CACHE{CN_DIAL_COMPONENTS}")
+elseif(NOT "$ENV{CN_DIAL_COMPONENTS}" STREQUAL "")
+    set(_rh_cn_dial_dir "$ENV{CN_DIAL_COMPONENTS}")   # not cached: unset it and the pin is back
 endif()
-if(NOT EXISTS "${CN_DIAL_COMPONENTS}/cn_dial/CMakeLists.txt")
-    message(FATAL_ERROR "cn_dial not found in ${CN_DIAL_COMPONENTS}: check out conest (firmware/dial) or set CN_DIAL_COMPONENTS")
+if(_rh_cn_dial_dir)
+    get_filename_component(_rh_cn_dial_dir "${_rh_cn_dial_dir}" ABSOLUTE)
+    if(NOT EXISTS "${_rh_cn_dial_dir}/cn_dial/CMakeLists.txt")
+        message(FATAL_ERROR "CN_DIAL_COMPONENTS=${_rh_cn_dial_dir} has no cn_dial/CMakeLists.txt")
+    endif()
+    message(STATUS "rh: cn_dial from ${_rh_cn_dial_dir} (not the pinned conest commit)")
+    list(APPEND EXTRA_COMPONENT_DIRS "${_rh_cn_dial_dir}")
 endif()
-list(APPEND EXTRA_COMPONENT_DIRS "${CN_DIAL_COMPONENTS}")
 
 include($ENV{IDF_PATH}/tools/cmake/project.cmake)
 # "Trim" the build. Include the minimal set of components, main, and anything it depends on.
