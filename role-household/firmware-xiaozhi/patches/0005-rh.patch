diff --git a/main/display/rh_dial_display.h b/main/display/rh_dial_display.h
new file mode 100644
index 0000000..c65682c
--- /dev/null
+++ b/main/display/rh_dial_display.h
@@ -0,0 +1,85 @@
+#pragma once
+// rh dial (CONFIG_RH_DIAL): the round role dial of the hub web page (~/code/role-household
+// rh/static/dial.html) drawn with LVGL on the board itself, covering the default xiaozhi
+// emoji / subtitle / status bar UI. Everything role-specific (id, name, colour, avatar
+// pictures) and the current state come from the host in {"type":"rh_dial",...} messages
+// (host side: rh/dial.py); the firmware is the same for every board.
+#include <sdkconfig.h>
+#if CONFIG_RH_DIAL
+
+#include "lcd_display.h"
+#include "lvgl_image.h"
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+
+#include <memory>
+#include <string>
+
+class RhDialDisplay : public SpiLcdDisplay {
+public:
+    RhDialDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel, int width,
+                  int height, int offset_x, int offset_y, bool mirror_x, bool mirror_y,
+                  bool swap_xy);
+    ~RhDialDisplay();
+
+    void SetupUI() override;
+    void RhDial(const cJSON* msg) override;
+    void RhDeviceState(int state) override;
+    void RhDialLink(bool connected) override;
+
+private:
+    enum State { kIdle = 0, kThinking, kSpeaking, kInterrupted };
+    static constexpr int kRingSegments = 12;
+    static constexpr int kBars = 5;   // dial.html BAR_N
+    static constexpr int kDots = 3;
+
+    lv_obj_t* dial_ = nullptr;
+    lv_obj_t* face_base_ = nullptr;
+    lv_obj_t* face_think_ = nullptr;
+    lv_obj_t* glint_ = nullptr;
+    lv_obj_t* ring_[kRingSegments] = {};
+    lv_obj_t* ring_full_ = nullptr;
+    lv_obj_t* glow_ = nullptr;
+    lv_obj_t* name_pill_ = nullptr;
+    lv_obj_t* name_dot_ = nullptr;
+    lv_obj_t* name_label_ = nullptr;
+    lv_obj_t* status_pill_ = nullptr;
+    lv_obj_t* bars_box_ = nullptr;
+    lv_obj_t* bars_[kBars] = {};
+    lv_obj_t* dots_box_ = nullptr;
+    lv_obj_t* dots_[kDots] = {};
+    lv_obj_t* stop_ = nullptr;
+    lv_obj_t* status_label_ = nullptr;
+    lv_timer_t* timer_ = nullptr;
+
+    // Everything below is touched only with the LVGL lock held (Tick runs in the LVGL task).
+    State state_ = kIdle;
+    int64_t state_since_ms_ = 0;
+    bool live_ = false;        // audio channel to the host is open
+    bool have_role_ = false;   // host has told us who we are
+    lv_color_t color_;
+    std::string role_;
+    int64_t last_ms_ = 0;
+    float think_opa_ = 0, status_opa_ = 0, ring_opa_ = 0, glow_opa_ = 0, gray_ = 0;
+    int ticks_ = 0;
+    int64_t ticks_since_ms_ = 0;
+    std::unique_ptr<LvglImage> img_base_;
+    std::unique_ptr<LvglImage> img_think_;
+
+    // Avatar download (own task; never under the LVGL lock while on the network).
+    SemaphoreHandle_t dl_mutex_ = nullptr;
+    std::string want_base_url_, want_think_url_;   // what the host asked for
+    std::string have_base_url_, have_think_url_;   // what is on screen
