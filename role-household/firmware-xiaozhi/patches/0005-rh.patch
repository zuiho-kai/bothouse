+// rh dial: see rh_dial_display.h. Look and timing follow ~/code/role-household rh/static/dial.html
+// (the hub's 466x466 web dial); pixel sizes there are scaled by width/466 here unless noted.
+#include "rh_dial_display.h"
+
+#if CONFIG_RH_DIAL
+
+#include "board.h"
+#include "device_state.h"
+#include "rh_level.h"
+
+#include <cJSON.h>
+#include <src/misc/cache/instance/lv_image_cache.h>  // lv_image_cache_drop (not exported by lvgl.h)
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <freertos/task.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#define TAG "RhDial"
+
+std::atomic<uint16_t> g_rh_out_level{0};
+std::atomic<int64_t> g_rh_out_level_us{0};
+
+namespace {
+
+// Colours from dial.html.
+constexpr uint32_t kScreenBg = 0x1b1d21;   // .screen background
+constexpr uint32_t kPillBg = 0x1c1e22;     // .pill rgba(28,30,34,.62)
+constexpr lv_opa_t kPillBgOpa = 158;       //   .62 * 255
+constexpr lv_opa_t kPillBorderOpa = 36;    // .pill border rgba(255,255,255,.14)
+constexpr uint32_t kDotIdle = 0x8a8f98;    // .pill.name .dot
+constexpr uint32_t kGreen = 0x3ecf8e;      // live dot, speaking bars
+constexpr uint32_t kRed = 0xf05454;        // interrupted ring, stop square
+constexpr uint32_t kUnknownRole = 0x9aa0a6;  // dial.html colour for a role it has no preset for
+
+// Timings from dial.html (ms).
+constexpr float kBreatheIdleMs = 4600;   // @keyframes breathe, idle
+constexpr float kBreatheThinkMs = 3200;  // breathe, thinking
+constexpr float kGlintMs = 9000;         // @keyframes glint
+constexpr float kSpinMs = 1600;          // thinking ring spin
+constexpr float kDotMs = 1100;           // thinking dots
+constexpr float kShakeMs = 400;          // interrupted shake
+constexpr float kFaceFadeMs = 600;       // .face transition opacity .6s
+constexpr float kPillFadeMs = 250;       // .pill.status transition .25s
+constexpr float kRingFadeMs = 300;       // .ring transition .3s
+constexpr float kFilterMs = 300;         // .face transition filter .3s
+// Real audio level counts as "current" this long after the last played chunk; after that the
+// synthetic wave of dial.html level() is used (between sentences, or before audio arrives).
+// Source: implementer's pick, a few 60 ms frames.
+constexpr int64_t kLevelFreshUs = 300 * 1000;
+
+// Pills: the board's smallest CJK font is 16 px (web 17 px), so pill contents keep the web's
+// px sizes (x16/17), not the width/466 scale -- at 240 px the web text would be 9 px.
+constexpr int kPillPadVer = 4, kPillPadHor = 12, kPillGap = 6;  // web 5/18/8, trimmed to fit the circle
+constexpr int kNameDot = 7;                                     // web 9
+constexpr int kBarW = 3, kBarH = 15, kBarGap = 3;               // web 3 / 16 / 3
+constexpr int kDotSize = 5, kDotGap = 4, kDotJump = 5;          // web 5 / 4 / 5
+constexpr int kStopSize = 9;                                    // web 10
+
+float Clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
+float Smooth(float u) { return u * u * (3 - 2 * u); }
+// 0 -> 1 -> 0 over one period, eased (CSS ease-in-out keyframes 0%,50%,100%).
+float Wave(float t, float period) { return (1 - cosf(2 * (float)M_PI * fmodf(t, period) / period)) / 2; }
+float Approach(float cur, float target, float dt, float dur) {
+    float step = dt / dur;
+    return cur < target ? std::min(target, cur + step) : std::max(target, cur - step);
+}
+lv_color_t Mix(lv_color_t a, lv_color_t b, float t) {  // t=0 -> a, t=1 -> b
+    return lv_color_mix(b, a, (lv_opa_t)(Clamp01(t) * 255));
+}
+
+// Set a local style property only when it changes: setting one always invalidates the object,
+// and the timer runs every frame.
+void Num(lv_obj_t* o, lv_style_prop_t p, int32_t v, lv_style_selector_t sel = 0) {
+    lv_style_value_t cur;
+    if (lv_obj_get_local_style_prop(o, p, &cur, sel) == LV_STYLE_RES_FOUND && cur.num == v) return;
+    lv_style_value_t nv;
+    nv.num = v;
+    lv_obj_set_local_style_prop(o, p, nv, sel);
+}
+void Col(lv_obj_t* o, lv_style_prop_t p, lv_color_t v, lv_style_selector_t sel = 0) {
+    lv_style_value_t cur;
+    if (lv_obj_get_local_style_prop(o, p, &cur, sel) == LV_STYLE_RES_FOUND && lv_color_eq(cur.color, v)) return;
+    lv_style_value_t nv;
+    nv.color = v;
+    lv_obj_set_local_style_prop(o, p, nv, sel);
+}
+
+void Plain(lv_obj_t* o) {
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+}
+
+lv_obj_t* Pill(lv_obj_t* parent) {
+    lv_obj_t* p = lv_obj_create(parent);
+    Plain(p);
+    lv_obj_set_size(p, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+    lv_obj_set_style_radius(p, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(p, lv_color_hex(kPillBg), 0);
+    lv_obj_set_style_bg_opa(p, kPillBgOpa, 0);
+    lv_obj_set_style_border_color(p, lv_color_white(), 0);
+    lv_obj_set_style_border_opa(p, kPillBorderOpa, 0);
+    lv_obj_set_style_border_width(p, 1, 0);
+    lv_obj_set_style_pad_ver(p, kPillPadVer, 0);
+    lv_obj_set_style_pad_hor(p, kPillPadHor, 0);
+    lv_obj_set_style_text_color(p, lv_color_white(), 0);
+    lv_obj_set_flex_flow(p, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(p, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_column(p, kPillGap, 0);
+    return p;
+}
+
+lv_obj_t* Box(lv_obj_t* parent, int w, int h, uint32_t color, int radius) {
+    lv_obj_t* o = lv_obj_create(parent);
+    Plain(o);
+    lv_obj_set_size(o, w, h);
+    lv_obj_set_style_radius(o, radius, 0);
+    lv_obj_set_style_bg_color(o, lv_color_hex(color), 0);
+    lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+    return o;
+}
+
+lv_obj_t* RingArc(lv_obj_t* parent, int size, int width) {
+    lv_obj_t* a = lv_arc_create(parent);
+    lv_obj_remove_style_all(a);
+    lv_obj_remove_flag(a, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(a, size, size);
+    lv_obj_center(a);
+    lv_arc_set_bg_angles(a, 0, 0);
+    lv_obj_set_style_arc_opa(a, LV_OPA_TRANSP, LV_PART_MAIN);
+    lv_obj_set_style_arc_width(a, width, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_rounded(a, false, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_opa(a, LV_OPA_COVER, LV_PART_INDICATOR);
+    lv_obj_add_flag(a, LV_OBJ_FLAG_HIDDEN);
+    return a;
+}
+
+const char* StateName(int s) {
+    static const char* names[] = {"idle", "thinking", "speaking", "interrupted"};
+    return s >= 0 && s < 4 ? names[s] : "?";
+}
+
+}  // namespace
+
+RhDialDisplay::RhDialDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel,
+                             int width, int height, int offset_x, int offset_y, bool mirror_x,
+                             bool mirror_y, bool swap_xy)
+    : SpiLcdDisplay(panel_io, panel, width, height, offset_x, offset_y, mirror_x, mirror_y, swap_xy) {
+    color_ = lv_color_hex(kUnknownRole);
+    dl_mutex_ = xSemaphoreCreateMutex();
+}
+
+RhDialDisplay::~RhDialDisplay() {
+    if (timer_) lv_timer_delete(timer_);
+}
+
+void RhDialDisplay::SetupUI() {
+    SpiLcdDisplay::SetupUI();  // default UI stays underneath (shown only in Wi-Fi config mode)
+    DisplayLockGuard lock(this);
+    const int W = width_, H = height_;
+    const float k = W / 466.0f;  // dial.html is 466 px
+
+    dial_ = lv_obj_create(lv_screen_active());
+    Plain(dial_);
+    lv_obj_set_size(dial_, W, H);
+    lv_obj_set_style_bg_color(dial_, lv_color_hex(kScreenBg), 0);
+    lv_obj_set_style_bg_opa(dial_, LV_OPA_COVER, 0);
+    lv_obj_set_style_text_color(dial_, lv_color_white(), 0);
+
+    // Faces: base + thinking picture, cross-faded. Edge vignette is baked in by the host.
+    for (lv_obj_t** f : {&face_base_, &face_think_}) {
+        *f = lv_image_create(dial_);
+        lv_obj_remove_flag(*f, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(*f, W, H);
+        lv_obj_center(*f);
+        lv_image_set_pivot(*f, W / 2, H * 6 / 10);  // .face transform-origin 50% 60%
+    }
+    lv_obj_set_style_image_opa(face_think_, LV_OPA_TRANSP, 0);
+
+    // Glint: a soft white band (transparent 38% / white .16 at 48% / transparent 58% of a 250%
+    // wide 115deg gradient = half the screen wide), tilted 25 deg, swept across now and then.
+    glint_ = lv_obj_create(dial_);
+    Plain(glint_);
+    lv_obj_set_size(glint_, W / 2, H * 16 / 10);
+    lv_obj_set_style_transform_pivot_x(glint_, W / 4, 0);
+    lv_obj_set_style_transform_pivot_y(glint_, H * 8 / 10, 0);
+    lv_obj_set_style_transform_rotation(glint_, 250, 0);
+    for (int i = 0; i < 2; i++) {  // LV_GRADIENT_MAX_STOPS is 2: two halves
+        lv_obj_t* h = lv_obj_create(glint_);
+        Plain(h);
+        lv_obj_set_size(h, W / 4, LV_PCT(100));
+        lv_obj_set_pos(h, i * W / 4, 0);
+        lv_obj_set_style_bg_opa(h, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(h, lv_color_white(), 0);
+        lv_obj_set_style_bg_grad_color(h, lv_color_white(), 0);
+        lv_obj_set_style_bg_grad_dir(h, LV_GRAD_DIR_HOR, 0);
+        lv_obj_set_style_bg_main_opa(h, i == 0 ? 0 : 41, 0);  // .16 * 255
+        lv_obj_set_style_bg_grad_opa(h, i == 0 ? 41 : 0, 0);
+    }
+    lv_obj_add_flag(glint_, LV_OBJ_FLAG_HIDDEN);
+
+    // Rings: 6 px web ring at the very edge.
+    const int ring_w = std::max(2, (int)lroundf(6 * k));
+    for (auto& seg : ring_) seg = RingArc(dial_, W, ring_w);
+    ring_full_ = RingArc(dial_, W, ring_w);
+    lv_arc_set_angles(ring_full_, 0, 360);
+    lv_obj_set_style_arc_color(ring_full_, lv_color_hex(kRed), LV_PART_INDICATOR);
+
+    // Speaking glow (web: glow around the bezel; here the screen edge is the bezel).
+    glow_ = lv_obj_create(dial_);
+    Plain(glow_);
+    lv_obj_set_size(glow_, W, H);
+    lv_obj_center(glow_);
+    lv_obj_set_style_radius(glow_, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_border_side(glow_, LV_BORDER_SIDE_FULL, 0);
+    lv_obj_add_flag(glow_, LV_OBJ_FLAG_HIDDEN);
+
+    // Name pill (top 7%).
+    name_pill_ = Pill(dial_);
+    lv_obj_align(name_pill_, LV_ALIGN_TOP_MID, 0, (int)lroundf(H * 0.07f));
+    name_dot_ = Box(name_pill_, kNameDot, kNameDot, kDotIdle, LV_RADIUS_CIRCLE);
+    lv_obj_set_style_shadow_color(name_dot_, lv_color_hex(kGreen), 0);
+    name_label_ = lv_label_create(name_pill_);
+    lv_label_set_text(name_label_, "等待主机");
+
+    // Status pill (bottom 13%): bars | dots | stop + text.
+    status_pill_ = Pill(dial_);
+    lv_obj_align(status_pill_, LV_ALIGN_BOTTOM_MID, 0, -(int)lroundf(H * 0.13f));
+    bars_box_ = lv_obj_create(status_pill_);
+    Plain(bars_box_);
+    lv_obj_set_size(bars_box_, LV_SIZE_CONTENT, kBarH);
+    lv_obj_set_flex_flow(bars_box_, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(bars_box_, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_column(bars_box_, kBarGap, 0);
+    for (auto& b : bars_) b = Box(bars_box_, kBarW, kBarH, kGreen, 2);
+    dots_box_ = lv_obj_create(status_pill_);
+    Plain(dots_box_);
+    lv_obj_set_size(dots_box_, LV_SIZE_CONTENT, kDotSize + kDotJump);
+    lv_obj_set_flex_flow(dots_box_, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(dots_box_, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_END, LV_FLEX_ALIGN_END);
+    lv_obj_set_style_pad_column(dots_box_, kDotGap, 0);
+    for (auto& d : dots_) d = Box(dots_box_, kDotSize, kDotSize, 0xffffff, LV_RADIUS_CIRCLE);
+    stop_ = Box(status_pill_, kStopSize, kStopSize, kRed, 2);
+    status_label_ = lv_label_create(status_pill_);
+    lv_label_set_text(status_label_, "");
+    lv_obj_set_style_opa(status_pill_, LV_OPA_TRANSP, 0);
+
+    SetState(kIdle);
+    lv_obj_move_foreground(dial_);
+    last_ms_ = ticks_since_ms_ = esp_timer_get_time() / 1000;
+    timer_ = lv_timer_create(TickCb, 33, this);  // CONFIG_LV_DEF_REFR_PERIOD
+    ESP_LOGI(TAG, "rh dial: ready (%dx%d), waiting for host", W, H);
+}
+
+void RhDialDisplay::TickCb(lv_timer_t* t) { static_cast<RhDialDisplay*>(lv_timer_get_user_data(t))->Tick(); }
+
+// Runs in the LVGL task (lock held).
+void RhDialDisplay::SetState(State s) {
+    state_ = s;
+    state_since_ms_ = esp_timer_get_time() / 1000;
+    static const char* text[] = {"", "思考中", "正在回答", "被打断"};  // dial.html STATUS_TEXT
+    lv_label_set_text(status_label_, text[s]);
+    auto show = [](lv_obj_t* o, bool on) {
+        if (on) lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+        else lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+    };
+    show(bars_box_, s == kSpeaking);
+    show(dots_box_, s == kThinking);
+    show(stop_, s == kInterrupted);
+    show(ring_full_, s == kInterrupted);
+    for (auto seg : ring_) show(seg, s == kThinking);
+    show(glow_, s == kSpeaking);
+    if (s != kIdle) lv_obj_add_flag(glint_, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_style_translate_x(face_base_, 0, 0);
+}
+
+void RhDialDisplay::Tick() {
+    const int W = width_, H = height_;
+    const float k = W / 466.0f;
+    int64_t now_us = esp_timer_get_time();
+    float t = (float)((now_us / 1000) % 3600000);  // ms, wrapped hourly to keep float precision
+    int64_t now_ms = now_us / 1000;
+    float dt = (float)std::min<int64_t>(200, now_ms - last_ms_);
+    last_ms_ = now_ms;
+    float since = (float)(now_ms - state_since_ms_);
+
+    // Opacity transitions.
+    think_opa_ = Approach(think_opa_, state_ == kThinking ? 1 : 0, dt, kFaceFadeMs);
+    status_opa_ = Approach(status_opa_, state_ == kIdle ? 0 : 1, dt, kPillFadeMs);
+    ring_opa_ = Approach(ring_opa_, (state_ == kThinking || state_ == kInterrupted) ? 1 : 0, dt, kRingFadeMs);
+    glow_opa_ = Approach(glow_opa_, state_ == kSpeaking ? 1 : 0, dt, kPillFadeMs);
+    gray_ = Approach(gray_, state_ == kInterrupted ? 1 : 0, dt, kFilterMs);
+    Num(face_think_, LV_STYLE_IMAGE_OPA, (lv_opa_t)(think_opa_ * 255));
+    Num(status_pill_, LV_STYLE_OPA, (lv_opa_t)(status_opa_ * 255));
+
+    // Speaking level: real playback loudness, else the synthetic wave of dial.html level().
+    float lvl = 0;
+    if (state_ == kSpeaking) {
+        if (now_us - g_rh_out_level_us.load() < kLevelFreshUs) {
+            lvl = g_rh_out_level.load() / 1000.0f;
+        } else {
+            float kk = role_.empty() ? 0 : (float)(unsigned char)role_[0];
+            lvl = .35f + .3f * fabsf(sinf(t / 110 + kk)) * (.6f + .4f * sinf(t / 370 + kk * 2));
+        }
+    }
+
+    // Face: idle breathe (base), thinking breathe (think face), speaking follows the level.
+    float scale = 1, ty = 0, tx = 0;
+    if (state_ == kIdle) {
+        float p = Wave(t, kBreatheIdleMs);
+        scale = 1 + .018f * p;
+        ty = -3 * k * p;
+    } else if (state_ == kThinking) {
+        float p = Wave(t, kBreatheThinkMs);
+        scale = 1 + .018f * p;
+        ty = -3 * k * p;
+    } else if (state_ == kSpeaking) {
+        scale = 1 + .02f * lvl;
+        ty = -3 * k * lvl;
+    } else if (state_ == kInterrupted && since < kShakeMs) {
+        // @keyframes shake: 20% -6, 40% 5, 60% -3, 80% 2 (px)
+        static const float keys[] = {0, -6, 5, -3, 2, 0};
+        float u = since / kShakeMs * 5;
+        int i = std::min(4, (int)u);
+        tx = (keys[i] + (keys[i + 1] - keys[i]) * (u - i)) * k;
+    }
+    lv_obj_t* moving = state_ == kThinking ? face_think_ : face_base_;
+    lv_obj_t* still = moving == face_base_ ? face_think_ : face_base_;
+    lv_image_set_scale(moving, (uint32_t)lroundf(256 * scale));
+    Num(moving, LV_STYLE_TRANSLATE_Y, (int32_t)lroundf(ty));
+    Num(moving, LV_STYLE_TRANSLATE_X, (int32_t)lroundf(tx));
+    lv_image_set_scale(still, 256);
+    Num(still, LV_STYLE_TRANSLATE_Y, 0);
+    Num(still, LV_STYLE_TRANSLATE_X, 0);
+    // Interrupted: grayscale(.6) brightness(.75) -> blend towards dark grey.
+    Col(face_base_, LV_STYLE_IMAGE_RECOLOR, lv_color_hex(0x3a3a3a));
+    Num(face_base_, LV_STYLE_IMAGE_RECOLOR_OPA, (lv_opa_t)(gray_ * 115));
+
+    // Glint: idle only, sweeps during 78%..92% of each 9 s cycle.
+    if (state_ == kIdle) {
+        float u = fmodf(t, kGlintMs) / kGlintMs;
+        if (u >= .78f && u <= .92f) {
+            float s = Smooth((u - .78f) / .14f);
+            float cx = (-0.6f + 2.25f * s) * W;  // band centre, left -> right
+            Num(glint_, LV_STYLE_X, (int32_t)(cx - W / 4));
+            Num(glint_, LV_STYLE_Y, -(H * 3 / 10));
+            lv_obj_remove_flag(glint_, LV_OBJ_FLAG_HIDDEN);
+        } else if (!lv_obj_has_flag(glint_, LV_OBJ_FLAG_HIDDEN)) {
+            lv_obj_add_flag(glint_, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    // Thinking ring: conic-gradient(transparent 0 62%, colour 92%, #fff 100%) spinning in 1.6 s.
+    if (state_ == kThinking) {
+        float rot = 360 * fmodf(t, kSpinMs) / kSpinMs;
+        const float a0 = 223.2f, a1 = 331.2f, a2 = 360;  // 62%, 92%, 100%
+        const int fade = kRingSegments - 3;              // segments fading in, then 3 to white
+        for (int i = 0; i < kRingSegments; i++) {
+            float s0, s1;
+            lv_color_t c;
+            lv_opa_t o;
+            if (i < fade) {
+                s0 = a0 + (a1 - a0) * i / fade;
+                s1 = a0 + (a1 - a0) * (i + 1) / fade;
+                c = color_;
+                o = (lv_opa_t)(255 * (i + 0.5f) / fade);
+            } else {
+                int j = i - fade;
+                s0 = a1 + (a2 - a1) * j / 3;
+                s1 = a1 + (a2 - a1) * (j + 1) / 3;
+                c = Mix(color_, lv_color_white(), (j + 0.5f) / 3);
+                o = 255;
+            }
+            // conic 0deg = 12 o'clock, LVGL arc 0 = 3 o'clock; both clockwise
+            lv_arc_set_angles(ring_[i], fmodf(s0 + rot + 270, 360), fmodf(s1 + rot + 270 + 0.6f, 360));
+            Col(ring_[i], LV_STYLE_ARC_COLOR, c, LV_PART_INDICATOR);
+            Num(ring_[i], LV_STYLE_ARC_OPA, (lv_opa_t)(o * ring_opa_), LV_PART_INDICATOR);
+        }
+    }
+    Num(ring_full_, LV_STYLE_ARC_OPA, (lv_opa_t)(255 * ring_opa_), LV_PART_INDICATOR);
+
+    // Speaking glow + bars.
+    if (state_ == kSpeaking) {
+        // web: box-shadow 0 0 (8+46*lvl)px (1+9*lvl)px outside the bezel; here an inner edge
+        // band in the role colour whose width and strength follow the level.
+        Col(glow_, LV_STYLE_BORDER_COLOR, color_);
+        Num(glow_, LV_STYLE_BORDER_WIDTH, (int32_t)lroundf((2 + 10 * lvl) * k * 2));
+        Num(glow_, LV_STYLE_BORDER_OPA, (lv_opa_t)(glow_opa_ * (90 + 165 * lvl)));
+        for (int i = 0; i < kBars; i++) {
+            float sy = std::max(.2f, std::min(1.0f, lvl * (.6f + .5f * fabsf(sinf(t / 90 + i * 1.7f)))));
+            Num(bars_[i], LV_STYLE_HEIGHT, std::max(2, (int)lroundf(kBarH * sy)));
+        }
+    }
+
+    // Thinking dots: 1.1 s bounce, .15 s apart (0,80,100%: y 0 opa .5; 40%: y -5 opa 1).
+    if (state_ == kThinking) {
+        for (int i = 0; i < kDots; i++) {
+            float u = fmodf(t - i * 150 + kDotMs * 10, kDotMs) / kDotMs;
+            float p = u < .4f ? u / .4f : (u < .8f ? (.8f - u) / .4f : 0);
+            Num(dots_[i], LV_STYLE_TRANSLATE_Y, (int32_t)lroundf(-kDotJump * p));
+            Num(dots_[i], LV_STYLE_BG_OPA, (lv_opa_t)(255 * (.5f + .5f * p)));
+        }
+    }
+
+    // Name dot: grey, green with glow when live; idle pulses with the breathe.
+    Col(name_dot_, LV_STYLE_BG_COLOR, lv_color_hex(live_ ? kGreen : kDotIdle));
+    Num(name_dot_, LV_STYLE_SHADOW_WIDTH, live_ ? 6 : 0);
+    float pulse = state_ == kIdle ? 1 - .55f * Wave(t, kBreatheIdleMs) : 1;
+    Num(name_dot_, LV_STYLE_BG_OPA, (lv_opa_t)(255 * pulse));
+
+    if (++ticks_ && now_ms - ticks_since_ms_ >= 10000) {
+        ESP_LOGI(TAG, "rh dial: role=%s state=%s live=%d frames/s=%.1f", role_.empty() ? "-" : role_.c_str(),
+                 StateName(state_), live_, ticks_ * 1000.0f / (now_ms - ticks_since_ms_));
+        ticks_ = 0;
+        ticks_since_ms_ = now_ms;
+    }
+}
+
+void RhDialDisplay::RhDial(const cJSON* msg) {
+    auto str = [msg](const char* key) -> const char* {
+        auto j = cJSON_GetObjectItem(msg, key);
+        return cJSON_IsString(j) ? j->valuestring : nullptr;
+    };
+    const char* role = str("role");
+    const char* name = str("name");
+    const char* color = str("color");
+    const char* state = str("state");
+    const char* avatar = str("avatar");
+    const char* avatar_think = str("avatar_think");
+    auto live = cJSON_GetObjectItem(msg, "live");
+    {
+        DisplayLockGuard lock(this);
+        if (dial_ == nullptr) return;
+        if (role) { role_ = role; have_role_ = true; }
+        if (name) lv_label_set_text(name_label_, name);
+        if (color && color[0] == '#' && strlen(color) == 7) color_ = lv_color_hex(strtoul(color + 1, nullptr, 16));
+        if (cJSON_IsBool(live)) live_ = cJSON_IsTrue(live);
+        if (state) {
+            State s = strcmp(state, "thinking") == 0      ? kThinking
+                      : strcmp(state, "speaking") == 0    ? kSpeaking
+                      : strcmp(state, "interrupted") == 0 ? kInterrupted
+                                                          : kIdle;
+            if (s != state_) SetState(s);
+        }
+    }
+    ESP_LOGI(TAG, "rh dial: host says role=%s name=%s state=%s", role ? role : "-", name ? name : "-",
+             state ? state : "-");
+    if (avatar) RequestAvatars(avatar, avatar_think ? avatar_think : avatar);
+}
+
+void RhDialDisplay::RhDeviceState(int state) {
+    DisplayLockGuard lock(this);
+    if (dial_ == nullptr) return;
+    // Wi-Fi config mode needs the default screen (hotspot name / address instructions).
+    if (state == kDeviceStateWifiConfiguring) lv_obj_add_flag(dial_, LV_OBJ_FLAG_HIDDEN);
+    else lv_obj_remove_flag(dial_, LV_OBJ_FLAG_HIDDEN);
+}
+
+void RhDialDisplay::RhDialLink(bool connected) {
+    {
+        DisplayLockGuard lock(this);
+        if (dial_ == nullptr) return;
+        live_ = connected;
+        if (!connected && state_ != kIdle) SetState(kIdle);
+    }
+    if (!connected) {  // fetch the pictures again after reconnecting (the host may have new ones)
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        have_base_url_.clear();
+        have_think_url_.clear();
+        xSemaphoreGive(dl_mutex_);
+    }
+}
+
+void RhDialDisplay::RequestAvatars(const std::string& base, const std::string& think) {
+    xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+    want_base_url_ = base;
+    want_think_url_ = think;
+    bool start = !dl_running_ && (want_base_url_ != have_base_url_ || want_think_url_ != have_think_url_);
+    if (start) dl_running_ = true;
+    xSemaphoreGive(dl_mutex_);
+    if (start && xTaskCreate(DownloadTask, "rh_dial_dl", 8192, this, 2, nullptr) != pdPASS) {
+        ESP_LOGE(TAG, "rh dial: cannot start download task");
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        dl_running_ = false;
+        xSemaphoreGive(dl_mutex_);
+    }
+}
+
+void RhDialDisplay::DownloadTask(void* arg) {
+    auto self = static_cast<RhDialDisplay*>(arg);
+    while (true) {
+        xSemaphoreTake(self->dl_mutex_, portMAX_DELAY);
+        bool think = false;
+        std::string url;
+        if (self->want_base_url_ != self->have_base_url_) {
+            url = self->have_base_url_ = self->want_base_url_;
+        } else if (self->want_think_url_ != self->have_think_url_) {
+            url = self->have_think_url_ = self->want_think_url_;
+            think = true;
+        } else {
+            self->dl_running_ = false;
+            xSemaphoreGive(self->dl_mutex_);
+            break;
+        }
+        xSemaphoreGive(self->dl_mutex_);
+        auto image = self->Download(url);
+        if (image) {
+            DisplayLockGuard lock(self);
+            if (think) self->SetFace(self->face_think_, self->img_think_, std::move(image));
+            else self->SetFace(self->face_base_, self->img_base_, std::move(image));
+        }
+    }
+    vTaskDelete(nullptr);
+}
+
+void RhDialDisplay::SetFace(lv_obj_t* img, std::unique_ptr<LvglImage>& slot, std::unique_ptr<LvglImage> image) {
+    lv_image_set_src(img, image->image_dsc());
+    if (slot) lv_image_cache_drop(slot->image_dsc());
+    slot = std::move(image);
+}
+
+// Host serves the picture already sized for this screen as raw little-endian RGB565
+// (rh/dial.py): no decoder needed on the board.
+std::unique_ptr<LvglImage> RhDialDisplay::Download(const std::string& base_url) {
+    const int W = width_, H = height_;
+    const size_t want = (size_t)W * H * 2;
+    std::string url = base_url + (base_url.find('?') == std::string::npos ? "?" : "&") + "size=" + std::to_string(W);
+    auto http = Board::GetInstance().GetNetwork()->CreateHttp(3);
+    if (auto opened = http->Open("GET", url); !opened) {
+        ESP_LOGE(TAG, "rh dial: cannot open %s", url.c_str());
+        return nullptr;
+    }
+    auto status = http->GetStatusCode();
+    if (!status || *status != 200 || http->GetBodyLength() != want) {
+        ESP_LOGE(TAG, "rh dial: %s -> status %d, %u bytes (want %u)", url.c_str(), status ? *status : -1,
+                 (unsigned)http->GetBodyLength(), (unsigned)want);
+        http->Close();
+        return nullptr;
+    }
+    auto data = static_cast<uint8_t*>(heap_caps_malloc(want, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (data == nullptr) {
+        ESP_LOGE(TAG, "rh dial: no memory for %u bytes", (unsigned)want);
+        http->Close();
+        return nullptr;
+    }
+    size_t got = 0;
+    while (got < want) {
+        auto n = http->Read(reinterpret_cast<char*>(data) + got, want - got);
+        if (!n || *n <= 0) break;
+        got += *n;
+    }
+    http->Close();
+    if (got != want) {
+        ESP_LOGE(TAG, "rh dial: %s short read %u/%u", url.c_str(), (unsigned)got, (unsigned)want);
+        heap_caps_free(data);
+        return nullptr;
+    }
+    ESP_LOGI(TAG, "rh dial: avatar %s (%u bytes)", url.c_str(), (unsigned)got);
+    return std::make_unique<LvglAllocatedImage>(data, want, W, H, W * 2, LV_COLOR_FORMAT_RGB565);
+}
