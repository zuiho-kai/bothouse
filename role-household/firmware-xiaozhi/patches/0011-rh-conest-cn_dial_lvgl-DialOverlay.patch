+// conest patch 0011 SetPowerSaveMode: pause the animation (the CNAS player there, the dial timer
+// here) and switch the panel off; on wake resume and redraw everything once.
+void RhDialDisplay::SetPowerSaveMode(bool on) {
+    DisplayLockGuard lock(this);
+    if (timer_) {
+        if (on) {
+            lv_timer_pause(timer_);
+        } else {
+            last_ms_ = esp_timer_get_time() / 1000;  // no jump in the smoothing after the pause
+            lv_timer_resume(timer_);
+        }
+    }
+    if (panel_) esp_lcd_panel_disp_on_off(panel_, !on);
+    if (!on) lv_obj_invalidate(lv_screen_active());
+}
