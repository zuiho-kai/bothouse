+    if (!cn_dial::Supported(metrics_, font)) {
+        ESP_LOGE(TAG, "rh dial: %dx%d with a %d px glyph / %d px line font does not fit (min short side %d), no dial",
+                 width_, height_, font.glyph_w, font.line_h, cn_dial::layout::kMinShortSide);
+        return;
+    }
     const int W = width_, H = height_;
     const int C = metrics_.canvas();
 
@@ -546,13 +553,24 @@ void RhDialDisplay::RhDial(const cJSON* msg) {
     auto status = cJSON_GetObjectItem(msg, "conest_status");
     auto busy = cJSON_IsObject(status) ? cJSON_GetObjectItem(status, "busy") : nullptr;
     // conest patch 0011: anything the role does (thinking, speaking, interrupted) lights the screen.
+    // rh: so does a new name or a new picture (rare, someone changed the role). The work status does
+    // not: it flips with every Discord turn of the role's agent, which would keep the screen on most
+    // of the time (0011 lights it only for what the role does on the board); it is shown when the
+    // screen next lights.
     if (state && strcmp(state, "idle") != 0) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    bool wake = false;
     {
         DisplayLockGuard lock(this);
         if (dial_ == nullptr) return;
         if (role) role_ = role;
-        if (name) overlay_.SetName(name);
+        if (name && name_ != name) {
+            wake |= !name_.empty();   // the first name after boot is not a change
+            name_ = name;
+            overlay_.SetName(name);
+        }
+        // DECOR.md 3 / rh/dial.py: busy true/false shows the status; null = unknown (stale), hide it.
         if (cJSON_IsBool(busy)) overlay_.SetBusy(cJSON_IsTrue(busy));
+        else if (cJSON_IsNull(busy)) overlay_.ClearBusy();
         if (color && color[0] == '#' && strlen(color) == 7) color_ = lv_color_hex(strtoul(color + 1, nullptr, 16));
         if (cJSON_IsBool(live)) {
             live_ = cJSON_IsTrue(live);
@@ -568,6 +586,14 @@ void RhDialDisplay::RhDial(const cJSON* msg) {
     }
     ESP_LOGI(TAG, "rh dial: host says role=%s name=%s state=%s", role ? role : "-", name ? name : "-",
              state ? state : "-");
+    if (avatar) {
+        // A different picture URL than last asked for (not cleared on disconnect, so a reconnect
+        // that re-sends the same one does not count; the first one after boot does not either).
+        xSemaphoreTake(dl_mutex_, portMAX_DELAY);
+        wake |= !want_base_url_.empty() && want_base_url_ != avatar;
+        xSemaphoreGive(dl_mutex_);
+    }
+    if (wake) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
     if (avatar) {
         std::string think = avatar_think ? avatar_think : avatar;
         if (think == avatar) {  // no separate thinking picture: no cross-fade (saves full repaints)
@@ -602,6 +628,7 @@ void RhDialDisplay::RhDialLink(bool connected) {
         overlay_.SetLink(connected);
         if (!connected && state_ != kIdle) SetState(kIdle);
         if (!connected) overlay_.SetSpeech(nullptr);
+        if (!connected) overlay_.ClearBusy();   // no host, no work status: hidden until it says again
     }
     if (!connected) {  // fetch the pictures again after reconnecting (the host may have new ones)
         xSemaphoreTake(dl_mutex_, portMAX_DELAY);
@@ -617,8 +644,14 @@ bool RhDialDisplay::RhDialIdle() { return dial_idle_.load(); }
 // Keep the base (hidden) subtitle in sync and mirror the sentence into the bubble (conest 0010).
 void RhDialDisplay::SetChatMessage(const char* role, const char* content) {
     SpiLcdDisplay::SetChatMessage(role, content);
-    if (role == nullptr || strcmp(role, "assistant") != 0) return;
     const bool text = content != nullptr && content[0] != '\0';
+    // rh: the host heard the user (stt text): light the screen, like the board's own VAD does
+    // (application.cc MAIN_EVENT_VAD_CHANGE).
+    if (role != nullptr && strcmp(role, "user") == 0 && text) {
+        Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+        return;
+    }
+    if (role == nullptr || strcmp(role, "assistant") != 0) return;
     if (text) Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);  // conest 0011
     DisplayLockGuard lock(this);
     if (dial_ == nullptr) return;
