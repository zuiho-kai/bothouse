     esp_timer_handle_t sleep_fade_timer_ = nullptr;
     std::atomic<bool> is_sleeping_{false};
     // rh: a touch / BOOT press that only lit the dark screen does not also toggle the chat.
-    bool boot_wake_only_ = false;
+    std::atomic<bool> boot_wake_only_{false};
 
     // conest patch 0011 OnUserActivity(): touch or BOOT lights the screen within a second.
     void OnUserActivity() {
@@ -434,10 +434,14 @@ private:
     }
 
     void InitializeButtons() {
+        // The wake-only mark belongs to one press: set on press-down, used up by that press's click.
+        // A long press has no click (iot_button: LONG_PRESS_START, then PRESS_UP / PRESS_END, no
+        // SINGLE_CLICK), so it clears the mark itself instead of leaving it for the next press.
         boot_button_.OnPressDown([this]() {
             boot_wake_only_ = is_sleeping_;
             OnUserActivity();
         });
+        boot_button_.OnLongPress([this]() { boot_wake_only_ = false; });
         boot_button_.OnClick([this]() {
             if (boot_wake_only_) {  // this press only lit the screen
                 boot_wake_only_ = false;
diff --git a/main/display/rh_dial_display.cc b/main/display/rh_dial_display.cc
