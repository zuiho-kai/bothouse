diff --git a/main/application.cc b/main/application.cc
index db07a85..031324b 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -267,6 +267,13 @@ void Application::Run() {
         }
 
         if (bits & MAIN_EVENT_VAD_CHANGE) {
+#if CONFIG_RH_DIAL
+            // rh: the user starts talking (the board hears a voice): light the screen. With
+            // RH_ALWAYS_LISTEN the board rests in Listening, so the state change alone says nothing.
+            if (audio_service_.IsVoiceDetected()) {
+                Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+            }
+#endif
             if (GetDeviceState() == kDeviceStateListening) {
                 auto led = Board::GetInstance().GetLed();
                 led->OnStateChanged();
@@ -1397,7 +1404,12 @@ void Application::WakeWordInvoke(const std::string& wake_word) {
 }
 
 bool Application::CanEnterSleepMode() {
-#if CONFIG_RH_ALWAYS_LISTEN
+    // rh: the relaxations below only hold with the role dial (CONFIG_RH_DIAL), whose screen-off
+    // sleep keeps the mic and the audio channel running (spotpear 1.28 PowerSaveTimer(-1, ...): no
+    // CPU down-clocking, no mic off, no shutdown) and whose dial state says whether the role is busy.
+    // Other boards' PowerSaveTimer turns the mic off / down-clocks / powers off on sleep (e.g.
+    // genjutech-s3-1.54tft, magiclick), so for them the stock checks stay.
+#if CONFIG_RH_ALWAYS_LISTEN && CONFIG_RH_DIAL
     // rh: the board rests in Listening (it streams the mic to the host whenever idle), so resting
     // Listening counts as idle here; the dial below says whether the role is doing anything.
     if (GetDeviceState() != kDeviceStateIdle && GetDeviceState() != kDeviceStateListening) {
@@ -1409,14 +1421,14 @@ bool Application::CanEnterSleepMode() {
     }
 #endif
 
-#if !CONFIG_RH_HOST_PUSH
+#if !(CONFIG_RH_HOST_PUSH && CONFIG_RH_DIAL)
     // conest patch 0011: with host push the audio channel stays open all the time.
     if (protocol_ && protocol_->IsAudioChannelOpened()) {
         return false;
     }
 #endif
 
-#if CONFIG_RH_ALWAYS_LISTEN
+#if CONFIG_RH_ALWAYS_LISTEN && CONFIG_RH_DIAL
     // Streaming mic packets pass through the encode queue all the time; only playback matters.
     if (!audio_service_.IsPlaybackIdle()) {
         return false;
