@@ -194,6 +191,16 @@ void RhDialDisplay::SetupUI() {
     SpiLcdDisplay::SetupUI();  // default UI stays underneath (shown only in Wi-Fi config mode)
     if (!usable_) return;      // logged in the constructor; dial_ stays nullptr, every entry point checks it
     DisplayLockGuard lock(this);
+    // Does the overlay fit this screen with the font it is drawn in (the theme font the dial
+    // inherits from the screen)? cn_dial::Supported: short side >= min_short_side and the name tag,
+    // status chip and bubble fit with this font's glyph width and line height.
+    const cn_dial::PillFont font =
