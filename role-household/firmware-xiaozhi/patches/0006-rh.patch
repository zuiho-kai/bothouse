+void RhDialDisplay::EdgeDrawCb(lv_event_t* e) {
+    auto self = static_cast<RhDialDisplay*>(lv_event_get_user_data(e));
+    lv_layer_t* layer = lv_event_get_layer(e);
+    lv_area_t c;
+    lv_obj_get_coords(self->edge_, &c);
+    const lv_color_t colors[3] = {self->color_, lv_color_white(), lv_color_hex(kRed)};
+    for (int l = 0; l < 3; l++) {
+        if (!self->layer_on_[l] || !self->layer_px_[l]) continue;
+        lv_draw_image_dsc_t d;
+        lv_draw_image_dsc_init(&d);
+        d.src = &self->layer_dsc_[l];
+        d.recolor = colors[l];
+        d.recolor_opa = LV_OPA_COVER;
+        lv_draw_image(layer, &d, &c);
+    }
+}
+
+void RhDialDisplay::BarsDrawCb(lv_event_t* e) {
+    auto self = static_cast<RhDialDisplay*>(lv_event_get_user_data(e));
+    lv_layer_t* layer = lv_event_get_layer(e);
+    lv_area_t c;
+    lv_obj_get_coords(self->bars_, &c);
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_hex(kGreen);
+    d.radius = 2;
+    for (int i = 0; i < kBars; i++) {
+        int h = std::max(2, (int)lroundf(kBarH * self->bar_h_[i]));
+        lv_area_t a;
+        a.x1 = c.x1 + i * (kBarW + kBarGap);
+        a.x2 = a.x1 + kBarW - 1;
+        a.y1 = c.y1 + (kBarH - h) / 2;
+        a.y2 = a.y1 + h - 1;
+        lv_draw_rect(layer, &d, &a);
+    }
+}
+
+void RhDialDisplay::DotsDrawCb(lv_event_t* e) {
+    auto self = static_cast<RhDialDisplay*>(lv_event_get_user_data(e));
+    lv_layer_t* layer = lv_event_get_layer(e);
+    lv_area_t c;
+    lv_obj_get_coords(self->dots_, &c);
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_white();
+    d.radius = LV_RADIUS_CIRCLE;
+    for (int i = 0; i < kDots; i++) {
+        float p = self->dot_p_[i];
+        d.bg_opa = (lv_opa_t)(255 * (.5f + .5f * p));
+        lv_area_t a;
+        a.x1 = c.x1 + i * (kDotSize + kDotGap);
+        a.x2 = a.x1 + kDotSize - 1;
+        a.y1 = c.y1 + kDotJump - (int)lroundf(kDotJump * p);
+        a.y2 = a.y1 + kDotSize - 1;
+        lv_draw_rect(layer, &d, &a);
+    }
