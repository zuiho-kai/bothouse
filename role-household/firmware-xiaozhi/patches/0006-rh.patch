+// LVGL task, lock held. Sends {"method":"notifications/rh_dial_stats"} for the time since the last
+// report (one state segment or 30 s), then resets the counters.
+void RhDialDisplay::ReportStats(int64_t now_ms, const char* why) {
+    int64_t span = now_ms - stat_since_ms_;
+    if (span >= 2000 && live_) {
+        char buf[256];
+        snprintf(buf, sizeof(buf),
+                 "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/rh_dial_stats\",\"params\":{\"state\":\"%s\","
+                 "\"why\":\"%s\",\"secs\":%.1f,\"fps\":%.1f,\"timer_hz\":%.1f,\"render_ms\":%.1f,\"heap_internal\":%u}}",
+                 StateName(state_), why, span / 1000.0f, stat_renders_ * 1000.0f / span, stat_ticks_ * 1000.0f / span,
+                 stat_renders_ ? stat_render_us_ / 1000.0f / stat_renders_ : 0.0f,
+                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+        ESP_LOGI(TAG, "%s", buf);
+        Application::GetInstance().SendMcpMessage(buf);
+    }
+    stat_renders_ = stat_ticks_ = 0;
+    stat_render_us_ = 0;
+    stat_since_ms_ = now_ms;
+}
