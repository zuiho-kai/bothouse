+// The edge ring area as kTiles small rectangles hugging the circle, `width` px thick.
+// lo..hi: only tiles overlapping this angle range (degrees, 0 = 3 o'clock, clockwise; may wrap).
+void RhDialDisplay::InvalidateEdge(int width, float lo, float hi) {
+    const int W = width_, H = height_;
+    if (width != tiles_w_) {
+        tiles_w_ = width;
+        const float R = W / 2.0f, cx = W / 2.0f, cy = H / 2.0f;
+        for (int i = 0; i < kTiles; i++) {
+            float x1 = 1e9f, y1 = 1e9f, x2 = -1e9f, y2 = -1e9f;
+            for (int s = 0; s <= 4; s++) {
+                float a = (i + s / 4.0f) * 2 * (float)M_PI / kTiles;
+                for (float r : {R, R - width}) {
+                    float x = cx + r * cosf(a), y = cy + r * sinf(a);
+                    x1 = std::min(x1, x); y1 = std::min(y1, y); x2 = std::max(x2, x); y2 = std::max(y2, y);
+                }
+            }
+            tiles_[i] = {std::max(0, (int)floorf(x1) - 2), std::max(0, (int)floorf(y1) - 2),
+                         std::min(W - 1, (int)ceilf(x2) + 2), std::min(H - 1, (int)ceilf(y2) + 2)};
+        }
+    }
+    const float step = 360.0f / kTiles;
+    for (int i = 0; i < kTiles; i++) {
+        if (hi - lo < 360) {
+            // tile i spans [i*step, (i+1)*step]; test overlap with [lo, hi] modulo 360
+            float a0 = fmodf(i * step - lo + 720, 360);
+            float a1 = a0 + step;
+            if (!(a0 <= hi - lo || a1 >= 360)) continue;
+        }
+        lv_obj_invalidate_area(edge_, &tiles_[i]);
+    }
+}
+
+// Precompute the pixels near the rim (distance < kRingMax px) with their angle and distance, and
+// three A8 (alpha-only) full-screen layers: role colour, white, red. Each frame only those ring
+// pixels are rewritten, and the layers are blended with LVGL's A8 fast path (colour + mask),
+// clipped to the edge tiles -- no arc / circle masks are computed while drawing.
+void RhDialDisplay::BuildRing() {
+    const int W = width_, H = height_;
+    const float R = W / 2.0f, cx = W / 2.0f, cy = H / 2.0f;
+    std::vector<RingPx> px;
+    for (int y = 0; y < H; y++) {
+        for (int x = 0; x < W; x++) {
+            float dx = x + .5f - cx, dy = y + .5f - cy;
+            float d = R - sqrtf(dx * dx + dy * dy);
+            if (d < 0 || d >= kRingMax) continue;
+            // clockwise from 12 o'clock, 0.1 deg
+            float a = atan2f(dx, -dy) * 180 / (float)M_PI;
+            if (a < 0) a += 360;
+            px.push_back({(uint32_t)(y * W + x), (uint16_t)(a * 10), (uint8_t)(d * 16)});
+        }
+    }
+    std::sort(px.begin(), px.end(), [](const RingPx& a, const RingPx& b) { return a.d16 < b.d16; });
+    ring_n_ = px.size();
+    for (int w = 0; w <= kRingMax; w++) {  // ring_upto_[w] = number of pixels closer than w px to the rim
+        ring_upto_[w] = std::lower_bound(px.begin(), px.end(), w * 16,
+                                         [](const RingPx& a, int v) { return a.d16 < v; }) - px.begin();
+    }
+    ring_px_ = static_cast<RingPx*>(heap_caps_malloc(ring_n_ * sizeof(RingPx), MALLOC_CAP_SPIRAM));
+    if (ring_px_) memcpy(ring_px_, px.data(), ring_n_ * sizeof(RingPx));
+    for (int l = 0; l < 3; l++) {
+        layer_px_[l] = static_cast<uint8_t*>(heap_caps_calloc(W * H, 1, MALLOC_CAP_SPIRAM));
+        auto& d = layer_dsc_[l];
+        d.header.magic = LV_IMAGE_HEADER_MAGIC;
+        d.header.cf = LV_COLOR_FORMAT_A8;
+        d.header.w = W;
+        d.header.h = H;
+        d.header.stride = W;
+        d.data_size = W * H;
+        d.data = layer_px_[l];
+    }
+}
+
+// Rewrite the ring pixels of the three layers from the current animation values.
+void RhDialDisplay::PaintRing(float halo_opa, float halo_w, float glow_opa, float glow_w, int upto) {
+    if (ring_px_ == nullptr || !layer_px_[0] || !layer_px_[1] || !layer_px_[2]) return;
+    const float k = width_ / 466.0f;
+    const float ring_w = std::max(2.0f, roundf(6 * k));  // web .ring: 6 px of 466
+    float band_o = std::max(halo_opa, glow_opa);
+    float band_w = glow_opa >= halo_opa ? glow_w : halo_w;
+    float rot10 = rot_ * 10;
+    const int n = ring_upto_[std::min(upto, (int)kRingMax)];
+    for (int i = 0; i < n; i++) {
+        const RingPx& p = ring_px_[i];
+        float d = p.d16 / 16.0f;
+        float col = 0, white = 0, red = 0;
+        // Glow band: strongest at the rim, fading inwards (smooth falloff), soft inner edge.
+        if (band_o > .004f && d < band_w) {
+            float u = 1 - d / band_w;
+            col = band_o * (.25f + .65f * u * u);
+        }
+        // Ring edge anti-aliasing for the 3 px rings.
+        float ring_a = Clamp01(ring_w - d);
+        if (spin_ > .004f && ring_a > 0) {
+            // conic-gradient(transparent 0 62%, colour 92%, #fff 100%), rotated by rot_
+            float th = fmodf(p.ang10 - rot10 + 7200, 3600) / 10;
+            if (th >= 223.2f) {
+                if (th < 331.2f) {
+                    col = std::max(col, spin_ * ring_a * (th - 223.2f) / 108);
+                } else {
+                    float m = (th - 331.2f) / 28.8f;
+                    col = std::max(col, spin_ * ring_a * (1 - m));
+                    white = spin_ * ring_a * m;
+                }
+            }
+        }
+        if (red_ > .004f) red = red_ * ring_a;
+        layer_px_[0][p.idx] = (uint8_t)(Clamp01(col) * 255);
+        layer_px_[1][p.idx] = (uint8_t)(Clamp01(white) * 255);
+        layer_px_[2][p.idx] = (uint8_t)(Clamp01(red) * 255);
+    }
+}
