+void RhDialDisplay::RenderEventCb(lv_event_t* e) {
+    auto self = static_cast<RhDialDisplay*>(lv_event_get_user_data(e));
+    if (lv_event_get_code(e) == LV_EVENT_RENDER_START) {
+        self->stat_render_start_us_ = esp_timer_get_time();
+    } else if (self->stat_render_start_us_) {
+        self->stat_renders_++;
+        self->stat_render_us_ += esp_timer_get_time() - self->stat_render_start_us_;
+        self->stat_render_start_us_ = 0;
+    }
+}
