From 8e68c7a479578988ae3d855abe6bdabb6fb9fefb Mon Sep 17 00:00:00 2001
From: zuiho <qq2324465096@gmail.com>
Date: Mon, 19 Oct 2026 15:20:17 +0900
Subject: [PATCH 01/14] rh: default OTA to Mac host, silence local sounds,
 disable mic uplink and wake word

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 README.md                   | 10 ++++++++++
 main/Kconfig.projbuild      | 34 ++++++++++++++++++++++++++++++++--
 main/application.cc         | 13 ++++++++++++-
 main/audio/audio_service.cc |  8 ++++++++
 4 files changed, 62 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index 255e4d6..425aa27 100644
--- a/README.md
+++ b/README.md
@@ -1,3 +1,13 @@
+> **Role Household fork (branch `rh`, based on v2.5.2)**
+>
+> - Default OTA URL: `http://zuihomac-studio.local:8791/xiaozhi/ota/` (Kconfig `CONFIG_OTA_URL`, menu "Xiaozhi Assistant").
+>   Port 8791 is shared with the host-side service in `~/code/role-household`. The device gets the websocket/mqtt address from that OTA JSON.
+>   A runtime override still works: NVS key `ota_url` (Wi-Fi config page at http://192.168.4.1, "advanced").
+> - `CONFIG_RH_SILENT_LOCAL_SOUNDS=y` (default): no built-in boot / Wi-Fi config / activation / alert sounds. Only host-pushed audio plays.
+> - `CONFIG_RH_DISABLE_MIC_UPLINK=y` (default): the board never enters Listening, never uploads microphone audio. Output only (speech + expression).
+> - Wake word defaults to disabled. Role binding (which character a board is) lives in the host config, not in this firmware.
+> - Build: `python scripts/build.py sp-esp32-s3-1.28-box --wake-word disabled` (ESP-IDF v6.1). Flashing: see `../FLASH.md`.
+
 # An MCP-based Chatbot
 
 (English | [中文](README_zh.md) | [日本語](README_ja.md))
diff --git a/main/Kconfig.projbuild b/main/Kconfig.projbuild
index 6a7c0fb..c0ffe72 100644
--- a/main/Kconfig.projbuild
+++ b/main/Kconfig.projbuild
@@ -2,10 +2,38 @@ menu "Xiaozhi Assistant"
 
 config OTA_URL
     string "Default OTA URL"
-    default "https://api.tenclass.net/xiaozhi/ota/"
+    # rh: point to the role-household host on the Mac instead of xiaozhi.me cloud.
+    # Source: user 2026-10-19 "三个硬件都有了，我预计你可以重新写入，不关注原来的"; port 8791 is the
+    # placeholder chosen by the orchestrator, the host-side service uses the same port.
+    # Upstream default was https://api.tenclass.net/xiaozhi/ota/ . NVS key "ota_url" still overrides at runtime.
+    default "http://zuihomac-studio.local:8791/xiaozhi/ota/"
     help
         The application will access this URL to check for new firmwares and server address.
 
+menu "Role Household (rh)"
+
+config RH_SILENT_LOCAL_SOUNDS
+    bool "Never play built-in local sounds (boot/wifi-config/activation/alerts)"
+    default y
+    help
+        rh: the board must not speak on its own. All built-in OGG prompts
+        (success, wifi config, activation code digits, popup, alerts, low battery)
+        are dropped in AudioService::PlaySound. Audio pushed by the host (TTS
+        Opus stream, notify audio_url) is not affected.
+        Source: review ~/.claude/reviews/rh-fw-xiaozhi.md item 4; user: no sound while asleep/away.
+
+config RH_DISABLE_MIC_UPLINK
+    bool "Disable on-board listening (no microphone upload)"
+    default y
+    help
+        rh: step one is output-only (speak + facial expression). Any transition
+        to the Listening state is redirected to Idle, so the device never sends
+        listen/start or microphone audio. The audio channel itself may stay open
+        so the host can push tts/llm-emotion.
+        Source: review ~/.claude/reviews/rh-fw-xiaozhi.md item 1.
+
+endmenu
+
 choice
     prompt "Flash Assets"
     default FLASH_DEFAULT_ASSETS if !USE_EMOTE_MESSAGE_STYLE
@@ -915,7 +943,9 @@ config USE_MULTILINE_CHAT_MESSAGE
 
 choice WAKE_WORD_TYPE
     prompt "Wake Word Implementation Type"
-    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
+    # rh: no on-board wake word by default (review ~/.claude/reviews/rh-fw-xiaozhi.md item 1:
+    # board does not listen in step one; wake words must stay user-customizable, not baked in).
+    # Upstream default was USE_AFE_WAKE_WORD on S3/P4/S31 with PSRAM.
     default WAKE_WORD_DISABLED
     help
         Choose the type of wake word implementation to use
diff --git a/main/application.cc b/main/application.cc
index 31de205..1207744 100644
--- a/main/application.cc
+++ b/main/application.cc
@@ -56,7 +56,18 @@ Application::~Application() {
     vEventGroupDelete(event_group_);
 }
 
-bool Application::SetDeviceState(DeviceState state) { return state_machine_.TransitionTo(state); }
+bool Application::SetDeviceState(DeviceState state) {
+#if CONFIG_RH_DISABLE_MIC_UPLINK
+    // rh: output-only board. Every path into Listening (button toggle, auto-listen after
+    // tts stop, wake word) passes here; redirect to Idle so no listen/start or mic audio
+    // is ever sent. Source: review ~/.claude/reviews/rh-fw-xiaozhi.md item 1.
+    if (state == kDeviceStateListening) {
+        ESP_LOGI(TAG, "rh: listening disabled, staying idle");
+        state = kDeviceStateIdle;
+    }
+#endif
+    return state_machine_.TransitionTo(state);
+}
 
 void Application::Initialize() {
     auto& board = Board::GetInstance();
diff --git a/main/audio/audio_service.cc b/main/audio/audio_service.cc
index 7f7582b..4450c2f 100644
--- a/main/audio/audio_service.cc
+++ b/main/audio/audio_service.cc
@@ -762,6 +762,14 @@ void AudioService::EnableDeviceAec(bool enable) {
 void AudioService::SetCallbacks(AudioServiceCallbacks& callbacks) { callbacks_ = callbacks; }
 
 void AudioService::PlaySound(const std::string_view& ogg) {
+#if CONFIG_RH_SILENT_LOCAL_SOUNDS
+    // rh: the board never speaks on its own; every built-in OGG prompt goes through
+    // here, so drop them all. Host-pushed audio uses PushPacketToDecodeQueue directly.
+    // Source: review ~/.claude/reviews/rh-fw-xiaozhi.md item 4.
+    (void)ogg;
+    ESP_LOGI(TAG, "rh: local sound suppressed (%u bytes)", (unsigned)ogg.size());
+    return;
+#endif
     if (!codec_->output_enabled()) {
         esp_timer_stop(audio_power_timer_);
         esp_timer_start_periodic(audio_power_timer_, AUDIO_POWER_CHECK_INTERVAL_MS * 1000);
-- 
