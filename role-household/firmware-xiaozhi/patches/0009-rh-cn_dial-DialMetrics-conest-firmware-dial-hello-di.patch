+void Protocol::AddDisplayProfile(cJSON* root) {
+    auto display = Board::GetInstance().GetDisplay();
+    const cn_dial::ScreenProfile* screen = display ? display->GetScreenProfile() : nullptr;
+    if (screen == nullptr) {
+        return;
+    }
+    cJSON* obj = cJSON_Parse(screen->ToJson().c_str());
+    if (obj != nullptr) {
+        cJSON_AddItemToObject(root, "display", obj);
+    }
+}
