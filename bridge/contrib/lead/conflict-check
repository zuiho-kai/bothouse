#!/usr/bin/env -S python3 -I
# 同一份产物上的检查互查冲突：列出手里管交接、交回、回复的每道检查（总表 ~/wiki/rules/house-rules.toml 的 [[check]]），
# 用固定样例互相喂——一道检查要求写的写法，交给同产物的其它检查判，报出互相否定的组合。
# 新增或修改交接/交回检查后必跑：python3 conflict-check（仓库或线上副本目录里跑都行）。
# 来源：用户 11-23「这个不是修过么，规则统一管理，怎么还会冲突」；11-23 #1891 界面活的「用户视角走查」行
#   是交接规则强制要写的，判官却判成多加的设定，来回退三次。按一类修：列出同一产物上的全部检查两两查冲突。
# 只自动喂程序能判的检查（交接规则、判官放行表、交回格式、回复格式、提问自路由）；要模型的关卡
# （对照原话、宣传闸、尺子）不在这里烧钱，实测在用户实际用的入口走一遍时覆盖，这里只列出来提醒。
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOUSE = Path(os.environ.get("HOUSE_RULES") or Path.home() / "wiki" / "rules" / "house-rules.toml")
os.environ.setdefault("HOUSE_RULES", str(HOUSE))  # 判官（_added_judge）读同一份总表
BIN = os.environ.get("CC_BIN") or shutil.which("bothouse") or shutil.which("cc-connect")

# 交接样例：能过产品默认 + 严格档 + 本机叠加的必填项（非界面活，避免顺手触发界面类门槛）。
BASE = """# 交接：冲突检查样例

## 用户原话
- [11-23] 用户：「把导出的表格改好」

## 总目标
把导出的表格改好。

## 范围
- 改：导出的表格
- 不改：无
- 复用盘点：查过 ~/.bothouse/gate/board.py:1，管不到导出，所以新建

## 参照实现
- 无（新建）

## 已查过什么
- ~/wiki/rules/house-rules.toml:1

## 进度
- 未开工

## 总部判断
- 要的效果：导出表格不再挤成两列，用户一眼能看清
- 好的样子：和旧版一样一行一项，列不再合并
- 教训和定案：默认格式以前被退回，定案在 ~/wiki/log.md:1

## 相关改动
冲突：无

## 规矩
- 照本机守则
"""

# 交回样例：五段 + 入口自验（要有 ``` 包住的输出或成品路径）+ 范围逐项。
REPORT = """[report] #1893 背景：冲突检查样例

做了一件事，检查都过。

要你做的：没有

给你的：无

我加的：无

细节：

入口自验：本机规则表
```
$ python3 rules.py check
