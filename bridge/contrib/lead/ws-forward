#!/usr/bin/env -S python3 -I
# 把本频道收到的结果摘要转给工作区里的主角色：插进最近一次 ws-handoff 的交接文件「## 转交结果」节末尾，再叫醒她（提示里直接带原文）。
# 用法：ws-forward [--interrupt] [--id <任务号> | --notes <交接文件>] "<摘要>"
#   --id 按任务板编号认这件活（验收提示给的就是它）；--notes 也认路径栏里的 PR/分支/提交链接（#1371）。
#   --notes 转给那份交接对应的工作区（ws-up 给聊天频道的提示里会带上）；不给就转给最近一次交接。
#   --interrupt 用户改了要求：工作区正在跑就插进当前这一轮（timer --inject-if-busy），提示让它先停下按旧要求做的部分。
#     桥在用户回复某件活的汇报时自动带上它（reply_task.go forwardReplyToWorkspace）。来源：用户 10-30 复盘，改需求没转进工作区。
# 桥扣着这件活的文字 [report] 等主角色验收时（core/team_report_accept.go），转话即打回：照常转给工作区返工，
# 送到后让桥丢掉那份汇报不贴（bothouse report reject）；没送到就不丢，超时照贴。来源：用户 11-09「工作群返回你要看一眼」，打回用 ws-forward。
# 最近一次交接记在 <GATE_SETUP_DIR>/ws-handoff-last.json（ws-handoff 写，见 _team.py）。
# 来源：用户 2026-10-23「如果你觉得已经开始管不过来了，你可以去开新的频道，就叫工作区……」「方便任意人当主角色，并且也能放到仓库」。
import json, os, re, subprocess, sys, time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _team  # noqa: E402

sys.path.insert(0, os.environ.get("GATE_DIR") or str(Path(__file__).resolve().parent.parent / "gate"))
import board  # noqa: E402  转交结果节的插入和暂停状态都以任务板为准（../gate/board.py）

PROMPT_MAX = 1500  # 叫醒提示直接带原文；太长的截断，全文在交接文件里


def append_result(path: str, summary: str, now: str):
    board.append_forward(path, f"{now} {summary}")


def wake_prompt(path: str, summary: str, interrupt: bool = False):
    """叫醒提示直接带这次转的原文，不让工作区去文件里找（找错节读到旧的「接着做」，见 board.append_forward）。"""
    text = summary if len(summary) <= PROMPT_MAX else summary[:PROMPT_MAX] + f"…（全文见 {path}「转交结果」节最新一条）"
    hit = board.paused_item(path)
    if hit:
        if hit.get("backlog"):  # 待办：小事排在 bug 后面，等主频道恢复再做
            return (f"主频道转来一条话，这件活已挪进待办（#{hit['id']}）：停手，不要再起后台命令，正在跑的停掉，"
                    f"别按交接里更早的话接着做。原文：{text}")
        return (f"主频道转来一条话，这件活已暂停（#{hit['id']}）：停手，不要再起后台命令，正在跑的停掉，"
                f"别按交接里更早的话接着做。原文：{text}")
    if interrupt:
        return (f"打断：用户改了要求（已记进 {path}「转交结果」节）。先停下按旧要求做的部分，"
                f"正在跑的旧命令该停就停，按这条新要求接着做，交回时说明按新要求改了什么：{text}")
    return f"主频道转来一条话（已记进 {path}「转交结果」节），按这条做：{text}"


def timer_cmd(ws: str, path: str, summary: str, interrupt: bool = False, project: str = ""):
    # --forward：主频道转来的一次性通知，不是状态轮询；桥的防循环按 Forward 放行
    # （core/anti_spin.go CheckAntiSpinTimer）。不能改用 --handoff：那条路这一轮以 handoff
    # 身份跑、跳过注入（core/engine.go inject_if_busy 判定），紧急转交的 --interrupt 会失效。
    if not project:
        raise ValueError("ws-forward: 接收项目未知，不能用调用者 CC_PROJECT 代替工作区执行者")
    cmd = [_team.cc_bin() or "cc-connect", "timer", "add", "-p", project, "-s", ws if ":" in ws else f"discord:{ws}", "--delay", "1m", "--timeout-mins", "0",
           "--forward", "--desc", "工作区转交", "--prompt", wake_prompt(path, summary, interrupt)]
    if interrupt:  # 工作区正在跑就插进当前这一轮，不排到它跑完之后
        cmd[cmd.index("--delay") + 1] = "1s"
        cmd.insert(cmd.index("--timeout-mins"), "--inject-if-busy")
    return cmd


def recipient_project(last: dict, live):
    """Resolve the current board owner; the forwarding caller is never a recipient fallback."""
    recorded = str(last.get("project") or "")
    if live is None:
        if recorded:
            return recorded
        raise ValueError("ws-forward: 旧交接未记接收项目，任务板也无当前负责人；请先核归属再重新交接")
    owner = re.sub(r"^工作区\d*\s*", "", str(live.get("who") or "")).strip()
    # The record binds otherwise-unmapped project ids (e.g. the configured lead);
    # the team's named subs resolve a later owner transfer without guessing.
    candidates = [recorded, *(_team.team().get("subs") or {})]
    matches = {p for p in candidates if p and owner in (p, _team.name_of(p))}
    if len(matches) == 1:
        return matches.pop()
    raise ValueError("ws-forward: 当前任务负责人无法唯一对应接收项目；请核任务板与交接归属，不转给调用者")


def task_ids(last: dict):
    """ws-handoff 记下的这次交接的任务板编号（tasks[...]["board"]）。同一份交接交给几个工作区时，
    靠它分清是哪一条，不按文件名混到同文件的旧条目上（11-09 #1261 已交回拦住了转给 #1271）。"""
    out = set()
    for x in last.get("board") or []:
        try:
            out.add(int(x))
        except (TypeError, ValueError):
            pass
    return out


def find_live(last: dict):
    """任务板上这次交接对应、没暂停的在做条目：先按交接记下的编号找（工作区可能改过 where），再按文件名找。"""
    ids, cur = task_ids(last), board.items()
    return (next((i for i in cur if i.get("id") in ids and i.get("chat") and not i.get("paused")), None)
            or next((i for i in cur if i.get("where") == last["file"] and i.get("chat") and not i.get("paused")), None))


def find_done(last: dict):
    """这次交接对应的活已交回就返回做完的记录，否则 None。只看当前要转去的那条：
    交接记下的编号还挂在任务板上就算没交回，不管同文件的旧条目是不是已交回。"""
    ids = task_ids(last)
    if ids:
        if any(i.get("id") in ids for i in board.items()):
            return None
        hit = next((r for r in reversed(board.done_records()) if r.get("id") in ids and not r.get("auto_pruned")), None)
        if hit:
            return hit
    return board.done_item(last["file"])


def reject_held_report(path: str, summary: str, nid=None):
    """这份交接的文字汇报正被桥扣着等验收：转话就是打回，让桥别再贴它（超时也不贴）。没扣着就什么都不做。
    nid：这件活的任务板编号；已交回的活不在 board.items() 里，按文件名找不到，要由调用方给（11-09 #1261）。"""
    if nid is None:
        ids = [int(i["id"]) for i in board.items() if i.get("where") == path and str(i.get("id", "")).isdigit()]
        if not ids:
            return
        nid = max(ids)
    try:
        r = subprocess.run([_team.cc_bin() or "cc-connect", "report", "reject", "--id", str(nid), "--reason", summary],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"ws-forward: 没能让桥打回 #{nid} 的待验收汇报（{exc}），它可能超时后照贴", file=sys.stderr)
        return
    if r.returncode == 0:
        print(f"ws-forward: #{nid} 的文字汇报已打回，不会贴给用户", file=sys.stderr)
    elif r.returncode != 3:  # 3：没有扣着的汇报
        print(f"ws-forward: 打回 #{nid} 的待验收汇报失败：{(r.stderr or r.stdout).strip()[:200]}", file=sys.stderr)


def other_chat_work(last: dict):
    """last 的工作区眼下挂着的、别的聊天频道交来的在做条目（没暂停、不在待办）；没有返回 None。
    这份交接的来源频道查不到时，工作区上任何别的交接的在做条目都算（宁可不转，不串频道）。"""
    ws = str(last.get("channel") or "").split(":")[-1]
    chat = str(last.get("chat") or "").split(":")[-1]
    for it in board.items():
        if (str(it.get("ws") or "").split(":")[-1] == ws and not it.get("paused") and not it.get("backlog")
                and it.get("where") != last.get("file") and (not chat or str(it.get("chat") or "").split(":")[-1] != chat)):
            return it
    return None


def by_id(last: dict, nid: int):
    """任务号 nid 对应的转话目标：ws-handoff 记下这个编号的交接优先，没有（别的角色交的、旧记录）就用任务板条目本身（#1371）。"""
    it = board.item_by_id(nid)
    for k, v in (last.get("tasks") or {}).items():
        if isinstance(v, dict) and v.get("channel") and nid in [int(x) for x in (v.get("board") or []) if str(x).isdigit()]:
            return {"file": v.get("file") or k, "channel": v.get("ws_key") or v["channel"], "chat": v.get("chat") or "",
                    "project": v.get("project") or "", "board": [nid]}
    if not it:
        sys.exit(f"ws-forward: 任务板上没有 #{nid}（板上和已完成记录都查过）")
    return {"file": board.handoff_of(it), "channel": it.get("ws") or it.get("ws_was") or "",
            "chat": it.get("chat") or "", "project": "", "board": [nid]}


def main(argv):
    notes, interrupt, nid = None, False, 0
    while argv[:1] and argv[0] in ("--interrupt", "--notes", "--id") and len(argv) > 1:
        if argv[0] == "--interrupt":
            interrupt, argv = True, argv[1:]
        elif argv[0] == "--notes":
            notes, argv = argv[1], argv[2:]
        else:
            v = argv[1].lstrip("#")
            if not v.isdigit():
                sys.exit("ws-forward: --id 后面要跟任务板编号")
            nid, argv = int(v), argv[2:]
    # 摘要以「-」开头多半是想看用法（11-05 两次把 --help 当摘要转进了工作区），不转。
    if len(argv) != 1 or not argv[0].strip() or argv[0].lstrip().startswith("-"):
        sys.exit('用法：ws-forward [--interrupt] [--id <任务号> | --notes <交接文件>] "<摘要>"')
    if not _team.LAST.is_file():
        sys.exit(f"ws-forward: 还没跑过 ws-handoff（没有 {_team.LAST}）")
    last = json.loads(_team.LAST.read_text(encoding="utf-8"))
    if not nid and notes and "://" in notes:  # 路径栏里的链接：按任务板认，不拼成相对路径（#1371）
        ids = board.ids_by_link(notes)
        if len(set(ids)) != 1:
            sys.exit(f"ws-forward: 路径栏是这个链接的活{'有好几件（' + '、'.join('#' + str(i) for i in ids) + '）' if ids else '在任务板上没有'}，"
                     f"用 --id <任务号> 写明是哪件")
        nid = ids[0]
    if nid:
        last = by_id(last, nid)
    elif notes:
        path = os.path.abspath(os.path.expanduser(notes))
        tasks = {k: v for k, v in (last.get("tasks") or {}).items() if isinstance(v, dict) and v.get("channel")}
        rec = tasks.get(path)
        alts = [k for k, v in tasks.items() if v.get("file") == path]
        if rec is not None and alts:  # 同一份交接交给了几个工作区：要写明是哪个
            sys.exit(f"ws-forward: {path} 交给了几个工作区，用 --notes 写明：{'；'.join([path, *alts])}")
        if rec is None:
            sys.exit(f"ws-forward: {path} 没有 ws-handoff 记录")
        last = {"file": rec.get("file") or path, "channel": rec.get("ws_key") or rec["channel"], "chat": rec.get("chat") or "",
                "project": rec.get("project") or "", "board": rec.get("board") or []}
    done = find_done(last)
    if done:  # 已交回：工作区会话已清空、放回池子，话发过去没人接（用户 10-30「他那边不是返回了吗？为什么没感知」）
        # 交回的汇报还扣着等验收时，转话也算打回，否则 10 分钟后照贴（用户 11-09「为什么会超过10分钟」，#1261）
        reject_held_report(last["file"], argv[0], done.get("id"))
        sys.exit(f"ws-forward: #{done['id']}（{done.get('short') or done.get('what')}）{done.get('done_at', '')} 已交回，工作区已清空。"
                 f"要接着做就重新 ws-handoff 这份交接：{last['file']}")
    hit = board.paused_item(last["file"])
    if hit and hit.get("pause_why") == board.ASK_WHY and not hit.get("ws"):
        # 提问后工作区已让出（board ask / ws-up --ask）：答复交 ws-handoff --resume 找空工作区接着做，不发去旧工作区
        r = subprocess.run([str(Path(__file__).resolve().parent / "ws-handoff"), "--resume", str(hit["id"]), argv[0]])
        if r.returncode == 0:
            reject_held_report(last["file"], argv[0], hit.get("id"))
        sys.exit(r.returncode)
    live = find_live(last)
    if live is not None and str(live.get("ws") or "").split(":")[-1] != str(last["channel"]).split(":")[-1]:
        if live.get("ws"):
            last["channel"] = live["ws"]  # 这件活换了工作区：转到它现在所在的那个
        else:
            # 这件活已交回、让出了原工作区（交回待验收、排队等），原工作区可能已归别的聊天频道：不发去旧工作区，
            # 交 ws-handoff --resume 找空着的接着做（都占着就新建或排队）。来源 #1154：11-06 23:02 记忆论坛的转话
            # 发进了已在做小剧场的工作区2，截图落到小剧场频道，用户「为什么会推到这边来」。
            r = subprocess.run([str(Path(__file__).resolve().parent / "ws-handoff"), "--resume", str(live["id"]), argv[0]])
            if r.returncode == 0:  # 交回待验收的活转话＝打回：桥扣着的文字汇报不再贴
                reject_held_report(last["file"], argv[0], live.get("id"))
            sys.exit(r.returncode)
    if live is None:
        other = other_chat_work(last)
        if other is not None:
            # 任务板上查不到这件活，原工作区眼下在做别的聊天频道的活：不发过去（#1155，补 #1154 的这条路）
            sys.exit(f"ws-forward: 工作区 {str(last['channel']).split(':')[-1]} 正在做别的聊天频道的 #{other['id']}"
                     f"（{other.get('short') or other.get('what')}），这份交接在任务板上查不到，没转。"
                     f"要接着做就重新 ws-handoff 这份交接：{last['file']}")
    try:
        project = recipient_project(last, live)
    except ValueError as exc:
        sys.exit(str(exc))
    if nid and not last["file"]:  # 路径栏只有链接、也没有 ws-handoff 记录：转交结果没处写，工作区读不到（#1371）
        sys.exit(f"ws-forward: #{nid} 在任务板上没有交接文件（路径栏只有链接），转不了话；用 board update {nid} <状态> <交接文件> 补上再转")
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    append_result(last["file"], argv[0], now)
    r = subprocess.run(timer_cmd(last["channel"], last["file"], argv[0], interrupt, project), capture_output=True, text=True)
    if r.returncode != 0:
        # 没叫醒就不算送到（来源 #75 交接：失败必须留下未投递的事实，不能把写进交接当发送成功）
        why = (r.stderr.strip() or r.stdout.strip())[:200]
        board.append_forward(last["file"], f"{now} ⚠️ 上面这条没送到工作区（timer add 失败：{why}）。工作区没收到它，重试请原样重发这一句。")
        sys.exit(f"ws-forward: timer add 失败：{r.stderr.strip() or r.stdout.strip()}")
    reject_held_report(last["file"], argv[0], live.get("id") if live else None)  # 送到了：桥扣着的文字汇报（如有）算打回
    # 转了新话，工作区要接着做：这件活的兜底定时器从现在重新算（board.arm_guard；暂停的活不挂）
    for it in board.items():
        if (it.get("where") == last["file"] or (live and it.get("id") == live.get("id"))) and it.get("ws") and not it.get("paused") and not it.get("backlog"):
            board.arm_guard(it["id"])
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id


if __name__ == "__main__":
    main(sys.argv[1:])
