#!/bin/sh
# 主角色用的自重启：后台等本轮回复发完再重启桥（bothouse / cc-connect），避免把自己这轮杀掉。
# 可选固定签名检查由 CC_SIGN_BIN / CC_SIGN_ID 配置。
# 配置（环境变量）：
#   CC_LOG           桥日志，等里面出现 "turn complete" 再重启；不设依次用 CC_LOG_FILE（桥给会话导出的）、
#                    <CC_DATA_DIR 或 ~/.bothouse>/logs/bothouse.log、~/.cc-connect/logs/cc-connect.log 里存在的那个
#   CC_RESTART_LOG   本脚本的重启记录（默认 CC_LOG 同目录 safe-restart.log）
#   CC_LAUNCHD_LABEL 可选：自建 launchd 服务名（形如 com.<你>.cc-connect），给了就 launchctl kickstart -k 它；
#                    不设就用 `<CC_BIN 或 PATH 里的 bothouse> daemon restart`（bothouse daemon install 装的服务）
#   CC_SIGN_BIN / CC_SIGN_ID  可选：二进制路径和期望的 codesign Identifier；都给了才检查，签名不对就拒绝重启
#   CC_PRE_RESTART   可选：重启前跑的检查命令，失败只警告
# 用法：safe-restart "原因" "重启后接着做的事|无" [任务板编号]
# 第三个参数：给了就用 later 记在这条任务板条目的「下次看」上（later 只记原条目，不新建回看条目）；没给就裸挂桥定时叫醒，不上任务板
# 第二个参数：重启后约 2 分钟自动叫醒本会话接着做，免得重启完干等（用户 2026-10-23「为什么看到后续了以后只能搞个定时任务跟踪一下」，起因 12:38 重启后空等 8 分钟）
set -u
here=$(cd "$(dirname "$0")" && pwd)
LOG=${CC_LOG:-${CC_LOG_FILE:-}}
if [ -z "$LOG" ]; then
  LOG=${CC_DATA_DIR:-$HOME/.bothouse}/logs/bothouse.log
  [ -f "$LOG" ] || LOG=$HOME/.cc-connect/logs/cc-connect.log
fi
OUT=${CC_RESTART_LOG:-$(dirname "$LOG")/safe-restart.log}
LABEL=${CC_LAUNCHD_LABEL:-}
cc=${CC_BIN:-$(command -v bothouse || command -v cc-connect || echo cc-connect)}
if [ -z "$LABEL" ] && ! "$cc" daemon --help >/dev/null 2>&1; then
  echo "没设 CC_LAUNCHD_LABEL，$cc 也没有 daemon restart；设 CC_LAUNCHD_LABEL 或 CC_BIN" >&2; exit 1
fi
reason=${1:-未写原因}
next=${2:-}
[ -n "$next" ] || { echo "要写第二个参数：重启后接着做什么（没有就写「无」）" >&2; exit 1; }
[ "$next" = 无 ] && next=
[ -f "$LOG" ] || { echo "找不到日志 $LOG（设 CC_LOG）" >&2; exit 1; }
if [ -n "${CC_SIGN_BIN:-}" ] && [ -n "${CC_SIGN_ID:-}" ]; then
  codesign -dv "$CC_SIGN_BIN" 2>&1 | grep -q "Identifier=$CC_SIGN_ID" || { echo "签名不是固定签名，拒绝重启（会丢授权），先重新编译签名" >&2; exit 1; }
fi
# 桥在已签名的 .app 里时，整包签名必须校验通过：只重签了包里的程序、包里还留着旧的整包封签，
# 系统就认不出旧授权，屏幕录制、完全磁盘访问等全部失效（#858，2026-11-01 装自编译版后发生）
case "$cc" in
  */Contents/MacOS/*)
    app=${cc%/Contents/MacOS/*}
    if codesign -dv "$app" >/dev/null 2>&1 && ! chk=$(codesign --verify --strict "$app" 2>&1); then
      echo "⛔ $app 整包签名校验失败，拒绝重启（重启后会丢屏幕录制等授权）：$chk" >&2
      echo "   先把整个 .app 重新签名（签 .app，不只签里面的程序），再重启" >&2
      exit 1
    fi ;;
esac
# 可配置的重启前检查：失败只警告、不拦重启
if [ -n "${CC_PRE_RESTART:-}" ]; then
  chk=$(sh -c "$CC_PRE_RESTART" 2>&1) || echo "⚠️ 警告（不影响重启）：$chk" >&2
fi
start=$(wc -l < "$LOG")
nid=${3:-}
if [ -n "$next" ]; then
  wake="桥刚重启。先查 $LOG 里每个已配置的平台都已连接，然后马上做：$next"
  if [ -n "$nid" ]; then
    # 走 later：叫醒记在原条目的「下次看」上，用户看得见；定时挂不上 later 会把 next 改回原值（用户 2026-10-23「补，我要大家都能这样」）
    "$here/later" "$nid" 2m "$wake" >/dev/null || echo "⚠️ 重启后叫醒没挂上，重启完要自己接着做" >&2
  else
    sk=${CC_SESSION_KEY:-${CC_SESSION:-}}
    { [ -n "${CC_PROJECT:-}" ] && [ -n "$sk" ] && "$cc" timer add -p "$CC_PROJECT" -s "$sk" --delay 2m --desc "重启后接着做" --prompt "$wake" >/dev/null; } \
      || echo "⚠️ 重启后叫醒没挂上，重启完要自己接着做" >&2
    echo "（没给任务板编号，重启叫醒不上任务板；要上板写第三个参数：safe-restart 原因 接着做 <编号>）" >&2
  fi
fi
# 脱离调用者的进程组：桥停时会按进程组杀会话里的子进程，重启脚本跟着死就没人把桥拉起来
if command -v setsid >/dev/null 2>&1; then det=setsid
elif command -v perl >/dev/null 2>&1; then det="perl -MPOSIX -e POSIX::setsid();exec(@ARGV)or(die)"
else det=; fi
# shellcheck disable=SC2086
nohup $det sh -c '
  i=0
  while [ "$i" -lt 60 ]; do
    sleep 5
    tail -n +$(($1+1)) "$2" | grep -q "turn complete" && break
    i=$((i + 1))
  done
  sleep 3
  echo "$(date "+%Y-%m-%d %H:%M:%S") 重启：$3" >> "$4"
  if [ -n "$5" ]; then launchctl kickstart -k "gui/$(id -u)/$5"; else "$6" daemon restart; fi >> "$4" 2>&1
' _ "$start" "$LOG" "$reason" "$OUT" "$LABEL" "$cc" >/dev/null 2>&1 &
echo "已安排：本轮回复发出后约 10 秒重启桥（最多等 5 分钟）。原因：$reason"
