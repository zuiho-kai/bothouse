#!/bin/zsh
# 主角色用的自重启：后台等本轮回复发完再重启 cc-connect，避免把自己这轮杀掉。
# 可选固定签名检查由 CC_SIGN_BIN / CC_SIGN_ID 配置。
# 配置（环境变量）：
#   CC_LOG           cc-connect 日志（默认 ~/.cc-connect/logs/cc-connect.log），等里面出现 "turn complete" 再重启
#   CC_RESTART_LOG   本脚本的重启记录（默认 CC_LOG 同目录 safe-restart.log）
#   CC_LAUNCHD_LABEL launchd 服务名（必填，形如 com.<你>.cc-connect）
#   CC_SIGN_BIN / CC_SIGN_ID  可选：二进制路径和期望的 codesign Identifier；都给了才检查，签名不对就拒绝重启
#   CC_PRE_RESTART   可选：重启前跑的检查命令，失败只警告
# 用法：safe-restart "原因" ["重启后接着做的事"]
# 第二个参数：重启后约 2 分钟自动叫醒本会话接着做，免得重启完干等（用户 2026-10-23「为什么看到后续了以后只能搞个定时任务跟踪一下」，起因 12:38 重启后空等 8 分钟）
set -u
here=${0:A:h}
LOG=${CC_LOG:-$HOME/.cc-connect/logs/cc-connect.log}
OUT=${CC_RESTART_LOG:-${LOG:h}/safe-restart.log}
LABEL=${CC_LAUNCHD_LABEL:?先设 CC_LAUNCHD_LABEL=<launchd 服务名，形如 com.<你>.cc-connect>}
reason=${1:-未写原因}
next=${2:-}
[[ -n $next ]] || { echo "要写第二个参数：重启后接着做什么（没有就写「无」）" >&2; exit 1; }
[[ $next == 无 ]] && next=
[[ -f $LOG ]] || { echo "找不到日志 $LOG（设 CC_LOG）" >&2; exit 1; }
if [[ -n ${CC_SIGN_BIN:-} && -n ${CC_SIGN_ID:-} ]]; then
  codesign -dv $CC_SIGN_BIN 2>&1 | grep -q "Identifier=$CC_SIGN_ID" || { echo "签名不是固定签名，拒绝重启（会丢授权），先重新编译签名" >&2; exit 1; }
fi
# 可配置的重启前检查：失败只警告、不拦重启
if [[ -n ${CC_PRE_RESTART:-} ]]; then
  chk=$(zsh -c "$CC_PRE_RESTART" 2>&1) || echo "⚠️ 警告（不影响重启）：$chk" >&2
fi
start=$(wc -l < $LOG)
if [[ -n $next ]]; then
  # 走 later：叫醒也上置顶任务板，用户看得见；定时挂不上 later 会自己撤掉那行（用户 2026-10-23「补，我要大家都能这样」）
  "$here/later" 2m "重启后接着做" "桥刚重启。先查 $LOG 里每个已配置的平台都已连接，然后马上做：$next" >/dev/null || echo "⚠️ 重启后叫醒没挂上，重启完要自己接着做" >&2
fi
nohup zsh -c '
  for i in {1..60}; do
    sleep 5
    tail -n +$(($1+1)) $2 | grep -q "turn complete" && break
  done
  sleep 3
  echo "$(date "+%F %T") 重启：$3" >> $4
  launchctl kickstart -k gui/$(id -u)/$5
' _ "$start" "$LOG" "$reason" "$OUT" "$LABEL" >/dev/null 2>&1 &
disown
echo "已安排：本轮回复发出后约 10 秒重启 cc-connect（最多等 5 分钟）。原因：$reason"
