        rec["ws_key"] = ws
    old = tasks.get(path)
    key = path
    if isinstance(old, dict) and str(old.get("channel") or "") != rec["channel"]:
        # 同一份交接交给另一个工作区：另记一条（ws-up/ws-forward 用 --notes <文件>@ws<id> 认），不覆盖前一条
        key, rec["file"] = f"{path}@ws{rec['channel']}", path
    if key in tasks:
        base = f"{path}@ws{rec['channel']}@task{nid or len(tasks) + 1}"
        key = base
        serial = 1
        while key in tasks:
            key = f"{base}-{serial}"
            serial += 1
        rec["file"] = path
    tasks[key] = rec
    # 唯一写者；别的脚本和桥都读它：写临时文件再改名，不让读者读到半截
    import os  # 测试只摘这个函数执行，不带模块头的导入
    tmp = _team.LAST.with_name(_team.LAST.name + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"file": path, "channel": ws, "task": task, "chat": chat, "project": project, "tasks": tasks},
                              ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, _team.LAST)


def _lead_name(project):
    return _team.name_of(project) if project else "主角色"


GUARD = None  # --guard 给的时长；None 用 board.GUARD_DELAY


def own_workspace(previous, nid) -> str:
    """这件活自己的会话所在的工作区：桥暂停它时记下会话的那个（team_workspaces.json tasks[编号].session_ws），
    没有就用任务板上上次绑的 ws_was。挑工作区时排第一，认领得了就回原会话接着做。
    来源：#933（11-21 #928）。ws-up --ask 在工作区自己那一轮里暂停任务，#1729 起那一轮照常跑完、工作区等它结束才放回；
    这里原先只在验收退回时才优先原工作区，答复续办按编号挑了另一个空工作区，桥把原会话复制过去
    （15:01:26「resumed with its saved session … from=…446」），原工作区那一轮还在跑：同一件活两个会话并行，
    后台命令的叫醒和转话又进了原工作区。原工作区在那一轮里只收这件活本身（桥 claim 对别的活报占用），
    被别的活占了就照常换下一个。"""
    t = ((_ws_state().get("tasks") or {}).get(str(nid)) or {}) if nid else {}
    return str(t.get("session_ws") or previous.get("ws_was") or "")


# 配置错（记的模型不在列表、切不成）：再试也一样败，退出码用它，桥到点重试收到就停、不再每 10 分钟重派（#1972）。
# 来源：11-24 等外部重试日志 210 次失败全是「模型 保持现状 没切成」，#1893 重派 81 次。
EXIT_CONFIG = 3


def start(path, task, chat, nid, project, answer=None, reassigned=False):
    """续做：挑工作区（原来占着的优先，没有空的 pick_pool 会新建或退出）、绑任务板 #nid、叫醒。"""
    previous = next((i for i in board.items() if i["id"] == nid), {})
    # 接回前先核记着的模型，和首次交活同一个校验（_model.check）；不对就不占工作区、不动板，按配置错退出
    bad = _model.check(previous.get("model"), previous.get("effort"), project) if previous.get("model") else None
    if bad:
        print(f"ws-handoff: #{nid} 记着的模型 {_model.label(previous.get('model'), previous.get('effort'))} 不能用：{bad}",
              file=sys.stderr)
        sys.exit(EXIT_CONFIG)
    reassigned = reassigned or bool(previous.get("dispatcher") and project and project != previous.get("dispatcher"))
    preferred = "" if reassigned else own_workspace(previous, nid)
    ws, name, parent = (None if reassigned else held(previous, chat)) or pick_pool(chat, task, nid, preferred)
    board.update(nid, "已交接", who=f"{name}{_lead_name(project)}", dispatcher=project)
    board.rebind(nid, ws)
    append_skeleton(path, nid)
    # 交活指定过模型的活接回、续做时照它再切（#2075）：新认领的工作区放回时已换回它自己的模型
    why = _model.apply(ws if ":" in ws else f"discord:{ws}", previous.get("model"), previous.get("effort"), project)
    r = (subprocess.run(timer_cmd(ws, path, task, nid, answer, project, chat), capture_output=True, text=True) if why is None else
         subprocess.CompletedProcess([], 1, "", f"模型 {_model.label(previous.get('model'), previous.get('effort'))} 没切成：{why}"))
    if r.returncode != 0:
        # 没叫醒：工作区放回、任务板整条退回改前（#1492 L3：原先只放工作区，板停在「已交接」绑着那个工作区）
        parked = board._park_once(cc_bin(), ws, parent)
        back = board.restore(previous) if previous else False
        msg = (f"ws-handoff: #{nid} 叫醒 {name} 失败：{r.stderr.strip() or r.stdout.strip()}；"
               f"任务板{'已退回改前（' + str(previous.get('status') or '') + '）' if back else '没退回（板上找不到这条，原样留着）'}，"
               f"工作区{'已放回' if parked else '没放回（桥没放或本就不归这件，见上面的报错）'}")
        if why is not None:  # 模型切不成是配置错，再试也一样
            print(msg, file=sys.stderr)
            sys.exit(EXIT_CONFIG)
        sys.exit(msg)
    record_last(path, ws, task, chat, nid, project)
    board.arm_guard(nid, GUARD)
    md = _model.label(previous.get("model"), previous.get("effort"))
    print(f"ws-handoff: #{nid} 交给 {name}" + (f"，模型 {md}" if md else ""), file=sys.stderr)


def resume_answered(nid, answer, project=None, model=None, effort=None):
    """等你的活收到答复：恢复条目、答复写进交接，找空工作区接着做（core resumeAskedTask 调）。"""
    board.refuse_foreign([nid], "ws-handoff")  # 别的频道派的活不在这里续（#836）；桥续办时以条目的 chat 调，照常过
    it = next((i for i in board.items() if i["id"] == nid), None)
    back = None
    if it is None:
        # 已完成又要返工的活这一步自己拿回板上（暂停着），下面照常恢复、认领一个工作区：不用先 board resume（见 held）。
        done = board.item_by_id(nid)
        if done and done.get("chat") and os.path.isfile(done.get("where") or ""):
            back = board.take_back(nid)
            it = next((i for i in board.items() if i["id"] == nid), None)
    if it is None or not it.get("chat") or not os.path.isfile(it.get("where") or ""):
        sys.exit(f"ws-handoff: #{nid} 不是 ws-handoff 交的活，没法接回")
    if not back and it.get("rework_cap") and it.get("paused"):
        # 返工上限（board.reject 第二次退回）：不再续做，等用户定；用户定了接着改，按用户的标准另交一次。
        sys.exit(f"ws-handoff: #{nid} {board.REWORK_CAP_WHY}，不再续做。先问用户（聊天频道已发 [ask]）；"
                 "用户定了接着改，把用户定的标准写进交接，用 ws-handoff 另交一次")
    # 提问还在主角色手里（没转给用户）时到的答复是主角色定的，不写成用户说的
    by_lead = (it.get("pause_why") or "").startswith(board.ASK_LEAD_WHY)
    is_ask = by_lead or (it.get("pause_why") or "") == board.ASK_WHY or (it.get("pause_why") or "").startswith(board.ASK_WHY)
    source = ("验收退回" if it.get("review_rejected") else
              "到点重试" if (it.get("pause_why") or "").startswith(board.WAIT_EXT) else
              "主角色定案" if by_lead else "用户答复")
    if by_lead:
        answer = f"（主角色定的，不是用户说的）{answer}"
    if source != "到点重试":
        # 用户后面再纠正：聊天频道里新说的原话原样补进讨论原文、排在前面；主角色写的这句标「只作参考」（用户 11-24 批）。
        # 「到点重试」那句不动：timer_cmd 靠它开头分支。
        fresh = _source.append_new(it["where"], it["chat"], os.environ.get("CC_PROJECT") or it.get("dispatcher") or "")
        answer = _source.relay_text(fresh, answer) or answer
    if answer:
        board.append_forward(it["where"], f"{board._now()} {source}（#{nid}）：{answer}")
    _recall.append_to(it["where"])  # 改动前交出的活没有旧定案节，接回时补上（已有就跳过，上次没搜成就重搜）

    # 接着做的是谁：
    # 默认保持原负责人（orig_dispatcher）和原工作区，避免桥重试（core/team_wait_external.go:123）、
    # 提问定案（#1727）或验收退回时，注入聊天频道的 CC_PROJECT 误伤改派；
    # 只有显式指定 --project 时才发生改派（reassigned），更新 dispatcher 并分配干净新工作区。
    caller = os.environ.get("CC_PROJECT", "")
    orig_dispatcher = it.get("dispatcher", "")
    if project:
        target_project = project
    else:
        target_project = orig_dispatcher or caller

    reassigned = bool(project and target_project != orig_dispatcher)
    # 若改派，更新任务板条目记录的 dispatcher
    if reassigned:
        board.update(nid, it.get("status", "已交接"), dispatcher=target_project)
        it["dispatcher"] = target_project

    # 若指定了模型，更新任务板
    if model:
        board.set_model(nid, model, effort)
        it["model"] = model
        if effort:
            it["effort"] = effort

    board.resume(nid)
    try:
        start(it["where"], it["what"], it["chat"], nid, target_project, answer, reassigned=reassigned)
    except SystemExit as e:
        # 叫醒失败：start 已把板退回到续做前一刻；再退回接回前（暂停 / 待验收退回），答复留在交接里注明没送到，
        # 下次接回时照常再走（#1492 L3）
        board.restore(it)
        board.append_forward(it["where"], f"{board._now()} ⚠️ 上面这条{source}没送到工作区（叫醒失败），#{nid} 已退回接回前的状态。")
        if e.code == EXIT_CONFIG:  # 配置错：原因 start 已打到 stderr，退出码原样交给桥
            print(f"ws-handoff: #{nid} 已退回接回前（{it.get('status') or ''}），答复没送到", file=sys.stderr)
            sys.exit(EXIT_CONFIG)
        sys.exit(f"{e.code}；#{nid} 已退回接回前（{it.get('status') or ''}），答复没送到")


# 活名：这件活在任务帖标题、置顶任务表、汇报里的同一个名字（#1732，用户 11-17「那个标题我根本看不懂啊」）。
SHORT_HOW = ("活名是任务帖标题、置顶任务表和汇报里这件活的名字，写成用户一眼认得出的一句话：要做成什么，用用户自己的词，"
             "比如 --short 帖子标题改成人话；不写编号、代号和只有你懂的叫法")


def auto_notes(task: str) -> str:
    """#2042 一句话交活：主角色只给一句话，交接文件由程序写进当前目录 notes/：原话节是交活前 3 小时这个聊天频道里
    用户自己说的每条（桥的会话记录导出，同讨论原文 _source._history、is_user），那句话放进参考节。返回交接文件路径；
    导出不到用户的话就退出，不交空交接。"""
    chat = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    project = os.environ.get("CC_PROJECT", "")
    if ":" not in chat or not project:
        sys.exit("ws-handoff: 一句话交活要在桥的会话里跑（读 CC_SESSION_KEY、CC_PROJECT 导出原话）；不在桥里就写交接文件：\n" + USAGE)
    start = _source._window_start("")
    msgs, _ = _source._history(chat, project, start)
    quotes = [(ts, who, c.strip()) for ts, who, c in msgs if _source.is_user(who, c or "")]
    if not quotes:
        sys.exit(f"ws-handoff: 这个聊天频道 {start:%H:%M} 以来没导出到用户的话，交接里没有原话；写交接文件再交：\n" + USAGE)
    rows = [f"{who}（{ts[5:10]} {ts[11:16]}，原样）：\n{c}\n" for ts, who, c in quotes]
    d = Path.cwd() / "notes"
    d.mkdir(exist_ok=True)
    path = d / f"handoff-auto-{datetime.now():%m%d-%H%M%S}.md"
    path.write_text(f"# {task}\n\n## {_QUOTE_SEC}\n\n" + "\n".join(rows) + f"\n## {_source.LEAD_SAYS}\n\n{task}\n", encoding="utf-8")
    print(f"ws-handoff: 交接文件程序写好了 {path}（原话 {len(quotes)} 条，{start:%m-%d %H:%M} 起）", file=sys.stderr)
    return str(path)


def main(argv):
    if argv[:1] == ["--drain"]:  # 排队表 11-24 拿掉；桥放回工作区后还调（core/team_workspace_one.go），留成空操作
        return 0
    if "--resume" in argv:
        rem = [a for a in argv if a != "--resume"]
        rem, model, effort = _model.parse(rem)
        resume_project = None
        if "--project" in rem:
            idx = rem.index("--project")
            if idx + 1 < len(rem):
                resume_project = rem[idx + 1].strip()
                rem = rem[:idx] + rem[idx + 2:]
            else:
                sys.exit("ws-handoff: --project 后面要跟角色项目名")
        if not rem:
            sys.exit("ws-handoff: --resume 后面要跟任务编号，如 ws-handoff --resume 123 [答复]")
        nid = int(rem[0].lstrip("#"))
        answer = " ".join(rem[1:]) if len(rem) > 1 else ""
        return resume_answered(nid, answer, project=resume_project, model=model, effort=effort)
    global GUARD
    if "--guard" in argv:
        k = argv.index("--guard")
        GUARD = argv[k + 1] if k + 1 < len(argv) else None
        if not GUARD or not re.fullmatch(r"(\d+h)?(\d+m)?", GUARD):
            sys.exit("ws-handoff: --guard 要写时长，如 30m、90m、2h")
        argv = argv[:k] + argv[k + 2:]
    force = "--force" in argv
    probe = "--probe" in argv
    argv = [a for a in argv if a not in ("--confirmed", "--force", "--probe")]  # --confirmed 已不用，带了照收
    follow_id = 0  # --follow：这件接着哪件旧活做，归属跟着它（#2010）
    if "--follow" in argv:
        k = argv.index("--follow")
        v = argv[k + 1].lstrip("#") if k + 1 < len(argv) else ""
        if not v.isdigit():
            sys.exit("ws-handoff: --follow 后面要跟任务板编号，如 --follow 1148")
        follow_id, argv = int(v), argv[:k] + argv[k + 2:]
    short_name = None
    argv, model, effort = _model.parse(argv)
    if "--short" in argv:
        k = argv.index("--short")
        short_name = argv[k + 1] if k + 1 < len(argv) else None
        argv = argv[:k] + argv[k + 2:]
    if len(argv) == 1 and argv[0].strip():  # #2042：一句话交活，交接文件程序写
        argv = [auto_notes(argv[0]), argv[0]]
    if len(argv) != 2 or not argv[1].strip():
        sys.exit(USAGE)
    # 活名由交活人写，不再从任务句截字（用户 10-30 认可的置顶表方案：没写就退回让写）。
    short_name = (short_name or "").strip()
    given_short = short_name  # 交活人自己写的短名才查同名撞活；从任务句截的不算（截出来同名的多）
    if not short_name and not _handoff_rules.load()["flags"].get("require_short"):
        short_name = board.short_of(argv[1])[:board.SHORT_RUNES]
    if not short_name or len(short_name) > board.SHORT_RUNES:
        sys.exit(f"ws-handoff: 要写 --short 活名（≤{board.SHORT_RUNES} 字）：{SHORT_HOW}")
    bad = board.short_problem(given_short)
    if bad:
        sys.exit(f"ws-handoff: --short「{given_short}」{bad}，用户认不出是哪件事。{SHORT_HOW}")
    path, task = os.path.abspath(os.path.expanduser(argv[0])), argv[1]
    if not os.path.isfile(path):
        sys.exit(f"ws-handoff: 交接文件不存在 {path}\n{USAGE}")
    with open(path, encoding="utf-8") as fh:
        notes = fh.read()
    # 先说一声在交：后面搜旧定案、挑工作区要几十秒；Codex 的命令等几秒就先返回，没这行它会以为桥没响应，
    # 跟用户说「工作区还没回执、不确定成没成」（agentm 11-09 #25，那次交活跑了 47 秒）
    try:
        err = check_notes(notes, task)
    except RuntimeError as e:  # 规则文件读不到或写坏：报错不放行
        sys.exit(f"ws-handoff: {e}")
    if err:
        sys.exit(f"ws-handoff: {err}")
    err = _narrow_gate.check(notes)  # #1999：缩范围的话要有用户原话撑着
    if err:
        sys.exit(f"ws-handoff: {err}")
    if effort and not model:  # 分流前统一拦：并进已有任务的分支只转 --model，单写的 --effort 会被丢掉（审稿 #2076 第三轮）
        sys.exit(f"ws-handoff: {_model.check(None, effort)}")
    # 读文件的检查过了才说「在交」：交接没过时这句让模型以为每次重交都要等一两分钟（#1514，实际退回不到 1 秒）
    print("ws-handoff: 交活中（查交接、搜旧定案、挑工作区、上任务板，通常半分钟到两分钟）；命令没退出就是还在交，"
          "等它退出再看最后几行，不要先跟用户说没成功或工作区不确定", file=sys.stderr, flush=True)
    # 这件活归哪个聊天频道，建活时定一次（#2010）：--follow 的旧活归哪就归哪；否则就是跑命令的这个聊天频道。
    # 不读交接正文的「聊天频道：」行、不看成品文件名、不看工作区眼下归谁。
    here = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    here_chat = ":".join(here.split(":", 2)[:2]) if ":" in here else ""
    in_ws = bool(here_chat) and here_chat in board._workspace_keys()
    follow = board.item_by_id(follow_id) if follow_id else None
    if follow_id and not follow:
        sys.exit(f"ws-handoff: --follow {follow_id}：任务板和已完成记录里都没有 #{follow_id}")
    if follow:
        chat = board.owner_or_exit(follow_id, "ws-handoff")
    elif in_ws:
        sys.exit("ws-handoff: 在工作区里交活要写 --follow <这件活接着的任务编号>：工作区不是谁的归属频道，归属跟着那件活走")
    else:
        chat = here
    said = chat if in_ws else here  # 用户说话的频道：原话从这导
    ref = follow or resume_ref(task, notes)
    if ref is not follow and ref and board.owner_chat(ref) and board.owner_chat(ref) != ":".join(chat.split(":", 2)[:2]):
        sys.exit(f"ws-handoff: 任务句写的是 #{ref['id']}，它归 {board.owner_chat(ref)}，不是这里。是续它就加 --follow {ref['id']}"
                 "（归属跟着它）；不是就把编号从任务句和标题里去掉")
    if in_progress(ref):
        return join(ref, path, task, model, effort, follow=bool(follow))
    dup = None if force else live_dup(path)
    if in_progress(dup):
        return join(dup, path, task, model, effort)
    if dup:
        sys.exit(f"ws-handoff: {dup_error(dup)}")
    hits = [] if force else live_overlap(path, given_short, notes)
    if hits:
        sys.exit(f"ws-handoff: {overlap_error(hits)}")
    # 新开的活才按本项目核模型（#2075：模型 id 不在列表里不交，列出可选项）。并进已有任务的两条（上面 join）不在这核：
    # 接手的可能是别的项目，由 ws-forward 按接手方项目和工作区会话核（early_check），按发起方核会误拒（审稿 #2076 第二轮）
    err = _model.check(model, effort)
    if err:
        sys.exit(f"ws-handoff: {err}")
    # 交活前按原话和总目标搜旧定案，追加成交接的「旧定案（程序搜出）」节；搜不到写「没搜到」，小模型没调成写「没搜成（原因）」
    # 并照实打印（接回时重搜），都不拦交活
    recall = _recall.start(path)  # 和下面挑工作区、上任务板同时跑，叫醒工作区前收（#1732）
    if append_source(path, said):
        print(f"ws-handoff: 已附「{SOURCE}」", file=sys.stderr)
    else:  # 这份交接交过（原话文件已在）：只把上次导出之后聊天频道里新说的补进去
        _source.append_new(path, said)
    if fold_lead_notes(path):
        print(f"ws-handoff: 主角色写的节已归到「{_source.LEAD_SAYS}」", file=sys.stderr)
    parent = ""  # 走共享池时交接记在桥里的聊天频道；叫醒失败按它撤掉刚 claim 的那件
    nid = None
    by = assigner()
    if _team.workspace():
        ws, name = fixed_channel(chat), "工作区"
    elif ":" not in chat:
        sys.exit("ws-handoff: 没配工作区频道（WS_CHANNEL / 团队文件 \"workspace\"），也不在桥的会话里（CC_SESSION_KEY），没法从池里挑工作区")
    else:
        # 先上板拿编号再 claim：桥按编号记这件活的状态（#699），claim 不带编号看门就只能猜是哪一行
        nid = board.add(task, path, "排队", "待接手", chat=chat, short_name=short_name, probe=probe, assigner=by)
        try:
            picked = pick_pool(chat, task, nid)
        except SystemExit:
            board.unadd(nid)  # 没交出去：撤掉刚上的板，不留一条没人做的排队
            raise
        if picked is None:
            board.unadd(nid)
            sys.exit(f"ws-handoff: #{nid} 认领新工作区失败，未排队；请检查 workspace claim 错误")
        ws, name, parent = picked
    # 先上任务板、绑这个工作区（编号要写进开工提示，同本机 ws-handoff 先 board_add 再叫醒）：
    # 放回只看绑定的条目（board pause / 把「谁」改走），刚交的活不会被当成没人做
    key = ws if ":" in ws else f"discord:{ws}"
    lead_name = _team.name_of(os.environ["CC_PROJECT"]) if os.environ.get("CC_PROJECT") else "主角色"
    if nid is None:  # 固定工作区频道：不经桥的池子，不 claim
        nid = board.add(task, path, "已交接", f"{name}{lead_name}", ws=key, chat=chat, short_name=short_name, probe=probe, assigner=by)
    else:
        board.update(nid, "已交接", who=f"{name}{lead_name}")
        board.rebind(nid, key, chat=chat)
    block = _recall.finish(recall, path)
    if block and _recall.FAIL_LINE in block:
        why = block.split(_recall.FAIL_LINE, 1)[1].strip().splitlines()[0]
        print(f"ws-handoff: {_recall.FAIL_LINE}{why}，交接里照实写了，接回时重搜", file=sys.stderr)
    elif block:
        print(f"ws-handoff: 已附「{_recall.SECTION}」", file=sys.stderr)
    append_skeleton(path, nid)
    # 交活指定的模型（#2075）：先记上任务板，再排到工作区会话下一轮（就是下面叫醒的这一轮）；没切成按叫醒失败撤回
    why = None
    if model:
        board.set_model(nid, model, effort)
        why = _model.apply(key, model, effort)
    r = (subprocess.run(timer_cmd(ws, path, task, nid, chat=chat), capture_output=True, text=True) if why is None else
         subprocess.CompletedProcess([], 1, "", f"模型 {_model.label(model, effort)} 没切成：{why}"))
    if r.returncode != 0:
        # 叫醒失败：撤掉刚上的板和刚 claim 的那一件交接（只放这一件，同 board pause 的 park），不留给看门判无进展
        # _park_once 返回 None（桥没响应、拒绝或出错）时交接还记在桥里，不能说撤掉了（审稿 pr410 必须改 2）
        board.unadd(nid)
        why = r.stderr.strip() or r.stdout.strip()
        if not parent:
            sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid}）：{why}")
        buf = io.StringIO()
        with contextlib.redirect_stderr(buf):
            parked = board._park_once(cc_bin(), key, parent)
        if parked is None:
            m = re.search(r"工作区没放回（(.*)）", buf.getvalue(), re.S)
            reason = (m.group(1) if m else buf.getvalue()).strip() or "workspace park 没成功"
            sys.exit(f"ws-handoff: timer add 失败：{why}\n"
                     f"任务板已撤，交接没放回（{reason}），桥恢复后跑 workspace park --session-key {key} --chat {parent}")
        sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid} 和这件交接）：{why}")
    record_last(path, ws, task, chat, nid)
    guard = board.arm_guard(nid, GUARD)
    print(f"ws-handoff: 任务板 #{nid}" + (f"，模型 {_model.label(model, effort)}" if model else "") +
          (f"，兜底定时器 {guard}（{GUARD or board.GUARD_DELAY}）" if guard else ""), file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id
    # 交出后主角色就收手：G27 实测里没有这句时，主角色在本轮 sleep 50 秒查任务板等工作区，聊天频道被占 8–11 分钟
    print(DONE.format(name=name))


# 交活放进独立会话里跑，前台只跟着看：调用方（Codex 的 exec_command 等几秒就先返回、回合结束桥关掉 agent 进程；
# Claude 的 Bash 两分钟超时）把前台杀掉时，交活照样跑完，没交成就在本频道补一句，不留「嘴上交了、板上没有」。
# 来源：用户 2026-11-12「修复隔壁问题，gpt老是丢失任务」；agentm 11-12 03:52Z 那轮 ws-handoff 跑到第 24 秒，
# 回合结束关进程（turn ended: closing agent process）连带杀掉，任务板没有这件，模型已跟用户说「已提交工作区」。
WORKER = "WS_HANDOFF_WORKER"  # 有值＝自己就是后台那份，值是前台进程号
RUNS_DIR = _team.SETUP / "handoff-runs"


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _tell_chat(text: str):
    """前台已被杀、交活又没成：在交活的聊天频道补一句（发不出就只留在回执文件里）。"""
    chat = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    proj = os.environ.get("CC_PROJECT", "")
    if not chat or not proj:
        return
    try:
        subprocess.run([cc_bin(), "send", "-p", proj, "-s", chat, "--message", text.replace("<@", "<\u200b@")],
                       capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001  只是补报，失败写进回执
        print(f"ws-handoff: 补报没发出去（{e}）", file=sys.stderr)


def worker(argv):
    parent = int(os.environ.get(WORKER) or 0)
    rc, why = 0, ""
    try:
        main(argv)
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        why = "" if isinstance(e.code, int) or e.code is None else str(e.code)
        if why:
            print(why, file=sys.stderr)
    except BaseException as e:  # noqa: BLE001
        rc, why = 1, f"{type(e).__name__}: {e}"
        print(why, file=sys.stderr)
    finally:
        sys.stdout.flush(); sys.stderr.flush()
    if rc and parent and not _alive(parent):
        task = (f"#{argv[1].lstrip('#')} 续办" if argv[:1] == ["--resume"] and len(argv) > 1
                else argv[1] if len(argv) > 1 else "")
        _tell_chat(f"⚠️ 刚才说交给工作区的「{task}」没交出去（交活命令在回合结束后才报错）：{why.strip()[:600] or f'exit {rc}'}\n"
                   "这件活现在不在任务板上，要重新交。")
    os._exit(rc)


def run(argv):
    # --resume 也有模型直接调（续办暂停的活、ws-forward 转），同样会被回合结束杀掉，一起放后台；--drain 只由桥在后台调
    if os.environ.get(WORKER) or os.environ.get("WS_HANDOFF_INLINE") or argv[:1] == ["--drain"]:
        return worker(argv) if os.environ.get(WORKER) else main(argv)
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    stem = RUNS_DIR / f"{datetime.now().strftime('%m%d-%H%M%S')}-{os.getpid()}"
    out, err = stem.with_suffix(".out"), stem.with_suffix(".err")
    with open(out, "w") as fo, open(err, "w") as fe:
        p = subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), *argv], stdin=subprocess.DEVNULL,
                             stdout=fo, stderr=fe, start_new_session=True,
                             env=dict(os.environ, **{WORKER: str(os.getpid())}))
    print(f"ws-handoff: 回执 {err}；本命令被打断也会在后台交完，没交成会在本频道补一句。"
          "看到最后一行「任务板 #N」才算交出", file=sys.stderr, flush=True)
    pos = 0
    while True:
        done = p.poll() is not None
        with open(err, encoding="utf-8", errors="replace") as fh:
            fh.seek(pos)
            chunk = fh.read()
            pos = fh.tell()
        if chunk:
            sys.stderr.write(chunk)
            sys.stderr.flush()
        if done:
            break
        time.sleep(0.2)
    with open(out, encoding="utf-8", errors="replace") as fh:
        sys.stdout.write(fh.read())
    sys.stdout.flush()
    sys.exit(p.returncode)


if __name__ == "__main__":
    run(sys.argv[1:])
