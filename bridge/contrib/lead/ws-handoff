# （首次 10-30 #780），复盘 role-household-puck185-night-retro-1031.md 第 6 条。
def _real(where: str) -> str:
    return os.path.realpath(os.path.expanduser(re.sub(r"@ws.*$", "", str(where or ""))))


def live_dup(path: str):
    """同一份交接文件进行中的任务板条目（没有返回 None）。"""
    me = _real(path)
    return next((i for i in board.items() if not i.get("paused") and not i.get("backlog") and i.get("where") and _real(i["where"]) == me), None)


def dup_error(it) -> str:
    where = it.get("who") or it.get("ws") or "工作区"
    return (f"这份交接已有进行中的活 #{it['id']}（{where}，状态：{it.get('status') or '—'}），没再交。"
            f"要接着做用 ws-forward 转话；确实要再开一件，加 --force 重跑。")


