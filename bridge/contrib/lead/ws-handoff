def cc_bin() -> str:
    return os.environ.get("CC_BIN") or shutil.which("bothouse") or shutil.which("cc-connect") or "cc-connect"


def ws_cmd(chat: str, *args):
    """<桥> workspace <args> --session-key <chat> --json；失败 sys.exit 带桥的原话。"""
    r = subprocess.run([cc_bin(), "workspace", *args, "--session-key", chat, "--json"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"ws-handoff: workspace {args[0]} 失败：{r.stderr.strip() or r.stdout.strip()}")
    try:
        return json.loads(r.stdout or "{}")
    except ValueError:
        sys.exit(f"ws-handoff: workspace {args[0]} 回的不是 JSON：{r.stdout.strip()[:200]}")


def num(name: str) -> int:
    m = re.fullmatch(r"工作区(\d+)", str(name or ""))
    return int(m.group(1)) if m else 10 ** 9


def _park_until_freed(key: str, parent: str) -> int:
    """<桥> workspace park 到工作区放回（每次放 parent 交的一件；工作区不归 parent 了桥就拒绝），返回放了几件。"""
    n = 0
    while True:
        p = subprocess.run([cc_bin(), "workspace", "park", "--session-key", key, "--chat", parent, "--json"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            return n
        n += 1
        try:
            if json.loads(p.stdout or "{}").get("freed"):
                return n
        except ValueError:
            return n


def migrate_unbound(chat: str, plat: str, parent: str, pool: list) -> bool:
    """一次性迁移（每个聊天频道只做一次）：升级前交的活在桥里记了交接、任务板上没绑编号；本频道占着的工作区里，
    任务板上已没有在做的条目时，把这些旧交接放回，工作区回池子。在做 = 没暂停的条目（later 回查的也算：它在等 CI，
    到点要回来接着做），按条目所在频道（sk/ch）或「谁」写的工作区名（升级前常由聊天频道 add、工作区只改「谁」，
    条目频道是聊天频道）认工作区；拿不准就不放（宁可多占，不停在做的活，审查 pr261-code.md 第 3 条）。之后的交接都绑编号
    （main 建条目），放回只看绑定条目（board pause / 把「谁」改走）。还有在做条目的工作区不动，等那些条目收尾。
    来源：本机止血审查第二轮（~/.claude/reviews/ws-stale-local-code.md）后的根因方案（notes/ws-stale-occupy-1025.md）。
    返回是否放回了工作区（要重新 list）。"""
    try:
        done = set(json.loads(MIGRATED.read_text(encoding="utf-8")))
    except (OSError, ValueError, TypeError):
        done = set()
    if parent in done:
        return False
    working = [i for i in board.items() if not i.get("paused") and not i.get("backlog")]
    live = {board._ws_key(i) for i in working} | {i.get("ws") for i in working}
    names = {m.group(1) for i in working for m in [board.WS_NAME_RE.match(str(i.get("who") or ""))] if m}
    freed = False
    for w in pool:
        if not isinstance(w, dict):
            continue
        key = f"{plat}:{w.get('id')}"
        if (str(w.get("owner") or "") == parent and int(w.get("open") or 0) > 0 and key not in live
                and str(w.get("name") or "") not in names):
            n = _park_until_freed(key, parent)
            print(f"ws-handoff: {w.get('name') or w.get('id')} 只剩升级前没绑任务板的交接，放回 {n} 件", file=sys.stderr)
            freed = freed or n > 0
    MIGRATED.parent.mkdir(parents=True, exist_ok=True)
    MIGRATED.write_text(json.dumps(sorted(done | {parent}), ensure_ascii=False), encoding="utf-8")
    return freed


def claim_cmd(chat: str, wid: str, task: str, nid: int):
    """<桥> workspace claim：旗标写在工作区 id 前（Go flag 遇到第一个位置参数就停，写在后面的 --session-key/--title
    会被丢掉）；--title 是任务简称，十分钟看门催促里用（cmd/cc-connect/workspace.go --title），同本机 ws-handoff bridge_claim。
    --board：任务板编号，桥按它记这件活的状态（#699：派出→在做→暂停），看门只写这一条，不再按工作区和标题猜是哪行。"""
    return [cc_bin(), "workspace", "claim", "--session-key", chat, "--title", task[:60], "--board", str(nid), str(wid)]


def _ws_state() -> dict:
    """桥的工作区状态 <数据目录>/team_workspaces.json（只读）；读不到 → {}。"""
    try:
        return json.loads((_team.datadir.data_dir() / "team_workspaces.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, SystemExit):
        return {}


def lead_chat(chat: str) -> str:
    """工作区会话 key → 交活的聊天频道（现在占着它的 owner，否则它最近一件交接的 chat）；不是工作区原样返回。
    工作区里跑 ws-handoff 时 CC_SESSION_KEY 是工作区自己，桥拒绝从工作区 claim（errTeamIsWorkspace「channel is a
    workspace」），这件活只能进队列，而 drain 每次在它身上 claim 失败退出，后面的活全卡住（本机 11-08：排队的活
    卡了 5 天，6 个工作区空着）。池子操作一律以聊天频道的身份做。"""
    state = _ws_state()
    wid = chat.split(":", 1)[-1]
    for owner, rows in (state.get("parents") or {}).items():
        if any(isinstance(w, dict) and str(w.get("id")) == wid for w in rows or []):
            return owner
    for h in reversed((state.get("handoffs") or {}).get(chat) or []):
        if h.get("chat") and h.get("chat") != chat:
            return str(h["chat"])
    return chat


# 派活前清掉「已交回却没放回池子」的工作区（反思 11-07 a 类，用户 11-08 03:23 工作区1「我看基本上没工作，但是他被占用」）。
# 根因（日志 bothouse.log.2 11-04 12:07）：[report] 贴出后桥用内存里的 time.AfterFunc 排了放回（core/team_auto_return.go
# scheduleWorkspaceReturn），6 秒后桥重启，这一步丢了；重启后看门只看 Idle.Returned 为假的交接（team_idle_watch.go），
# 于是工作区1 挂了 87 小时。桥侧补法另开活；这里在每次派活前按交接状态 + 日志里最近有没有动静，补做那次放回。
WATCH_WINDOW = 10 * 60  # 沿用桥看门现成的一档 check_after=10m（日志「team workspace watch started」），不另设新时长
STALE_RETURN = WATCH_WINDOW  # 交回后过了看门一档还没放回就补
QUIET = WATCH_WINDOW  # 这一档内日志里工作区还有事件就当它在跑，不动
def _bridge_log():
    """桥日志 <数据目录>/logs/bothouse.log。"""
    try:
        return _team.datadir.data_dir() / "logs" / "bothouse.log"
    except SystemExit:
        return Path.home() / ".bothouse" / "logs" / "bothouse.log"


def _iso(s):
    try:
        return datetime.fromisoformat(s).timestamp()
    except (TypeError, ValueError):
        return None


def stale_returned(state: dict, now: float, recent=frozenset()):
    """[(工作区会话 key, 交接)]：交接没关也没暂停、看门记了已交回、交回超过看门一档、是这个工作区最新一件、
    最近一档内日志里没有它的事件（recent 是有事件的会话 key）。"""
    out = []
    for ws, rows in (state.get("handoffs") or {}).items():
        if not rows or ws in recent:
            continue
        h = rows[-1]
        idle = h.get("idle") or {}
        ended = _iso(idle.get("ended"))
        if h.get("closed") or h.get("parked") or not idle.get("returned") or ended is None:
            continue
        if now - ended > STALE_RETURN:
            out.append((ws, h))
    return out


def recent_sessions(now: float, log=None):
    """最近 QUIET 秒内桥日志里出现过的 session=… key（只读日志尾部 2MB）。"""
    keys = set()
    log = log or _bridge_log()
    try:
        with open(log, "rb") as f:
            f.seek(max(0, os.path.getsize(log) - 2_000_000))
            tail = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return None  # 看不到日志就不敢判断，不动
    for line in tail:
        m = re.match(r"time=(\S+)", line)
        t = _iso(m.group(1)) if m else None
        if t is None or now - t > QUIET:
            continue
        for k in re.findall(r"(?:session|session_key|workspace)=(\S+)", line):
            keys.add(k if ":" in k else "discord:" + k)
    return frozenset(keys)


def release_stale_returned(chat: str):
    """派活前补做丢掉的放回：workspace park <id> --chat <交接的聊天频道> --before <交接时间>，只动那一件。失败只打印。"""
    now = time.time()
    recent = recent_sessions(now)
    if recent is None:
        return
    try:
        state = _ws_state()
    except SystemExit:
        return
    for ws, h in stale_returned(state, now, recent):
        wid = ws.split(":", 1)[-1]
        r = subprocess.run([cc_bin(), "workspace", "park", "--session-key", chat, "--chat", h.get("chat", ""),
                            "--before", h.get("at", ""), "--json", wid], capture_output=True, text=True)
        tag = "已放回" if r.returncode == 0 else "放回失败：" + (r.stderr.strip() or r.stdout.strip())[:200]
        print(f"ws-handoff: {h.get('name') or wid} 交回后没放回池子（{h.get('title', '')[:30]}），{tag}", file=sys.stderr)


def notes_chat(notes: str, chat: str) -> str:
    """交接文件「原话出处」节已写「聊天频道：<平台>:<id>」、和跑命令的频道不同，就按交接写的记这件活的聊天频道：
    claim、任务板 chat、汇报、[ask]、兜底定时器都回那里。跑命令的是工作区（lead_chat 会换成 owner）、没写、写的就是
    本频道时原样返回。来源：11-10 #1342 笨蛋英文 X 版的活从 1562131004234276945 交出，📬 贴进了那里（#1346，
    用户「这个不是这个频道工作，但怎么往这个频道塞」）。"""
    source = notes.split(f"## {SOURCE}\n", 1)
    section = source[1].split("\n## ", 1)[0] if len(source) == 2 else ""
    m = re.search(r"^- 聊天频道：(\S+:\S+)\s*$", section, re.M)
    if not m or not chat or ":" not in chat:
        return chat
    want = m.group(1)
    if want == chat or want.split(":", 1)[0] != chat.split(":", 1)[0] or lead_chat(chat) != chat:
        return chat
    if lead_chat(want) != want:  # 交接里写的是个工作区：不改投
        return chat
    print(f"ws-handoff: 交接文件写的聊天频道是 {want}，不是跑命令的 {chat}；这件活记到 {want}，汇报、[ask]、兜底定时器都回那里",
          file=sys.stderr)
    return want


def pick_pool(chat: str, task: str, nid: int, preferred: str = ""):
    """共享池里挑一个工作区并 claim（记一件交接），返回（工作区会话 key <平台>:<id>，工作区名，交接的聊天频道 parent）；
    没有空的、池子又满 MAX_WS 个时返回 None（排队）。
    claim 不带 --owner：交接的 owner 为空时，桥的十分钟看门按本 bot 自己在工作区的发言（IsSelf）
    算进展（core/team_watch.go ownerSpoke）；接手的就是本 bot 的主角色，不用另传 id。"""
    chat = lead_chat(chat)
    release_stale_returned(chat)
    plat = chat.split(":", 1)[0]
    r = ws_cmd(chat, "list")
    parent = str(r.get("parent") or chat)
    if migrate_unbound(chat, plat, parent, r.get("pool") or []):
        r = ws_cmd(chat, "list")
    ok = [w for w in r.get("pool") or [] if isinstance(w, dict) and w.get("id")
          and str(w.get("owner") or "") in ("", parent) and int(w.get("open") or 0) < BUSY]
    ok.sort(key=lambda w: (f"{plat}:{w['id']}" != preferred, int(w.get("open") or 0), num(w.get("name"))))
    for w in ok:
        c = subprocess.run(claim_cmd(chat, w["id"], task, nid), capture_output=True, text=True)
        if c.returncode == 0:
            return f"{plat}:{w['id']}", str(w.get("name") or w["id"]), parent
        print(f"ws-handoff: {w.get('name')} 认领不了（{c.stderr.strip()}），换下一个", file=sys.stderr)
    if len([w for w in r.get("pool") or [] if isinstance(w, dict) and w.get("id")]) >= MAX_WS:
        return None
    w = (ws_cmd(chat, "new").get("workspace") or {})
    if not w.get("id"):
        sys.exit("ws-handoff: workspace new 没回工作区")
    c = subprocess.run(claim_cmd(chat, w["id"], task, nid), capture_output=True, text=True)
    if c.returncode != 0:
        sys.exit(f"ws-handoff: workspace claim 失败：{c.stderr.strip() or c.stdout.strip()}")
    print(f"ws-handoff: 池里的工作区都在忙，新开了 {w.get('name') or w['id']}", file=sys.stderr)
    return f"{plat}:{w['id']}", str(w.get("name") or w["id"]), parent


SOURCE = "原话出处（程序附）"
_STAMP = re.compile(r"(\d{1,2})-(\d{1,2})\s+(\d{1,2}):(\d)([\dxX])")


def _window_start(text):
    """时间窗起点：用户原话那节里最早的「MM-DD HH:MM」（10:2x 按 10:20）往前 10 分钟；没有或早于 3 天前，取交活前 3 小时。"""
    import datetime as dt
    now = dt.datetime.now().astimezone()
    body = text.split(f"## {_QUOTE_SEC}", 1)[1].split("\n## ", 1)[0] if f"## {_QUOTE_SEC}" in text else ""
    got = []
    for m in _STAMP.finditer(body):
        mo, d, h, t, u = m.groups()
        try:
            got.append(now.replace(month=int(mo), day=int(d), hour=int(h), minute=int(t) * 10 + (0 if u in "xX" else int(u)),
                                   second=0, microsecond=0))
        except ValueError:
            continue
    got = [g for g in got if now - dt.timedelta(days=3) <= g <= now]
    return (min(got) - dt.timedelta(minutes=10)) if got else now - dt.timedelta(hours=3)


def append_source(path, chat, project=None):
    """给交接追加「原话出处」节：聊天频道 id、交活人的会话记录、时间窗，并把时间窗里这个聊天频道的原始对话
    （用户、主角色和队友的原话，来自桥的会话记录 sessions/<项目>_*.json）导出到 <交接>.原话.md。
    已有就不再加；出任何错只返回 None，不拦交活。来源：用户 11-01「工作区…他也可以看我们的会话原话啊，解决人类之间这种传递有损的问题」。"""
    try:
        text = Path(path).read_text(encoding="utf-8")
        if SOURCE in text or ":" not in (chat or ""):
            return None
        project = project or os.environ.get("CC_PROJECT", "")
        data = Path(os.environ.get("CC_DATA_DIR") or Path.home() / ".bothouse")
        start = _window_start(text)
        msgs, agent_ids = [], []
        for f in sorted((data / "sessions").glob(f"{project}_*.json")):
            d = json.loads(f.read_text(encoding="utf-8"))
            sids = (d.get("user_sessions") or {}).get(chat) or []
            for sid in sids:
                s = (d.get("sessions") or {}).get(sid) or {}
                if s.get("agent_session_id"):
                    agent_ids.append(s["agent_session_id"])
                for m in s.get("history") or []:
                    ts = m.get("timestamp") or ""
                    if ts and ts >= start.isoformat():
                        msgs.append((ts, m.get("role") or "?", m.get("content") or ""))
        msgs.sort()
        dump = Path(path).with_suffix("").as_posix() + ".原话.md"
        with open(dump, "w", encoding="utf-8") as fh:
            fh.write(f"# 聊天频道 {chat} 原始对话（{start:%m-%d %H:%M} 到交活，{len(msgs)} 条）\n")
            fh.write("# user 条里有用户和队友的原话（行头「[时:分] 名字:」）；assistant 是主角色自己说的。\n\n")
            for ts, role, c in msgs:
                fh.write(f"### {ts[5:16].replace('T', ' ')} {role}\n{c}\n\n")
        tr = ""
        if agent_ids:
            hits = sorted(Path.home().glob(f".claude/projects/*/{agent_ids[-1]}.jsonl"))
            tr = str(hits[0]) if hits else ""
        lines = [f"## {SOURCE}",
                 "（交活时程序附：开工先读这里的原始对话，再读总部判断那节；交接正文是主角色的转述，和原话冲突时信原话）",
                 f"- 聊天频道：{chat}",
                 f"- 时间窗：{start:%m-%d %H:%M} 到交活",
                 f"- 原话导出：{dump}（{len(msgs)} 条）",
                 f"- 读原话：sed -n '1,400p' '{dump}'"]
        if tr:
            lines.append(f"- 主角色交活时的会话记录：{tr}")
        lines.append(f"- 时间窗外再找：{Path(__file__).resolve().parent / 'chanlog'} <关键词> --since {start:%m-%d} --full")
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("" if text.endswith("\n") else "\n") + "\n" + "\n".join(lines) + "\n")
        return dump
    except Exception:  # noqa: BLE001
        return None


def _codemap():
    """codemap-inject.py（派子任务附地图的那份选图逻辑，#875 已五家通用）：装好的在数据目录 hooks/，仓库里在 ../hooks/。"""
    import importlib.util
    data = os.environ.get("CC_DATA_DIR")
    for d in ([Path(data) / "hooks"] if data else []) + [Path(__file__).resolve().parent.parent / "hooks",
                                                          Path.home() / ".bothouse" / "hooks"]:
        f = d / "codemap-inject.py"
        if f.is_file():
            spec = importlib.util.spec_from_file_location("codemap_inject", f)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


