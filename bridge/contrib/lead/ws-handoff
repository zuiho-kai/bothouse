# 续做交接点名的旧任务还在做：并进它的工作区，不新开任务、不另派会话。任务句或交接标题以「接回 #N」「续 #N」「续做 #N」
# 「接着做 #N」开头才算（正文里顺带提到旧编号的不算）；不设绕过，--force 只管同文件、同名两道。同一份交接文件再交、
# 那件还在做的，也并进去，不再让交活的人自己转话。
# 来源：11-17 #1727 在工作区6 做着，任务句和标题都写「接回 #1727」的新交接（新文件、新短名，两道防重复都对不上）
# 被开成 #1730、认领了工作区7，同一个用量面板做了两份（PR #1906 / #1908，返工 #1733）。
RESUME_REF = re.compile(r"\s*(?:接回|续做|接着做|续)\s*#(\d+)")


def resume_ref(task: str, notes: str):
    """任务句或交接标题开头点名的旧任务（任务板上的条目）；没点名或板上没有返回 None。"""
    title = next((l[2:] for l in notes.splitlines() if l.startswith("# ")), "")
    m = RESUME_REF.match(task) or RESUME_REF.match(title)
    return next((i for i in board.items() if i.get("id") == int(m.group(1))), None) if m else None


def in_progress(it) -> bool:
    """条目真有工作区在做：板上绑着工作区、没暂停、没进待办、没交回，而且桥里那个工作区眼下认领着的就是它。
    板上还挂着「在做」、工作区已经归了别的活的不算（11-17 #1727 交回后板上没收，工作区6 已在做 #1736）。"""
    if not it or not it.get("ws") or it.get("paused") or it.get("backlog") or it.get("returned_at"):
        return False
    rows = (_ws_state().get("handoffs") or {}).get(it["ws"]) or []
    return any(h.get("board") == it["id"] and not h.get("closed") and not h.get("parked") for h in rows)


def held(it, chat: str):
    """这件活眼下已经占着的工作区（见 in_progress）：续做就在那里接着做，不再挑一个空的另认领。返回同 pick_pool，没占着返回 None。
    来源：11-17 #1748 完成后返工，board resume 先按旧工作区向桥收回了一次，随后 ws-handoff --resume 又挑空工作区认领一次：
    10:46 同时占了工作区4 和工作区1，11:08 占了工作区1 和工作区2；没人叫醒的那个 20 分钟后被看门报「到点没有进展」。"""
    if not in_progress(it):
        return None
    r = ws_cmd(chat, "list")
    wid = it["ws"].split(":", 1)[-1]
    name = next((str(w["name"]) for w in r.get("pool") or [] if isinstance(w, dict) and str(w.get("id")) == wid and w.get("name")), wid)
    return it["ws"], name, str(r.get("parent") or chat)


def join(old, path: str, task: str, model=None, effort=None, follow=False) -> int:
    """这次交的内容用 ws-forward 转进正在做 old 的工作区；转成返回 0，没转成退出并说明。两种都不上板、不认领。"""
    who = old.get("who") or "工作区"
    same = _real(old.get("where") or "") == _real(path)
    what = (f"同一份交接又交了一次，没新开任务，并进这件：{task}" if same else
            f"续做交接并进这件（没新开任务、没另派工作区）：{task}。新交接文件 {path}，先读它再接着做")
    env = dict(os.environ)
    if board.foreign_why(old):  # 转话命令不碰别的频道派的活（#836）；--follow 明写了续这件才放行，不改写 CC_SESSION_KEY（#2010）
        if not follow:
            sys.exit(f"ws-handoff: #{old['id']} 是 {board.channel_of(old) or '别的频道'} 的活、正在做；要把这次的内容并进它就加 --follow {old['id']}，"
                     "不是续它就把任务句里的编号去掉")
        env["BOARD_FOLLOW"] = str(old["id"])
    pick = (["--model", model] + (["--effort", effort] if effort else [])) if model else []  # 重新指定的模型一并转过去（#2075）
    r = subprocess.run([sys.executable, "-I", str(Path(__file__).resolve().parent / "ws-forward"), *pick, "--id", str(old["id"]), what],
                       capture_output=True, text=True, env=env)
    if r.returncode != 0:
        sys.exit(f"ws-handoff: #{old['id']} 还在{who}做着，没新开任务；内容没转进去：{(r.stderr or r.stdout).strip()[:300]}")
    print(f"ws-handoff: 任务板 #{old['id']}（{who}正在做）：这次交的已并进去，没新开任务、没另派工作区", file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])
    print(f"没新开任务：#{old['id']} 还在{who}做着，这次交的内容已转给它。本轮到此结束：不要再交一次，也不要在本轮等待；结果随 #{old['id']} 交回。")
    return 0


