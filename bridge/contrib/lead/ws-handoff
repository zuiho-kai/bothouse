def kickoff_existing(path, task):
    """开工说明里列出这件活手里现成的东西（_existing.py：上一棒的交接和还在的文件、现成做法、定案），并写进交接
    「手里现成的（程序列出）」节。来源：用户 11-10「都做」（方案第 1 条「开工前程序列出这件活手里现成的东西」）。
    出错或没有可列的返回空串，不拦交活。"""
    rows = _existing.append_to(path, task)
    return ("\n".join(rows) + "\n") if rows else ""


PLAN_FIRST = "必须先出方案再动手的范围"
# 记忆论坛、规则类改动：用户定过要先给方案、批了再改（反思 11-06：记忆论坛过时测试没先给方案就改好合进主线，事后撤回）。
PLAN_FIRST_RE = re.compile(r"记忆论坛|overflow|规则|CLAUDE\.md|常驻做法|STANDING|handoff-rules|rule-candidates|hook|bash-guard", re.I)


def plan_first_items(text: str):
    """范围节里命中记忆论坛/规则类的「改：」行；用户原话或总目标命中而范围没细到行时返回整块一行。"""
    lines, lead = text.splitlines(), _handoff_rules.load().get("lead", "")
    sec = lambda n: [x for seg in _handoff_rules._sections(lines, n, lead) for x in seg[1:]]
    hits = [x.strip("-*> \t") for x in sec(PRODUCT_SECS[2]) if "改" in x and "不改" not in x and PLAN_FIRST_RE.search(x)]
    if hits:
        return hits
    if any(PLAN_FIRST_RE.search(x) for n in PRODUCT_SECS[:2] for x in sec(n)):
        return ["整块（用户原话或总目标涉及记忆论坛/规则类改动）"]
    return []


def append_plan_first(path):
    """给交接追加「必须先出方案再动手的范围」节（派活人手写了就不动）。出错只返回 False，不拦交活。"""
    try:
        text = Path(path).read_text(encoding="utf-8")
        if re.search(r"^#+\s*" + PLAN_FIRST, text, re.M):
            return False
        if not _handoff_rules.load()["flags"].get("plan_first"):  # 本机规则打开时才加
            return False
        items = plan_first_items(text)
        if not items:
            return False
        lines = [f"## {PLAN_FIRST}",
                 "（交活时程序附：记忆论坛、规则类改动。下面几项先写现象、根因证据、方案，用 ws-up --ask 交方案，"
                 "批了再改；方案没批前只读。用户原话里已写明这条改法的不用再问。）"] + [f"- {x}" for x in items]
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("" if text.endswith("\n") else "\n") + "\n" + "\n".join(lines) + "\n")
        return True
    except Exception:  # noqa: BLE001
        return False


SKELETON = "交回骨架"


def append_skeleton(path, nid):
    """给交接追加「交回骨架」节：桥 `report skeleton` 按任务板编号和「## 范围」的改项出的 [report] 填空稿
    （反思 11-04 改法 a：[report] 被退回涉及 6 个会话，缺首行 [report] 或漏交接范围项）。已有就不再加；
    桥太旧没有这个子命令或出任何错只返回 False，不拦交活。"""
    try:
        text = Path(path).read_text(encoding="utf-8")
        if f"## {SKELETON}" in text:
            return False
        r = subprocess.run([cc_bin(), "report", "skeleton", "--id", str(nid), "--notes", path],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0 or not r.stdout.startswith("[report]"):
            return False
        lines = [f"## {SKELETON}",
                 f"（交活时程序附：交回时照抄填空，每个「（待填」都换成实话；发前跑 {cc_bin()} report check --notes {path} <草稿文件>，"
                 "不通过不发。这一节不算范围。）",
                 "```", r.stdout.rstrip("\n"), "```"]
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("" if text.endswith("\n") else "\n") + "\n" + "\n".join(lines) + "\n")
        return True
    except Exception:  # noqa: BLE001
        return False


def timer_cmd(ws: str, path: str, task: str, nid="<任务板编号>", answer=None, project=None):
    """叫醒工作区会话。--handoff：这一轮是交过来的活，不是例行定时，桥照常自动开公开任务卡
    （core/public_progress_auto.go timerTurnUser）。不带 --inject-if-busy：工作区正有别的活在跑时这一轮排在后面，
    轮到时自己开一轮、开自己的卡；插进那一轮不会开卡（审稿 pr410 必须改 1，桥 ExecuteTimerJob 对 Handoff 也不插）。
    开工提示对照本机 ws-handoff timer_cmd：任务板编号、上报方式。--desc 带任务：桥把它当这一轮的任务名（谁在干啥、
    频道任务板，core/team.go teamNoteTurn → boardDescOf），不是把开工提示当任务名（#597 G36）。"""
    head = (f"你是工作区频道里的主角色，接着做一件等外部条件停下的活：{task}。{answer}\n"
            f"先读交接 {path}（之前的进度都在里面）。这块活在任务板是 #{nid}，接手后用 board update {nid} <状态> 更新，"
            if answer is not None and answer.startswith("到点重试") else
            f"你是工作区频道里的主角色，接着做一件提问后停下的活：{task}。用户答复了：{answer}\n"
            f"先读交接 {path}（之前的进度都在里面）。这块活在任务板是 #{nid}，接手后用 board update {nid} <状态> 更新，"
            if answer is not None else
            f"你是工作区频道里的主角色，从主频道接手一整块大活：{task}。"
            f"先读交接 {path}。这块活交活时已在任务板建好 #{nid}，接手后用 board update {nid} <状态> 更新，")
    prompt = (head +
              f"不要再 board add 这块活；本轮会自动开公开任务卡。接手后发五段式说明。" + KICKOFF + kickoff_maps(path, task) + "\n" +
              kickoff_existing(path, task) +
              f"先读交接里「{SOURCE}」的原始对话，再读总部判断那节：总部判断定做什么、为什么、做成什么样算好，照办；怎么做你定。"
              f"交接里的「{_QUOTE_SEC}」和「{_recall.SECTION}」是准绳；旧定案和用户原话冲突、或拿不准用户意思时，"
              f"先问聊天频道的主角色（ws-up --notes {path} \"<问题>\"，不带 --ask），不直接问用户；"
              f"主角色搜 wiki 和历史会话后代用户答，答不了才转用户。"
              f"有问题、要用户拍板用 ws-up --notes {path} \"<问题+选项+推荐>\" --ask，等聊天频道转回答复再做，"
              f"等的时候先做不受影响的部分；不在工作区里问用户。会缩小或改变用户原话范围的决定也先 --ask，纯技术细节自己定。"
              f"交接里有「{PLAN_FIRST}」节的，那几项先 ws-up --ask 交方案，批了再改，没批前只读。"
              f"只做交接里写成「改」的部分；用户原话里没有的设定、开关、参数不加，要加先 --ask。"
              f"做完交回：草稿文件第一行写 [report] #{nid} 背景：……，再起一行写做了什么，再一行写「要你做的：……」（只写要用户拍板或只有用户本人能做的事；你自己能验的先验完，不让用户替你核对，没有写「要你做的：没有」），再一行写「我加的：……」（用户原话里没有、你自己加的设定，没有写「我加的：无」）（这四段系统原样贴到聊天频道，每段最多两句，多的写进细节），之后的行是细节，贴在那条消息下的子话题（中途发的话不转）；"
              f"交回前照交接里「{SKELETON}」节填空（没有就跑 {cc_bin()} report skeleton --id {nid} --notes {path}），"
              f"把草稿写进文件跑 {cc_bin()} report check --notes {path} <草稿文件>，不通过改到通过，再跑 ws-up --notes {path} --report <草稿文件> 交回（回复里写的 [report] 桥不认）；"
              f"交回后桥自动把这件标完成、清空会话、放回工作区。"
              f"被外部条件卡住（没空卡、等 CI、等对方）做不下去时，先做不依赖它的部分，然后照常 ws-up --report 交回说做到哪，"
              f"细节里写一行「等外部：卡在什么」和一行「再看：<多久后，如 2h>」：桥放行、标等外部、放回工作区，到点另交工作区接着做，不要原地反复重试")
    key = ws if ":" in ws else f"discord:{ws}"
    return [cc_bin(), "timer", "add", "-p", project or _team.project(), "-s", key, "--delay", "1m", "--timeout-mins", "0",
            "--handoff", "--desc", f"工作区{'接回' if answer is not None else '接手'}：{task}", "--prompt", prompt]


def record_last(path: str, ws: str, task: str, chat: str, nid=None, project=None):
    """记最近一次交接（ws-forward 默认转给它），并按交接文件记来源聊天频道（ws-up 按它报回、ws-forward --notes 按它转）。"""
    try:
        last = json.loads(_team.LAST.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        last = {}
    tasks = last.get("tasks") if isinstance(last, dict) and isinstance(last.get("tasks"), dict) else {}
    project = project or _team.project()
    rec = {"channel": ws.split(":", 1)[-1], "chat": chat, "task": task, "board": [nid] if nid else [], "project": project}
    if ":" in ws:
        rec["ws_key"] = ws
    old = tasks.get(path)
    key = path
    if isinstance(old, dict) and str(old.get("channel") or "") != rec["channel"]:
        # 同一份交接交给另一个工作区：另记一条（ws-up/ws-forward 用 --notes <文件>@ws<id> 认），不覆盖前一条
        key, rec["file"] = f"{path}@ws{rec['channel']}", path
    if key in tasks:
        base = f"{path}@ws{rec['channel']}@task{nid or len(tasks) + 1}"
        key = base
        serial = 1
        while key in tasks:
            key = f"{base}-{serial}"
            serial += 1
        rec["file"] = path
    tasks[key] = rec
    _team.LAST.write_text(json.dumps({"file": path, "channel": ws, "task": task, "chat": chat, "project": project, "tasks": tasks},
                                     ensure_ascii=False), encoding="utf-8")


@contextlib.contextmanager
def _queue():
    """排队表（加锁读改写）：yield 列表，退出时写回。"""
    import filelock  # ../gate/filelock.py（上面已把 gate 目录放进 sys.path）
    QUEUE.parent.mkdir(parents=True, exist_ok=True)
    with open(str(QUEUE) + ".lock", "w") as lock:
        filelock.lock(lock)
        try:
            q = json.loads(QUEUE.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            q = []
        q = [x for x in q if isinstance(x, dict) and x.get("nid")] if isinstance(q, list) else []
        yield q
        QUEUE.write_text(json.dumps(q, ensure_ascii=False), encoding="utf-8")


def _lead_name(project):
    return _team.name_of(project) if project else "主角色"


def arm_drift(nid):
    """挂看门查跑偏（drift-check，每 10 分钟拿原话和旧定案对照工作区发言）；挂不上只警告，不拦交活。"""
    try:
        r = subprocess.run([str(Path(__file__).resolve().parent / "drift-check"), "--arm", str(nid)],
                           capture_output=True, text=True, timeout=60)
        if r.stderr.strip():
            print(r.stderr.strip(), file=sys.stderr)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"ws-handoff: #{nid} 查跑偏没挂上（{e}）", file=sys.stderr)


GUARD = None  # --guard 给的时长；None 用 board.GUARD_DELAY


def start(path, task, chat, nid, project, answer=None):
    """挑空工作区、绑任务板 #nid、叫醒；没空的返回 False（调用方排队）。"""
    previous = next((i for i in board.items() if i["id"] == nid), {})
    picked = pick_pool(chat, task, nid, previous.get("ws_was", "") if previous.get("review_rejected") else "")
    if picked is None:
        return False
    ws, name, parent = picked
    board.update(nid, "已交接", who=f"{name}{_lead_name(project)}")
    board.rebind(nid, ws)
    append_skeleton(path, nid)
    r = subprocess.run(timer_cmd(ws, path, task, nid, answer, project), capture_output=True, text=True)
    if r.returncode != 0:
        # 没叫醒：工作区放回、任务板整条退回改前（#1492 L3：原先只放工作区，板停在「已交接」绑着那个工作区）
        parked = board._park_once(cc_bin(), ws, parent)
        back = board.restore(previous) if previous else False
        sys.exit(f"ws-handoff: #{nid} 叫醒 {name} 失败：{r.stderr.strip() or r.stdout.strip()}；"
                 f"任务板{'已退回改前（' + str(previous.get('status') or '') + '）' if back else '没退回（板上找不到这条，原样留着）'}，"
                 f"工作区{'已放回' if parked else '没放回（桥没放或本就不归这件，见上面的报错）'}")
    record_last(path, ws, task, chat, nid, project)
    board.arm_guard(nid, GUARD)
    arm_drift(nid)
    print(f"ws-handoff: #{nid} 交给 {name}", file=sys.stderr)
    return True


def drain():
    """排队的活先排先接，接到没有空工作区为止（桥放回工作区后调，core/team_workspace_one.go drainTeamWorkspaceQueue）。"""
    with _queue() as q:
        index = 0
        while index < len(q):
            x = q[index]
            it = next((i for i in board.items() if i["id"] == x["nid"]), None)
            if it is None:
                q.pop(index)
                continue
            if it.get("paused") or it.get("backlog"):
                index += 1  # 用户 2026-11-02：暂停保留原队列位置，恢复后继续接；待办同样等到 resume。
                continue
            try:
                ok = start(x["path"], x["task"], x.get("lead") or x["chat"], x["nid"], x.get("project"), x.get("answer"))
            except SystemExit as e:
                # 一件接不上（叫醒失败、claim 被拒）只留在原位，不挡后面的活（本机 11-08：一件 claim 失败退出，整队卡 5 天）
                print(f"ws-handoff: 排队的 #{x['nid']} 这次没接上，留在队里：{e}", file=sys.stderr)
                index += 1
                continue
            if not ok:
                break
            q.pop(index)


def resume_answered(nid, answer):
    """等你的活收到答复：恢复条目、答复写进交接，找空工作区接着做；没有就排队（core resumeAskedTask 调）。"""
    it = next((i for i in board.items() if i["id"] == nid), None)
    if it is None or not it.get("chat") or not os.path.isfile(it.get("where") or ""):
        sys.exit(f"ws-handoff: #{nid} 不是 ws-handoff 交的活，没法接回")
    if it.get("rework_cap") and it.get("paused"):
        # 返工上限（board.reject 第二次退回）：不再续做，等用户定；用户定了接着改，按用户的标准另交一次。
        sys.exit(f"ws-handoff: #{nid} {board.REWORK_CAP_WHY}，不再续做。先问用户（聊天频道已发 [ask]）；"
                 "用户定了接着改，把用户定的标准写进交接，用 ws-handoff 另交一次")
    source = ("验收退回" if it.get("review_rejected") else
              "到点重试" if (it.get("pause_why") or "").startswith(board.WAIT_EXT) else "用户答复")
    board.append_forward(it["where"], f"{board._now()} {source}（#{nid}）：{answer}")
    _recall.append_to(it["where"])  # 改动前交出的活没有旧定案节，接回时补上（已有就跳过，上次没搜成就重搜）
    project = os.environ.get("CC_PROJECT", "")
    in_queue = False
    with _queue() as q:
        for entry in q:
            if entry["nid"] == nid:
                entry["answer"] = answer
                entry["project"] = project
                in_queue = True
    board.resume(nid)
    if in_queue:
        return drain()  # 用户 2026-11-02：答复续办也保留原位置，不重复派发。
    with _queue() as q:
        try:
            ok = start(it["where"], it["what"], it["chat"], nid, project, answer)
        except SystemExit as e:
            # 叫醒失败：start 已把板退回到续做前一刻；再退回接回前（暂停 / 待验收退回），答复留在交接里注明没送到，
            # 下次接回时照常再走（#1492 L3）
            board.restore(it)
            board.append_forward(it["where"], f"{board._now()} ⚠️ 上面这条{source}没送到工作区（叫醒失败），#{nid} 已退回接回前的状态。")
            sys.exit(f"{e.code}；#{nid} 已退回接回前（{it.get('status') or ''}），答复没送到")
        if not ok:
            board.update(nid, "排队")
            q.append({"nid": nid, "path": it["where"], "task": it["what"], "chat": it["chat"], "project": project, "answer": answer})
            print(f"ws-handoff: #{nid} 工作区都占着，排队", file=sys.stderr)


def main(argv):
    if argv[:1] == ["--drain"]:
        return drain()
    if argv[:1] == ["--resume"] and len(argv) == 3:
        return resume_answered(int(argv[1].lstrip("#")), argv[2])
    global GUARD
    if "--guard" in argv:
        k = argv.index("--guard")
        GUARD = argv[k + 1] if k + 1 < len(argv) else None
        if not GUARD or not re.fullmatch(r"(\d+h)?(\d+m)?", GUARD):
            sys.exit("ws-handoff: --guard 要写时长，如 30m、90m、2h")
        argv = argv[:k] + argv[k + 2:]
    confirmed = "--confirmed" in argv
    force = "--force" in argv
    argv = [a for a in argv if a not in ("--confirmed", "--force")]
    short_name = None
    if "--short" in argv:
        k = argv.index("--short")
        short_name = argv[k + 1] if k + 1 < len(argv) else None
        argv = argv[:k] + argv[k + 2:]
    if len(argv) != 2 or not argv[1].strip():
        sys.exit(USAGE)
    # 短名由交活人写，不再从任务句截前十字（用户 10-30 认可的置顶表方案：没写就退回让写）。
    short_name = (short_name or "").strip()
    given_short = short_name  # 交活人自己写的短名才查同名撞活；从任务句截的不算（截出来同名的多）
    if not short_name and not _handoff_rules.load()["flags"].get("require_short"):
        short_name = board.short_of(argv[1])[:board.SHORT_RUNES]
    if not short_name or len(short_name) > board.SHORT_RUNES:
        sys.exit(f"ws-handoff: 要写 --short 短名（≤{board.SHORT_RUNES} 字，置顶任务表上显示的名字，比如 --short 任务表改版）")
    path, task = os.path.abspath(os.path.expanduser(argv[0])), argv[1]
    if not os.path.isfile(path):
        sys.exit(f"ws-handoff: 交接文件不存在 {path}\n{USAGE}")
    with open(path, encoding="utf-8") as fh:
        notes = fh.read()
    # 先说一声在交：后面搜旧定案、挑工作区要几十秒；Codex 的命令等几秒就先返回，没这行它会以为桥没响应，
    # 跟用户说「工作区还没回执、不确定成没成」（agentm 11-09 #25，那次交活跑了 47 秒）
    print("ws-handoff: 交活中（查交接、搜旧定案、挑工作区、上任务板，通常半分钟到两分钟）；命令没退出就是还在交，"
          "等它退出再看最后几行，不要先跟用户说没成功或工作区不确定", file=sys.stderr, flush=True)
    try:
        err = check_notes(notes)
    except RuntimeError as e:  # 规则文件读不到或写坏：报错不放行
        sys.exit(f"ws-handoff: {e}")
    if err:
        sys.exit(f"ws-handoff: {err}")
    err, own = intent_gate(notes)
    if err:
        sys.exit(f"ws-handoff: {err}")
    err = object_gate(notes)
    if err:
        sys.exit(f"ws-handoff: {err}")
    err = added_gate(notes)
    if err:
        sys.exit(f"ws-handoff: {err}")
    gate = own_gate(notes, confirmed)
    if gate:
        sys.exit(f"ws-handoff: {gate}")
    dup = None if force else live_dup(path)
    if dup:
        sys.exit(f"ws-handoff: {dup_error(dup)}")
    hits = [] if force else live_overlap(path, given_short, notes)
    if hits:
        sys.exit(f"ws-handoff: {overlap_error(hits)}")
    if own:  # 几道检查都过了才记，退回重交不留半截
        append_own(path, own)
        print(f"ws-handoff: 有一处两种读法不是方向也不是花钱，按交接写的放行，已附「{OWN}」", file=sys.stderr)
    # 交活前按原话和总目标搜旧定案，追加成交接的「旧定案（程序搜出）」节；搜不到写「没搜到」，小模型没调成写「没搜成（原因）」
    # 并照实打印（接回时重搜），都不拦交活
    block = _recall.append_to(path)
    if block and _recall.FAIL_LINE in block:
        why = block.split(_recall.FAIL_LINE, 1)[1].strip().splitlines()[0]
        print(f"ws-handoff: {_recall.FAIL_LINE}{why}，交接里照实写了，接回时重搜", file=sys.stderr)
    elif block:
        print(f"ws-handoff: 已附「{_recall.SECTION}」", file=sys.stderr)
    chat = notes_chat(notes, os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", ""))
    if append_source(path, chat):
        print(f"ws-handoff: 已附「{SOURCE}」", file=sys.stderr)
    if append_plan_first(path):
        print(f"ws-handoff: 已附「{PLAN_FIRST}」", file=sys.stderr)
    parent = ""  # 走共享池时交接记在桥里的聊天频道；叫醒失败按它撤掉刚 claim 的那件
    nid = None
    if _team.workspace():
        ws, name = fixed_channel(chat), "工作区"
    elif ":" not in chat:
        sys.exit("ws-handoff: 没配工作区频道（WS_CHANNEL / 团队文件 \"workspace\"），也不在桥的会话里（CC_SESSION_KEY），没法从池里挑工作区")
    else:
        drain()  # 先排先接：池里有空位时先接队里的，新活不插队
        # 先上板拿编号再 claim：桥按编号记这件活的状态（#699），claim 不带编号看门就只能猜是哪一行
        nid = board.add(task, path, "排队", "待接手", chat=chat, short_name=short_name)
        try:
            picked = pick_pool(chat, task, nid)
        except SystemExit:
            board.unadd(nid)  # 没交出去：撤掉刚上的板，不留一条没人做的排队
            raise
        if picked is None:
            with _queue() as q:
                # lead：入队时就记下交活的聊天频道（工作区里交的活此时 owner 最准；drain 时工作区可能已空）
                q.append({"nid": nid, "path": path, "task": task, "chat": chat, "lead": lead_chat(chat),
                          "project": os.environ.get("CC_PROJECT", "")})
            print(f"ws-handoff: 任务板 #{nid}", file=sys.stderr)
            print(f"queued #{nid}")
            print(f"{MAX_WS} 个工作区都在做活，#{nid} 已排队；有工作区空出来桥会自动接上。跟用户说一句排队了，本轮到此结束。")
            return
        ws, name, parent = picked
    # 先上任务板、绑这个工作区（编号要写进开工提示，同本机 ws-handoff 先 board_add 再叫醒）：
    # 放回只看绑定的条目（board pause / 把「谁」改走），刚交的活不会被当成没人做
    key = ws if ":" in ws else f"discord:{ws}"
    lead_name = _team.name_of(os.environ["CC_PROJECT"]) if os.environ.get("CC_PROJECT") else "主角色"
    if nid is None:  # 固定工作区频道：不经桥的池子，不 claim
        nid = board.add(task, path, "已交接", f"{name}{lead_name}", ws=key, chat=chat, short_name=short_name)
    else:
        board.update(nid, "已交接", who=f"{name}{lead_name}")
        board.rebind(nid, key, chat=chat)
    append_skeleton(path, nid)
    r = subprocess.run(timer_cmd(ws, path, task, nid), capture_output=True, text=True)
    if r.returncode != 0:
        # 叫醒失败：撤掉刚上的板和刚 claim 的那一件交接（只放这一件，同 board pause 的 park），不留给看门判无进展
        # _park_once 返回 None（桥没响应、拒绝或出错）时交接还记在桥里，不能说撤掉了（审稿 pr410 必须改 2）
        board.unadd(nid)
        why = r.stderr.strip() or r.stdout.strip()
        if not parent:
            sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid}）：{why}")
        buf = io.StringIO()
        with contextlib.redirect_stderr(buf):
            parked = board._park_once(cc_bin(), key, parent)
        if parked is None:
            m = re.search(r"工作区没放回（(.*)）", buf.getvalue(), re.S)
            reason = (m.group(1) if m else buf.getvalue()).strip() or "workspace park 没成功"
            sys.exit(f"ws-handoff: timer add 失败：{why}\n"
                     f"任务板已撤，交接没放回（{reason}），桥恢复后跑 workspace park --session-key {key} --chat {parent}")
        sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid} 和这件交接）：{why}")
    record_last(path, ws, task, chat, nid)
    guard = board.arm_guard(nid, GUARD)
    arm_drift(nid)
    print(f"ws-handoff: 任务板 #{nid}" + (f"，兜底定时器 {guard}（{GUARD or board.GUARD_DELAY}）" if guard else ""), file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id
    # 交出后主角色就收手：G27 实测里没有这句时，主角色在本轮 sleep 50 秒查任务板等工作区，聊天频道被占 8–11 分钟
    print(DONE.format(name=name))


# 交活放进独立会话里跑，前台只跟着看：调用方（Codex 的 exec_command 等几秒就先返回、回合结束桥关掉 agent 进程；
# Claude 的 Bash 两分钟超时）把前台杀掉时，交活照样跑完，没交成就在本频道补一句，不留「嘴上交了、板上没有」。
# 来源：用户 2026-11-12「修复隔壁问题，gpt老是丢失任务」；agentm 11-12 03:52Z 那轮 ws-handoff 跑到第 24 秒，
# 回合结束关进程（turn ended: closing agent process）连带杀掉，任务板没有这件，模型已跟用户说「已提交工作区」。
WORKER = "WS_HANDOFF_WORKER"  # 有值＝自己就是后台那份，值是前台进程号
RUNS_DIR = _team.SETUP / "handoff-runs"


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _tell_chat(text: str):
    """前台已被杀、交活又没成：在交活的聊天频道补一句（发不出就只留在回执文件里）。"""
    chat = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    proj = os.environ.get("CC_PROJECT", "")
    if not chat or not proj:
        return
    try:
        subprocess.run([cc_bin(), "send", "-p", proj, "-s", chat, "--message", text.replace("<@", "<\u200b@")],
                       capture_output=True, text=True, timeout=30)
    except Exception as e:  # noqa: BLE001  只是补报，失败写进回执
        print(f"ws-handoff: 补报没发出去（{e}）", file=sys.stderr)


def worker(argv):
    parent = int(os.environ.get(WORKER) or 0)
    rc, why = 0, ""
    try:
        main(argv)
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        why = "" if isinstance(e.code, int) or e.code is None else str(e.code)
        if why:
            print(why, file=sys.stderr)
    except BaseException as e:  # noqa: BLE001
        rc, why = 1, f"{type(e).__name__}: {e}"
        print(why, file=sys.stderr)
    finally:
        sys.stdout.flush(); sys.stderr.flush()
    if rc and parent and not _alive(parent):
        task = (f"#{argv[1].lstrip('#')} 续办" if argv[:1] == ["--resume"] and len(argv) > 1
                else argv[1] if len(argv) > 1 else "")
        _tell_chat(f"⚠️ 刚才说交给工作区的「{task}」没交出去（交活命令在回合结束后才报错）：{why.strip()[:600] or f'exit {rc}'}\n"
                   "这件活现在不在任务板上，要重新交。")
    os._exit(rc)


def run(argv):
    # --resume 也有模型直接调（续办暂停的活、ws-forward 转），同样会被回合结束杀掉，一起放后台；--drain 只由桥在后台调
    if os.environ.get(WORKER) or os.environ.get("WS_HANDOFF_INLINE") or argv[:1] == ["--drain"]:
        return worker(argv) if os.environ.get(WORKER) else main(argv)
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    stem = RUNS_DIR / f"{datetime.now().strftime('%m%d-%H%M%S')}-{os.getpid()}"
    out, err = stem.with_suffix(".out"), stem.with_suffix(".err")
    with open(out, "w") as fo, open(err, "w") as fe:
        p = subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), *argv], stdin=subprocess.DEVNULL,
                             stdout=fo, stderr=fe, start_new_session=True,
                             env=dict(os.environ, **{WORKER: str(os.getpid())}))
    print(f"ws-handoff: 回执 {err}；本命令被打断也会在后台交完，没交成会在本频道补一句。"
          "看到最后一行「任务板 #N」才算交出", file=sys.stderr, flush=True)
    pos = 0
    while True:
        done = p.poll() is not None
        with open(err, encoding="utf-8", errors="replace") as fh:
            fh.seek(pos)
            chunk = fh.read()
            pos = fh.tell()
        if chunk:
            sys.stderr.write(chunk)
            sys.stderr.flush()
        if done:
            break
        time.sleep(0.2)
    with open(out, encoding="utf-8", errors="replace") as fh:
        sys.stdout.write(fh.read())
    sys.stdout.flush()
    sys.exit(p.returncode)


if __name__ == "__main__":
    run(sys.argv[1:])
