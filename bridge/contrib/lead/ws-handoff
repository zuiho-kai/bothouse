RUNS = Path.home() / ".bothouse" / "runs"
def live_overlap(path: str, short_name: str, notes: str, runs: Path = RUNS):
    """撞活说明（一行一处）；没有返回空列表。同一份交接文件由 live_dup 管，这里跳过。"""
    me, hits = _real(path), []
    for it in board.items():
        if it.get("paused") or it.get("backlog") or not it.get("where") or _real(it["where"]) == me:
            continue
        who = it.get("who") or it.get("ws") or "—"
        if short_name and board.short(it) == short_name:
            hits.append(f"#{it['id']} 同名「{short_name}」（{who}，状态：{it.get('status') or '—'}，交接 {it['where']}）")
    return hits


def overlap_error(hits) -> str:
