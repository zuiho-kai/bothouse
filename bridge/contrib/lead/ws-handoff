# 「凭旧印象说事」见全局 CLAUDE.md「说事实」）。不按话题分，任何活都适用。
OBJ = "对象核对"
OBJ_EVID = re.compile(r"\b[0-9a-f]{7,40}\b|[~/][\w./-]+|https?://|merged|open|closed|#\d+|!\d+|git |curl |board |grep |ls ", re.I)
OBJ_EXAMPLE = ("## 对象核对\n- 「我们已经合的全双工」→ develop 上 video_duplex 已合提交 45e98de57 等（git log gitcode/develop）\n"
               "- 「!9544」→ merged 到 releases/0.2.9.beta2，提交 e19454331 已随 a814ed8b0 回流 develop")


def object_gate(text: str):
    """本机规则 flags.object_gate 打开时查（handoff-rules.local.json）；产品默认不查。"""
    if not _handoff_rules.load()["flags"].get("object_gate"):
        return None
    lines, lead = text.splitlines(), _handoff_rules.load().get("lead", "")
    obj = [x for seg in _handoff_rules._sections(lines, OBJ, lead) for x in seg if x.strip("-*> \t") and not x.lstrip().startswith("#")]
    bad = [x for x in obj if not OBJ_EVID.search(x)]
    if obj and not bad:
        return None
    why = "缺「## " + OBJ + "」节" if not obj else "这几行没带现场证据：" + "；".join(x.strip() for x in bad[:3])
    return (why + "。交出前把用户原话里的每个对象对着现场核一遍（git log、PR 接口、看文件、看任务板），一条一行写成"
            "「原话词 → 实际是什么」，带提交号、路径、链接或状态。示例：\n" + OBJ_EXAMPLE)


def added_gate(text: str):
    """交接比用户原话多出来的设定（换角色、加梗、加受众、加产品露出、加审核步骤、偏离参考）：小模型逐行对照
    总目标、范围两节和原话，有就拦，要求删掉或移进「## 我加的（原话没有）」写理由。判断器出错放行（_added_judge.py）。
    来源：#1223 追加项，用户 11-08 03:2x「你老是自己想自己的……这种自己给自己加狗狗屎思想」。"""
    if not _handoff_rules.load()["flags"].get("added_gate"):  # 本机规则打开时才查（要调模型）
        return None
    import _added_judge
    r = _added_judge.judge(text)
    if r["error"]:
        print(f"ws-handoff: 「多出来的设定」检查没跑成（{r['error']}），放行", file=sys.stderr)
    return _added_judge.message(r["added"]) if r["added"] else None


# 三类活（出图、改用户文档、定方向）派出去前，派活人自己定的决定单列给用户看一眼：交接里写一行「类别：出图」，
# 加「## 派活人自己定的」节（每条一行，没有写「无」）；不带 --confirmed 时只打出清单不交出，用户看过再带 --confirmed 重跑。
# 来源：10-30 第三轮重放，只有「派活人单列自己定的主意给用户看」拦住了返工（用户「可以试一下」）。其他类的活不受影响。
GATED = ("出图", "改用户文档", "定方向")
OWN = "派活人自己定的"
OWN_EXAMPLE = "类别：出图\n## 派活人自己定的\n- 画风照上次头像，不换\n- 尺寸 1024×1024"


def gated_kind(text: str):
    for l in text.splitlines():
        m = re.match(r"类别\s*[:：]\s*(.+)", l.lstrip("#-*> \t"))
        if m:
            hit = [k for k in GATED if k in m.group(1)]
            if hit:
                return hit[0]
    return None


def own_decisions(text: str):
    """「派活人自己定的」节里的每一行（去掉 -、* 等前缀，空行不算）；没有这一节返回 None。"""
    lines, out, found = text.splitlines(), [], False
    for i, l in enumerate(lines):
        if l.lstrip().startswith("#") and OWN in l:
            found = True
            for x in lines[i + 1:]:
                if x.lstrip().startswith("#"):
                    break
                if x.strip("-*> \t"):
                    out.append(x.strip("-*> \t"))
    return out if found else None


def own_gate(text: str, confirmed: bool):
    """三类活没过确认时返回要打给派活人的话（不交出），否则 None。"""
    kind = gated_kind(text)
    if not kind:
        return None
    own = own_decisions(text)
    if not own:
        return (f"这件是「{kind}」类，交接要有「{OWN}」节：用户原话里没有、你自己定的决定每条一行，没有写「无」。示例：\n"
                f"{OWN_EXAMPLE}")
    if confirmed:
        return None
    return (f"这件是「{kind}」类，还没交出。先把下面这份清单原样贴给用户，用户回过（没拦或改完交接）再加 --confirmed 重跑：\n"
            f"{OWN}：\n" + "\n".join(f"- {x}" for x in own))


# 防重复派：同一份交接文件在任务板上已有进行中（board.jsonl 里、没暂停；排队也算）的条目就拒绝再交，带 --force 放行。
