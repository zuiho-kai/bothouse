def check_notes(text: str, task: str = ""):
    """交接文件不合格时返回报错文字（一次列出所有问题），合格返回 None。只查规则文件里的事实档（handoff-rules.json 加本机叠加的
    tier=fact：写了的路径要真存在、照参考做的活要有原件节、不引用 /tmp 等，_handoff_rules.check_tiered）。
    查主角色写没写目标、范围、根因、CLI 的格式档 11-24 拿掉：R-raw 定了主角色不写规格，没东西可查。task 不再用，留着签名。"""
    errs = _handoff_rules.check_tiered(text, fmt=False)
    if not errs:
        return None
    if len(errs) == 1:
        return errs[0]
    return f"交接有 {len(errs)} 处要补，一次改完再交：\n" + "\n".join(f"{i}. {e}" for i, e in enumerate(errs, 1))


# 防重复派：同一份交接文件在任务板上已有进行中（board.jsonl 里、没暂停；排队也算）的条目就拒绝再交，带 --force 放行。
# 路径按 realpath 比，忽略 record_last 加的 @ws…@task… 后缀。来源：10-31 凌晨重复派同一件，两个会话同改一个目录约 15 分钟
# （首次 10-30 #780），复盘 role-household-puck185-night-retro-1031.md 第 6 条。
def _real(where: str) -> str:
    return os.path.realpath(os.path.expanduser(re.sub(r"@ws.*$", "", str(where or ""))))


def live_dup(path: str):
    """同一份交接文件进行中的任务板条目（没有返回 None）。"""
    me = _real(path)
    return next((i for i in board.items() if not i.get("paused") and not i.get("backlog") and i.get("where") and _real(i["where"]) == me), None)


