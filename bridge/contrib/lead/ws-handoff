FOLD_NOTE = "（交活时程序归并：下面几节是主角色自己写的理解，不是用户说的；和用户原话冲突时信原话，做什么、范围多大照原话和现场自己定）"


def _blocks(text):
    """按二级标题切块 [(标题, [行])]；第一块（标题 None）是首个二级标题之前的内容。代码围栏里的 # 不算标题。"""
    out, fenced = [(None, [])], False
    for ln in text.splitlines():
        if _FENCE.match(ln):
            fenced = not fenced
        m = None if fenced else re.match(r"^##\s+(.*\S)\s*$", ln)
        if m:
            out.append((m.group(1), [ln]))
        else:
            out[-1][1].append(ln)
    return out


def _lead_lines(lines, deeper=True):
    """主角色写的一节：deeper 时每个标题降一级；以范围节名（PRODUCT_SECS[2]）开头的标题前面加「主角色写的」
    （桥只拿以这个节名开头的节出交回骨架、查漏项，core/team/exit_rules.go scopeChangeItems）。围栏里的不动。"""
    out, fenced = [], False
    for ln in lines:
        if _FENCE.match(ln):
            fenced = not fenced
        m = None if fenced else re.match(r"^(#{1,6})\s+(.*)$", ln)
        if m:
            title = m.group(2)
            if title.startswith(PRODUCT_SECS[2]):  # 节名从 handoff-rules.json 读，不写死（test_handoff_rules）
                title = "主角色写的" + title
            ln = "#" * min(len(m.group(1)) + (1 if deeper else 0), 6) + " " + title
        out.append(ln)
    return out


def fold_lead_notes(path):
    """交接里主角色自己写的节（总目标、范围、做法、词义……）归到「主角色的话（只作参考）」一节下面，各降一级；
    排成：用户原话、原话出处、主角色的话、程序附的其余节。改了返回 True；重复跑结果不变；出任何错返回 False，不拦交活。
    来源：用户 11-21「你不要指定说做什么，把我们原文给他，让他自己判断」；11-24 批「我真想说点什么，只能放进
    『主角色的话，只作参考』那一节」。规则仍要后端是 DS 类的主角色写总目标、范围（handoff-rules.json），写了也归到这里。"""
    try:
        text = Path(path).read_text(encoding="utf-8")
        blocks = _blocks(text)
        quote, src, said, lead, prog, had = [], [], [], [], [], False
        for title, lines in blocks[1:]:
            if title.startswith(_source.LEAD_SAYS):
                had = True
                said.append(_lead_lines(lines[1:], deeper=False))
            elif title.startswith(SOURCE):
                src.append(lines)
            elif any(n in title for n in _existing.PROGRAM_SECS):
                prog.append(lines)
            elif _QUOTE_SEC in title:
                quote.append(lines)
            else:
                lead.append(_lead_lines(lines))
        mine = []
        if had or lead:
            mine = [[f"## {_source.LEAD_SAYS}"]] + ([] if had else [[FOLD_NOTE]]) + said + lead
        parts = ["\n".join(b).strip("\n") for b in [blocks[0][1]] + quote + src]
        parts.append("\n\n".join(x for x in ("\n".join(b).strip("\n") for b in mine) if x))
        parts += ["\n".join(b).strip("\n") for b in prog]
        new = "\n\n".join(x for x in parts if x.strip()) + "\n"
        if new == text:
            return False
        Path(path).write_text(new, encoding="utf-8")
        return True
    except Exception:  # noqa: BLE001
        return False


