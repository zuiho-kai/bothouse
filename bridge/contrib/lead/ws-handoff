    return f"交接有 {len(errs)} 处要补，一次改完再交：\n" + "\n".join(f"{i}. {e}" for i, e in enumerate(errs, 1))


def intent_gate(text: str):
    """交接对照产品意图卡，由小模型判断（../hooks/intent_judge.py，发问检查用同一个）：交接里留给用户定的事按用户定过的话
    能推出来就退回给出答案；冲突必须有逐字用户原话；同主题本轮新话优先于旧定案。
    有两种读法（ask）时只有方向和花钱两类退回让问用户；别的由主角色自己定：放行，并返回一行记进交接（append_own）。
    真是方向、超时出错、找不到判断器都放行。返回（退回文字或 None，要记进交接的那行或 None）。
    来源：用户 2026-10-31「我不想什么事情都要我说，你自己思考」「有没有更好的办法，更智能的办法」（#827）；
    2026-11-11「为什么还要我回复，你让我决定的，不是跟你理解然后去做的是一样的吗」（#1437，同一份交接被 ask 连拦三次）。"""
    here = Path(__file__).resolve().parent
    for d in (here.parent / "hooks", here.parent.parent / "hooks"):  # 仓库 contrib/hooks；安装后 ~/.bothouse/hooks
        if (d / "intent_judge.py").is_file():
            break
    else:
        return None, None
    sys.path.insert(0, str(d))
    import intent_judge  # noqa: E402
    r = intent_judge.judge(text, kind="handoff")
    if r["verdict"] == "self":
        return (f"交接里留给用户定的「{r['question']}」按用户定过的话能推出来：{r['answer']}（{r['basis'].rstrip('。')}）。"
                "把这个答案写进交接，自己定，再交。判断器漏了事实就在交接里写明漏了什么再交。"), None
    if r["verdict"] == "conflict":
        return (f"交接里的做法「{r['question']}」和用户原话冲突：{r['basis'].rstrip('。')}。"
                f"请先核对两种读法：交接当前写法「{r['answer']}」；按引用原话的另一种读法。先问用户确认，把用户原话补进交接再交。"), None
    if r["verdict"] == "ask":
        if intent_judge.needs_user(r):
            what = "换方向" if r["kind"] == "direction" else "花钱"
            return (f"交接里的做法「{r['question']}」有两种读法，而且是{what}的事：{r['basis'].rstrip('。')}。"
                    "先问用户确认，把用户确认的原话写进交接再交；不要自行选择或改写成其中一种。"), None
        return None, f"这处主角色自己定了：{r['question'].rstrip('。')}（检查看出两种读法：{r['basis'].rstrip('。')}。不是方向也不是花钱，照交接写的做）"
    return None, None


OWN = "主角色自己定的（程序附）"


def append_own(path, line):
    """把 intent_gate 放行时的那一行记进交接的「主角色自己定的（程序附）」节：工作区看得到这处有过两种读法、主角色选了哪种。
    重交时整节换新，不叠加。"""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    text = re.sub(rf"(?ms)^## {re.escape(OWN)}\n.*?(?=^## |\Z)", "", text).rstrip("\n")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(f"{text}\n\n## {OWN}\n- {line}\n")


# 产品活（用户原话、总目标、范围提到产品、bothouse、做成产品能力）的范围节要写覆盖哪些 CLI：点名 Claude Code 以外的
# CLI（Codex、Gemini、grok 等）或写「所有 CLI」，跟 CLI 无关的写「CLI：不涉及」；没写就退回。来源：任务 #875，
# 「产品能力只做 Claude Code」同类错第 3 次（用户 10-30、11-01 两次纠正，要求通用化）。
PRODUCT_RE = re.compile(r"产品|bothouse", re.I)
PRODUCT_SECS = tuple(next(c for c in _handoff_rules.load(_handoff_rules.RULES, os.devnull)["checks"] if c["id"] == "sections")["names"])  # 产品默认三节
CLI_RE = re.compile(r"(所有|全部|各个?|每个)\s*CLI|CLI\s*[:：]\s*不涉及|Codex|Gemini|grok|Kimi|Cursor|iflow|DSH|OpenCode|Qwen|agy", re.I)
CLI_EXAMPLE = "## 范围\n- 改：…\n- 不改：…\n- CLI：所有 CLI（Claude Code、Codex、Gemini、grok 等）"


def generic_gate(text: str):
    """产品活的范围节没写覆盖哪些 CLI 时返回报错文字，否则 None。"""
    lines, lead = text.splitlines(), _handoff_rules.load().get("lead", "")
    sec = lambda n: [x for seg in _handoff_rules._sections(lines, n, lead) for x in seg]
    if not any(PRODUCT_RE.search(x) for n in PRODUCT_SECS for x in sec(n)):
        return None
    if any(CLI_RE.search(x) for x in sec(PRODUCT_SECS[-1])):
        return None
    return ("这件是产品活（交接提到产品/bothouse），范围节要写覆盖哪些 CLI：点名 Claude Code 以外的 CLI（Codex、Gemini、grok 等）"
            "或写「所有 CLI」；只能做部分 CLI 的，写明其它 CLI 做不了的来源；跟 CLI 无关写「CLI：不涉及」。示例：\n" + CLI_EXAMPLE)


