def intent_gate(text: str):
    """交接对照产品意图卡，由小模型判断（../hooks/intent_judge.py，发问检查用同一个）：交接里留给用户定的事按用户定过的话
    能推出来，或做法和用户定过的冲突，就退回并给出答案；真是方向、超时出错、找不到判断器都放行。
    来源：用户 2026-10-31「我不想什么事情都要我说，你自己思考」「有没有更好的办法，更智能的办法」（#827）。"""
    here = Path(__file__).resolve().parent
    for d in (here.parent / "hooks", here.parent.parent / "hooks"):  # 仓库 contrib/hooks；安装后 ~/.bothouse/hooks
        if (d / "intent_judge.py").is_file():
            break
    else:
        return None
    sys.path.insert(0, str(d))
    import intent_judge  # noqa: E402
    r = intent_judge.judge(text, kind="handoff")
    if r["verdict"] == "self":
        return (f"交接里留给用户定的「{r['question']}」按用户定过的话能推出来：{r['answer']}（{r['basis'].rstrip('。')}）。"
                "把这个答案写进交接，自己定，再交。判断器漏了事实就在交接里写明漏了什么再交。")
    if r["verdict"] == "conflict":
        return (f"交接里的做法「{r['question']}」和用户定过的冲突：{r['basis'].rstrip('。')}。合定案的做法：{r['answer']}。"
                "按定案改了再交；确要推翻定案，先问用户，把用户确认的原话写进交接再交。")
    return None


# 产品活（用户原话/总目标/范围提到产品、bothouse、做成产品能力）的「范围」要写覆盖哪些 CLI：点名 Claude Code 以外的
# CLI（Codex、Gemini、grok 等）或写「所有 CLI」，跟 CLI 无关的写「CLI：不涉及」；没写就退回。来源：任务 #875，
# 「产品能力只做 Claude Code」同类错第 3 次（用户 10-30、11-01 两次纠正，要求通用化）。
PRODUCT_RE = re.compile(r"产品|bothouse", re.I)
PRODUCT_SECS = ("用户原话", "总目标", "范围")
CLI_RE = re.compile(r"(所有|全部|各个?|每个)\s*CLI|CLI\s*[:：]\s*不涉及|Codex|Gemini|grok|Kimi|Cursor|iflow|DSH|OpenCode|Qwen|agy", re.I)
CLI_EXAMPLE = "## 范围\n- 改：…\n- 不改：…\n- CLI：所有 CLI（Claude Code、Codex、Gemini、grok 等）"


def generic_gate(text: str):
    """产品活的「范围」没写覆盖哪些 CLI 时返回报错文字，否则 None。"""
    lines, lead = text.splitlines(), _handoff_rules.load().get("lead", "")
    sec = lambda n: [x for seg in _handoff_rules._sections(lines, n, lead) for x in seg]
    if not any(PRODUCT_RE.search(x) for n in PRODUCT_SECS for x in sec(n)):
        return None
    if any(CLI_RE.search(x) for x in sec("范围")):
        return None
    return ("这件是产品活（交接提到产品/bothouse），「范围」要写覆盖哪些 CLI：点名 Claude Code 以外的 CLI（Codex、Gemini、grok 等）"
            "或写「所有 CLI」；只能做部分 CLI 的，写明其它 CLI 做不了的来源；跟 CLI 无关写「CLI：不涉及」。示例：\n" + CLI_EXAMPLE)


# 三类活（出图、改用户文档、定方向）派出去前，派活人自己定的决定单列给用户看一眼：交接里写一行「类别：出图」，
# 加「## 派活人自己定的」节（每条一行，没有写「无」）；不带 --confirmed 时只打出清单不交出，用户看过再带 --confirmed 重跑。
# 来源：10-30 第三轮重放，只有「派活人单列自己定的主意给用户看」拦住了返工（用户「可以试一下」）。其他类的活不受影响。
GATED = ("出图", "改用户文档", "定方向")
OWN = "派活人自己定的"
OWN_EXAMPLE = "类别：出图\n## 派活人自己定的\n- 画风照上次头像，不换\n- 尺寸 1024×1024"


def gated_kind(text: str):
    for l in text.splitlines():
        m = re.match(r"类别\s*[:：]\s*(.+)", l.lstrip("#-*> \t"))
        if m:
            hit = [k for k in GATED if k in m.group(1)]
            if hit:
                return hit[0]
    return None


def own_decisions(text: str):
    """「派活人自己定的」节里的每一行（去掉 -、* 等前缀，空行不算）；没有这一节返回 None。"""
    lines, out, found = text.splitlines(), [], False
    for i, l in enumerate(lines):
        if l.lstrip().startswith("#") and OWN in l:
            found = True
            for x in lines[i + 1:]:
                if x.lstrip().startswith("#"):
                    break
                if x.strip("-*> \t"):
                    out.append(x.strip("-*> \t"))
    return out if found else None


def own_gate(text: str, confirmed: bool):
    """三类活没过确认时返回要打给派活人的话（不交出），否则 None。"""
    kind = gated_kind(text)
    if not kind:
        return None
    own = own_decisions(text)
    if not own:
        return (f"这件是「{kind}」类，交接要有「{OWN}」节：用户原话里没有、你自己定的决定每条一行，没有写「无」。示例：\n"
                f"{OWN_EXAMPLE}")
    if confirmed:
        return None
    return (f"这件是「{kind}」类，还没交出。先把下面这份清单原样贴给用户，用户回过（没拦或改完交接）再加 --confirmed 重跑：\n"
            f"{OWN}：\n" + "\n".join(f"- {x}" for x in own))


# 防重复派：同一份交接文件在任务板上已有进行中（board.jsonl 里、没暂停；排队也算）的条目就拒绝再交，带 --force 放行。
# 路径按 realpath 比，忽略 record_last 加的 @ws…@task… 后缀。来源：10-31 凌晨重复派同一件，两个会话同改一个目录约 15 分钟
# （首次 10-30 #780），复盘 role-household-puck185-night-retro-1031.md 第 6 条。
def _real(where: str) -> str:
    return os.path.realpath(os.path.expanduser(re.sub(r"@ws.*$", "", str(where or ""))))


def live_dup(path: str):
    """同一份交接文件进行中的任务板条目（没有返回 None）。"""
    me = _real(path)
    return next((i for i in board.items() if not i.get("paused") and i.get("where") and _real(i["where"]) == me), None)


def dup_error(it) -> str:
    where = it.get("who") or it.get("ws") or "工作区"
    return (f"这份交接已有进行中的活 #{it['id']}（{where}，状态：{it.get('status') or '—'}），没再交。"
            f"要接着做用 ws-forward 转话；确实要再开一件，加 --force 重跑。")


def fixed_channel(chat: str) -> str:
    """配了 WS_CHANNEL / 团队文件 "workspace" 时固定用它；不带平台前缀就沿用当前聊天频道的平台（都没有按 discord）。
    不再自己用平台 token 查/建频道：配的频道没了，timer add 会报错；不配就走桥的共享池（workspace new 由桥建频道/建群）。"""
    ws = _team.workspace()
    if ":" in ws:
        return ws
    return f"{chat.split(':', 1)[0] if ':' in chat else 'discord'}:{ws}"


def cc_bin() -> str:
    return os.environ.get("CC_BIN") or shutil.which("bothouse") or shutil.which("cc-connect") or "cc-connect"


def ws_cmd(chat: str, *args):
    """<桥> workspace <args> --session-key <chat> --json；失败 sys.exit 带桥的原话。"""
    r = subprocess.run([cc_bin(), "workspace", *args, "--session-key", chat, "--json"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"ws-handoff: workspace {args[0]} 失败：{r.stderr.strip() or r.stdout.strip()}")
    try:
        return json.loads(r.stdout or "{}")
    except ValueError:
        sys.exit(f"ws-handoff: workspace {args[0]} 回的不是 JSON：{r.stdout.strip()[:200]}")


def num(name: str) -> int:
    m = re.fullmatch(r"工作区(\d+)", str(name or ""))
    return int(m.group(1)) if m else 10 ** 9


def _park_until_freed(key: str, parent: str) -> int:
    """<桥> workspace park 到工作区放回（每次放 parent 交的一件；工作区不归 parent 了桥就拒绝），返回放了几件。"""
    n = 0
    while True:
        p = subprocess.run([cc_bin(), "workspace", "park", "--session-key", key, "--chat", parent, "--json"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            return n
        n += 1
        try:
            if json.loads(p.stdout or "{}").get("freed"):
                return n
        except ValueError:
            return n


def migrate_unbound(chat: str, plat: str, parent: str, pool: list) -> bool:
    """一次性迁移（每个聊天频道只做一次）：升级前交的活在桥里记了交接、任务板上没绑编号；本频道占着的工作区里，
    任务板上已没有在做的条目时，把这些旧交接放回，工作区回池子。在做 = 没暂停的条目（later 回查的也算：它在等 CI，
    到点要回来接着做），按条目所在频道（sk/ch）或「谁」写的工作区名（升级前常由聊天频道 add、工作区只改「谁」，
    条目频道是聊天频道）认工作区；拿不准就不放（宁可多占，不停在做的活，审查 pr261-code.md 第 3 条）。之后的交接都绑编号
    （main 建条目），放回只看绑定条目（board pause / 把「谁」改走）。还有在做条目的工作区不动，等那些条目收尾。
    来源：本机止血审查第二轮（~/.claude/reviews/ws-stale-local-code.md）后的根因方案（notes/ws-stale-occupy-1025.md）。
    返回是否放回了工作区（要重新 list）。"""
    try:
        done = set(json.loads(MIGRATED.read_text(encoding="utf-8")))
    except (OSError, ValueError, TypeError):
        done = set()
    if parent in done:
        return False
    working = [i for i in board.items() if not i.get("paused")]
    live = {board._ws_key(i) for i in working} | {i.get("ws") for i in working}
    names = {m.group(1) for i in working for m in [board.WS_NAME_RE.match(str(i.get("who") or ""))] if m}
    freed = False
    for w in pool:
        if not isinstance(w, dict):
            continue
        key = f"{plat}:{w.get('id')}"
        if (str(w.get("owner") or "") == parent and int(w.get("open") or 0) > 0 and key not in live
                and str(w.get("name") or "") not in names):
            n = _park_until_freed(key, parent)
            print(f"ws-handoff: {w.get('name') or w.get('id')} 只剩升级前没绑任务板的交接，放回 {n} 件", file=sys.stderr)
            freed = freed or n > 0
    MIGRATED.parent.mkdir(parents=True, exist_ok=True)
    MIGRATED.write_text(json.dumps(sorted(done | {parent}), ensure_ascii=False), encoding="utf-8")
    return freed


def claim_cmd(chat: str, wid: str, task: str):
    """<桥> workspace claim：旗标写在工作区 id 前（Go flag 遇到第一个位置参数就停，写在后面的 --session-key/--title
    会被丢掉）；--title 是任务简称，十分钟看门催促里用（cmd/cc-connect/workspace.go --title），同本机 ws-handoff bridge_claim。"""
    return [cc_bin(), "workspace", "claim", "--session-key", chat, "--title", task[:60], str(wid)]


def pick_pool(chat: str, task: str = ""):
    """共享池里挑一个工作区并 claim（记一件交接），返回（工作区会话 key <平台>:<id>，工作区名，交接的聊天频道 parent）；
    没有空的、池子又满 MAX_WS 个时返回 None（排队）。
    claim 不带 --owner：交接的 owner 为空时，桥的十分钟看门按本 bot 自己在工作区的发言（IsSelf）
    算进展（core/team_watch.go ownerSpoke）；接手的就是本 bot 的主角色，不用另传 id。"""
    board.pause_stale()
    plat = chat.split(":", 1)[0]
    r = ws_cmd(chat, "list")
    parent = str(r.get("parent") or chat)
    if migrate_unbound(chat, plat, parent, r.get("pool") or []):
        r = ws_cmd(chat, "list")
    ok = [w for w in r.get("pool") or [] if isinstance(w, dict) and w.get("id")
          and str(w.get("owner") or "") in ("", parent) and int(w.get("open") or 0) < BUSY]
    ok.sort(key=lambda w: (int(w.get("open") or 0), num(w.get("name"))))
    for w in ok:
        c = subprocess.run(claim_cmd(chat, w["id"], task), capture_output=True, text=True)
        if c.returncode == 0:
            return f"{plat}:{w['id']}", str(w.get("name") or w["id"]), parent
        print(f"ws-handoff: {w.get('name')} 认领不了（{c.stderr.strip()}），换下一个", file=sys.stderr)
    if len([w for w in r.get("pool") or [] if isinstance(w, dict) and w.get("id")]) >= MAX_WS:
        return None
    w = (ws_cmd(chat, "new").get("workspace") or {})
    if not w.get("id"):
        sys.exit("ws-handoff: workspace new 没回工作区")
    c = subprocess.run(claim_cmd(chat, w["id"], task), capture_output=True, text=True)
    if c.returncode != 0:
        sys.exit(f"ws-handoff: workspace claim 失败：{c.stderr.strip() or c.stdout.strip()}")
    print(f"ws-handoff: 池里没有不忙的工作区，用 {w.get('name') or w['id']}", file=sys.stderr)
    return f"{plat}:{w['id']}", str(w.get("name") or w["id"]), parent


SOURCE = "原话出处（程序附）"
_STAMP = re.compile(r"(\d{1,2})-(\d{1,2})\s+(\d{1,2}):(\d)([\dxX])")


def _window_start(text):
    """时间窗起点：用户原话那节里最早的「MM-DD HH:MM」（10:2x 按 10:20）往前 10 分钟；没有或早于 3 天前，取交活前 3 小时。"""
    import datetime as dt
    now = dt.datetime.now().astimezone()
    body = text.split(f"## {_QUOTE_SEC}", 1)[1].split("\n## ", 1)[0] if f"## {_QUOTE_SEC}" in text else ""
    got = []
    for m in _STAMP.finditer(body):
        mo, d, h, t, u = m.groups()
        try:
            got.append(now.replace(month=int(mo), day=int(d), hour=int(h), minute=int(t) * 10 + (0 if u in "xX" else int(u)),
                                   second=0, microsecond=0))
        except ValueError:
            continue
    got = [g for g in got if now - dt.timedelta(days=3) <= g <= now]
    return (min(got) - dt.timedelta(minutes=10)) if got else now - dt.timedelta(hours=3)


def append_source(path, chat, project=None):
    """给交接追加「原话出处」节：聊天频道 id、交活人的会话记录、时间窗，并把时间窗里这个聊天频道的原始对话
    （用户、主角色和队友的原话，来自桥的会话记录 sessions/<项目>_*.json）导出到 <交接>.原话.md。
    已有就不再加；出任何错只返回 None，不拦交活。来源：用户 11-01「工作区…他也可以看我们的会话原话啊，解决人类之间这种传递有损的问题」。"""
    try:
        text = Path(path).read_text(encoding="utf-8")
        if SOURCE in text or ":" not in (chat or ""):
            return None
        project = project or os.environ.get("CC_PROJECT", "")
        data = Path(os.environ.get("CC_DATA_DIR") or Path.home() / ".bothouse")
        start = _window_start(text)
        msgs, agent_ids = [], []
        for f in sorted((data / "sessions").glob(f"{project}_*.json")):
            d = json.loads(f.read_text(encoding="utf-8"))
            sids = (d.get("user_sessions") or {}).get(chat) or []
            for sid in sids:
                s = (d.get("sessions") or {}).get(sid) or {}
                if s.get("agent_session_id"):
                    agent_ids.append(s["agent_session_id"])
                for m in s.get("history") or []:
                    ts = m.get("timestamp") or ""
                    if ts and ts >= start.isoformat():
                        msgs.append((ts, m.get("role") or "?", m.get("content") or ""))
        msgs.sort()
        dump = Path(path).with_suffix("").as_posix() + ".原话.md"
        with open(dump, "w", encoding="utf-8") as fh:
            fh.write(f"# 聊天频道 {chat} 原始对话（{start:%m-%d %H:%M} 到交活，{len(msgs)} 条）\n")
            fh.write("# user 条里有用户和队友的原话（行头「[时:分] 名字:」）；assistant 是主角色自己说的。\n\n")
            for ts, role, c in msgs:
                fh.write(f"### {ts[5:16].replace('T', ' ')} {role}\n{c}\n\n")
        tr = ""
        if agent_ids:
            hits = sorted(Path.home().glob(f".claude/projects/*/{agent_ids[-1]}.jsonl"))
            tr = str(hits[0]) if hits else ""
        lines = [f"## {SOURCE}",
                 "（交活时程序附：开工先读这里的原始对话，再读总部判断那节；交接正文是主角色的转述，和原话冲突时信原话）",
                 f"- 聊天频道：{chat}",
                 f"- 时间窗：{start:%m-%d %H:%M} 到交活",
                 f"- 原话导出：{dump}（{len(msgs)} 条）",
                 f"- 读原话：sed -n '1,400p' '{dump}'"]
        if tr:
            lines.append(f"- 主角色交活时的会话记录：{tr}")
        lines.append(f"- 时间窗外再找：{Path(__file__).resolve().parent / 'chanlog'} <关键词> --since {start:%m-%d} --full")
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("" if text.endswith("\n") else "\n") + "\n" + "\n".join(lines) + "\n")
        return dump
    except Exception:  # noqa: BLE001
        return None


def _codemap():
    """codemap-inject.py（派子任务附地图的那份选图逻辑，#875 已五家通用）：装好的在数据目录 hooks/，仓库里在 ../hooks/。"""
    import importlib.util
    data = os.environ.get("CC_DATA_DIR")
    for d in ([Path(data) / "hooks"] if data else []) + [Path(__file__).resolve().parent.parent / "hooks",
                                                          Path.home() / ".bothouse" / "hooks"]:
        f = d / "codemap-inject.py"
        if f.is_file():
            spec = importlib.util.spec_from_file_location("codemap_inject", f)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


def kickoff_maps(path, task):
    """开工要读的地图和手册。地图：按任务名 + 交接正文用 codemap-inject.pick 挑（同派子任务的规则：去掉路径网址后
    命中至少 2 个关键词）；手册：本目录的工作区规矩手册 PLAYBOOK。返回开工提示里的一段话，出错只少这一段，不拦交活。
    来源：用户 11-01「工作区…就没有代码地图那种非常笨，或者说除了代码地图之外，一些操作手册，一些东西他都没有」。"""
    out = []
    try:
        mod = _codemap()
        if mod:
            text = task + "\n" + Path(path).read_text(encoding="utf-8", errors="ignore")
            hits = mod.pick(mod.strip_paths(text))  # 交接里已写了地图路径的也列上
            if hits:
                out.append("先读代码地图 " + "、".join(hits) + "，按里面的符号直接定位，不要从头摸代码、找编译器、找上一棒的脚本；"
                           f"交回 [report] 的细节里附一节「## 地图要补的条目（<地图完整路径>）」，每条一行「- 符号 文件:行」，"
                           "交回时会自动补进地图。")
            else:
                out.append(f"这件活没对上现成的代码地图（地图目录 {mod.MAP_DIR}，每张的 keywords: 行是触发词），"
                           "开工前先看一眼目录里有没有相关的。")
    except Exception:  # noqa: BLE001
        pass
    here = Path(__file__).resolve().parent
    manual = here / "PLAYBOOK.zh-CN.md"
    if manual.is_file():
        out.append(f"工作区规矩手册：{manual}。")
    return "".join(out)


# 工作区开工清单：替掉「把还没派的活当场派出去」——工作区接的活自己做，开工不再去读派活手册（pm-dispatch.md）
KICKOFF = ("工作区开工：这件活你自己做，不用读派活手册、不再拆给别人；引用的脚本和状态文件写完整路径，不放 /tmp；"
           "浏览器活记下标签页 id。")


def timer_cmd(ws: str, path: str, task: str, nid="<任务板编号>", answer=None):
    """叫醒工作区会话。--handoff：这一轮是交过来的活，不是例行定时，桥照常自动开公开任务卡
    （core/public_progress_auto.go timerTurnUser）。不带 --inject-if-busy：工作区正有别的活在跑时这一轮排在后面，
    轮到时自己开一轮、开自己的卡；插进那一轮不会开卡（审稿 pr410 必须改 1，桥 ExecuteTimerJob 对 Handoff 也不插）。
    开工提示对照本机 ws-handoff timer_cmd：任务板编号、上报方式。--desc 带任务：桥把它当这一轮的任务名（谁在干啥、
    频道任务板，core/team.go teamNoteTurn → boardDescOf），不是把开工提示当任务名（#597 G36）。"""
    head = (f"你是工作区频道里的主角色，接着做一件提问后停下的活：{task}。用户答复了：{answer}\n"
            f"先读交接 {path}（之前的进度都在里面）。这块活在任务板是 #{nid}，接手后用 board update {nid} <状态> 更新，"
            if answer is not None else
            f"你是工作区频道里的主角色，从主频道接手一整块大活：{task}。"
            f"先读交接 {path}。这块活交活时已在任务板建好 #{nid}，接手后用 board update {nid} <状态> 更新，")
    prompt = (head +
              f"不要再 board add 这块活；本轮会自动开公开任务卡。接手后发五段式说明。" + KICKOFF + kickoff_maps(path, task) +
              f"先读交接里「{SOURCE}」的原始对话，再读总部判断那节：总部判断定做什么、为什么、做成什么样算好，照办；怎么做你定。"
              f"交接里的「{_QUOTE_SEC}」和「{_recall.SECTION}」是准绳；旧定案和用户原话冲突、或拿不准用户意思时，"
              f"先问聊天频道的主角色（ws-up --notes {path} \"<问题>\"，不带 --ask），不直接问用户；"
              f"主角色搜 wiki 和历史会话后代用户答，答不了才转用户。"
              f"有问题、要用户拍板用 ws-up --notes {path} \"<问题+选项+推荐>\" --ask，等聊天频道转回答复再做，"
              f"等的时候先做不受影响的部分；不在工作区里问用户。会缩小或改变用户原话范围的决定也先 --ask，纯技术细节自己定。"
              f"只做交接里写成「改」的部分；用户原话里没有的设定、开关、参数不加，要加先 --ask。"
              f"做完交回：这一轮最后一条回复的第一行写 [report] #{nid} 背景：……，再起一行写做了什么，再一行写「要你做的：……」（只写要用户拍板或只有用户本人能做的事；你自己能验的先验完，不让用户替你核对，没有写「要你做的：没有」），再一行写「我加的：……」（用户原话里没有、你自己加的设定，没有写「我加的：无」）（这四段系统原样贴到聊天频道），之后的行是细节，贴在那条消息下的子话题（中途发的话不转）；"
              f"交回后桥自动把这件标完成、清空会话、放回工作区")
    key = ws if ":" in ws else f"discord:{ws}"
    return [cc_bin(), "timer", "add", "-s", key, "--delay", "1m", "--timeout-mins", "0",
            "--handoff", "--desc", f"工作区{'接回' if answer is not None else '接手'}：{task}", "--prompt", prompt]


def record_last(path: str, ws: str, task: str, chat: str, nid=None):
    """记最近一次交接（ws-forward 默认转给它），并按交接文件记来源聊天频道（ws-up 按它报回、ws-forward --notes 按它转）。"""
    try:
        last = json.loads(_team.LAST.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        last = {}
    tasks = last.get("tasks") if isinstance(last, dict) and isinstance(last.get("tasks"), dict) else {}
    rec = {"channel": ws.split(":", 1)[-1], "chat": chat, "task": task, "board": [nid] if nid else []}
    if ":" in ws:
        rec["ws_key"] = ws
    old = tasks.get(path)
    key = path
    if isinstance(old, dict) and str(old.get("channel") or "") != rec["channel"]:
        # 同一份交接交给另一个工作区：另记一条（ws-up/ws-forward 用 --notes <文件>@ws<id> 认），不覆盖前一条
        key, rec["file"] = f"{path}@ws{rec['channel']}", path
    if key in tasks:
        base = f"{path}@ws{rec['channel']}@task{nid or len(tasks) + 1}"
        key = base
        serial = 1
        while key in tasks:
            key = f"{base}-{serial}"
            serial += 1
        rec["file"] = path
    tasks[key] = rec
    _team.LAST.write_text(json.dumps({"file": path, "channel": ws, "task": task, "chat": chat, "tasks": tasks},
                                     ensure_ascii=False), encoding="utf-8")


@contextlib.contextmanager
def _queue():
    """排队表（加锁读改写）：yield 列表，退出时写回。"""
    import fcntl
    QUEUE.parent.mkdir(parents=True, exist_ok=True)
    with open(str(QUEUE) + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            q = json.loads(QUEUE.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            q = []
        q = [x for x in q if isinstance(x, dict) and x.get("nid")] if isinstance(q, list) else []
        yield q
        QUEUE.write_text(json.dumps(q, ensure_ascii=False), encoding="utf-8")


def _lead_name(project):
    return _team.name_of(project) if project else "主角色"


def arm_drift(nid):
    """挂看门查跑偏（drift-check，每 10 分钟拿原话和旧定案对照工作区发言）；挂不上只警告，不拦交活。"""
    try:
        r = subprocess.run([str(Path(__file__).resolve().parent / "drift-check"), "--arm", str(nid)],
                           capture_output=True, text=True, timeout=60)
        if r.stderr.strip():
            print(r.stderr.strip(), file=sys.stderr)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"ws-handoff: #{nid} 查跑偏没挂上（{e}）", file=sys.stderr)


GUARD = None  # --guard 给的时长；None 用 board.GUARD_DELAY


def start(path, task, chat, nid, project, answer=None):
    """挑空工作区、绑任务板 #nid、叫醒；没空的返回 False（调用方排队）。"""
    picked = pick_pool(chat, task)
    if picked is None:
        return False
    ws, name, parent = picked
    board.update(nid, "已交接", who=f"{name}{_lead_name(project)}")
    board.rebind(nid, ws)
    r = subprocess.run(timer_cmd(ws, path, task, nid, answer), capture_output=True, text=True)
    if r.returncode != 0:
        board._park_once(cc_bin(), ws, parent)
        sys.exit(f"ws-handoff: #{nid} 叫醒 {name} 失败：{r.stderr.strip() or r.stdout.strip()}")
    record_last(path, ws, task, chat, nid)
    board.arm_guard(nid, GUARD)
    arm_drift(nid)
    print(f"ws-handoff: #{nid} 交给 {name}", file=sys.stderr)
    return True


def drain():
    """排队的活先排先接，接到没有空工作区为止（桥放回工作区后调，core/team_workspace_one.go drainTeamWorkspaceQueue）。"""
    with _queue() as q:
        while q:
            x = q[0]
            if not any(i["id"] == x["nid"] for i in board.items()):
                q.pop(0)  # 板上已没有（做完、撤掉）：不再接
                continue
            if not start(x["path"], x["task"], x["chat"], x["nid"], x.get("project"), x.get("answer")):
                break
            q.pop(0)


def resume_answered(nid, answer):
    """等你的活收到答复：恢复条目、答复写进交接，找空工作区接着做；没有就排队（core resumeAskedTask 调）。"""
    it = next((i for i in board.items() if i["id"] == nid), None)
    if it is None or not it.get("chat") or not os.path.isfile(it.get("where") or ""):
        sys.exit(f"ws-handoff: #{nid} 不是 ws-handoff 交的活，没法接回")
    board.resume(nid)
    board.append_forward(it["where"], f"{board._now()} 用户答复（#{nid}）：{answer}")
    _recall.append_to(it["where"])  # 改动前交出的活没有旧定案节，接回时补上（已有就跳过）
    project = os.environ.get("CC_PROJECT", "")
    with _queue() as q:
        if not start(it["where"], it["what"], it["chat"], nid, project, answer):
            board.update(nid, "排队")
            q.append({"nid": nid, "path": it["where"], "task": it["what"], "chat": it["chat"], "project": project, "answer": answer})
            print(f"ws-handoff: #{nid} 工作区都占着，排队", file=sys.stderr)


def main(argv):
    if argv[:1] == ["--drain"]:
        return drain()
    if argv[:1] == ["--resume"] and len(argv) == 3:
        return resume_answered(int(argv[1].lstrip("#")), argv[2])
    global GUARD
    if "--guard" in argv:
        k = argv.index("--guard")
        GUARD = argv[k + 1] if k + 1 < len(argv) else None
        if not GUARD or not re.fullmatch(r"(\d+h)?(\d+m)?", GUARD):
            sys.exit("ws-handoff: --guard 要写时长，如 30m、90m、2h")
        argv = argv[:k] + argv[k + 2:]
    confirmed = "--confirmed" in argv
    force = "--force" in argv
    argv = [a for a in argv if a not in ("--confirmed", "--force")]
    short_name = None
    if "--short" in argv:
        k = argv.index("--short")
        short_name = argv[k + 1] if k + 1 < len(argv) else None
        argv = argv[:k] + argv[k + 2:]
    if len(argv) != 2 or not argv[1].strip():
        sys.exit(USAGE)
    # 短名由交活人写，不再从任务句截前十字（用户 10-30 认可的置顶表方案：没写就退回让写）。
    short_name = (short_name or "").strip()
    if not short_name or len(short_name) > board.SHORT_RUNES:
        sys.exit(f"ws-handoff: 要写 --short 短名（≤{board.SHORT_RUNES} 字，置顶任务表上显示的名字，比如 --short 任务表改版）")
    path, task = os.path.abspath(os.path.expanduser(argv[0])), argv[1]
    if not os.path.isfile(path):
        sys.exit(f"ws-handoff: 交接文件不存在 {path}\n{USAGE}")
    with open(path, encoding="utf-8") as fh:
        notes = fh.read()
    try:
        err = check_notes(notes)
    except RuntimeError as e:  # 规则文件读不到或写坏：报错不放行
        sys.exit(f"ws-handoff: {e}")
    if err:
        sys.exit(f"ws-handoff: {err}")
    err = generic_gate(notes)
    if err:
        sys.exit(f"ws-handoff: {err}")
    err = intent_gate(notes)
    if err:
        sys.exit(f"ws-handoff: {err}")
    gate = own_gate(notes, confirmed)
    if gate:
        sys.exit(f"ws-handoff: {gate}")
    dup = None if force else live_dup(path)
    if dup:
        sys.exit(f"ws-handoff: {dup_error(dup)}")
    # 交活前按原话和总目标搜旧定案，追加成交接的「旧定案（程序搜出）」节；搜不到写「没搜到」，出错跳过，都不拦交活
    if _recall.append_to(path):
        print(f"ws-handoff: 已附「{_recall.SECTION}」", file=sys.stderr)
    chat = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    if append_source(path, chat):
        print(f"ws-handoff: 已附「{SOURCE}」", file=sys.stderr)
    parent = ""  # 走共享池时交接记在桥里的聊天频道；叫醒失败按它撤掉刚 claim 的那件
    if _team.workspace():
        ws, name = fixed_channel(chat), "工作区"
    elif ":" not in chat:
        sys.exit("ws-handoff: 没配工作区频道（WS_CHANNEL / 团队文件 \"workspace\"），也不在桥的会话里（CC_SESSION_KEY），没法从池里挑工作区")
    else:
        picked = pick_pool(chat, task)
        if picked is None:
            nid = board.add(task, path, "排队", "待接手", chat=chat, short_name=short_name)
            with _queue() as q:
                q.append({"nid": nid, "path": path, "task": task, "chat": chat, "project": os.environ.get("CC_PROJECT", "")})
            print(f"ws-handoff: 任务板 #{nid}", file=sys.stderr)
            print(f"queued #{nid}")
            print(f"{MAX_WS} 个工作区都在做活，#{nid} 已排队；有工作区空出来桥会自动接上。跟用户说一句排队了，本轮到此结束。")
            return
        ws, name, parent = picked
    # 先上任务板、绑这个工作区（编号要写进开工提示，同本机 ws-handoff 先 board_add 再叫醒）：
    # 放回只看绑定的条目（board pause / 把「谁」改走），刚交的活不会被当成没人做
    key = ws if ":" in ws else f"discord:{ws}"
    lead_name = _team.name_of(os.environ["CC_PROJECT"]) if os.environ.get("CC_PROJECT") else "主角色"
    nid = board.add(task, path, "已交接", f"{name}{lead_name}", ws=key, chat=chat, short_name=short_name)
    r = subprocess.run(timer_cmd(ws, path, task, nid), capture_output=True, text=True)
    if r.returncode != 0:
        # 叫醒失败：撤掉刚上的板和刚 claim 的那一件交接（只放这一件，同 board pause 的 park），不留给看门判无进展
        # _park_once 返回 None（桥没响应、拒绝或出错）时交接还记在桥里，不能说撤掉了（审稿 pr410 必须改 2）
        board.unadd(nid)
        why = r.stderr.strip() or r.stdout.strip()
        if not parent:
            sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid}）：{why}")
        buf = io.StringIO()
        with contextlib.redirect_stderr(buf):
            parked = board._park_once(cc_bin(), key, parent)
        if parked is None:
            m = re.search(r"工作区没放回（(.*)）", buf.getvalue(), re.S)
            reason = (m.group(1) if m else buf.getvalue()).strip() or "workspace park 没成功"
            sys.exit(f"ws-handoff: timer add 失败：{why}\n"
                     f"任务板已撤，交接没放回（{reason}），桥恢复后跑 workspace park --session-key {key} --chat {parent}")
        sys.exit(f"ws-handoff: timer add 失败（已撤掉任务板 #{nid} 和这件交接）：{why}")
    record_last(path, ws, task, chat, nid)
    guard = board.arm_guard(nid, GUARD)
    arm_drift(nid)
    print(f"ws-handoff: 任务板 #{nid}" + (f"，兜底定时器 {guard}（{GUARD or board.GUARD_DELAY}）" if guard else ""), file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id
    # 交出后主角色就收手：G27 实测里没有这句时，主角色在本轮 sleep 50 秒查任务板等工作区，聊天频道被占 8–11 分钟
    print(DONE.format(name=name))


if __name__ == "__main__":
    main(sys.argv[1:])
