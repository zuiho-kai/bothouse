#!/usr/bin/env -S python3 -I
# 用法：d10 <队友名字/别名/平台ID> "<活的简称>"  —— 群里派给队友的活，10 分钟后由当主角色自己的账号发「暂停」打断。
# 到点由 d10-fire 先读频道：队友已交回就跳过暂停。
# 来源：用户 2026-10-23「这10分钟之内搞不完就滚蛋」「都搞」；打断靠 gate 的 abort 动作。
# 队友 ID 从团队文件读（_team.py），发消息的身份 = 调用者的 CC_PROJECT，频道 = 调用者的 CC_SESSION_KEY。
import os, shlex, subprocess, sys, time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _team  # noqa: E402

DELAY = "10m"  # 来源：用户 2026-10-23「这10分钟之内搞不完就滚蛋」


def main(argv):
    if len(argv) != 2 or not argv[1].strip():
        sys.exit('用法：d10 <队友名字或ID> "<活的简称>"')
    tid = _team.member_id(argv[0])
    if not tid:
        sys.exit(f"d10: 团队文件里认不出 {argv[0]!r}，或她没写 \"id\"")
    # DSH 会删掉名字带 KEY 的环境变量，入口另导出一份 CC_SESSION（同 later）
    skey = os.environ.get("CC_SESSION_KEY", "") or os.environ.get("CC_SESSION", "")
    if not skey:
        sys.exit("d10: 读不到 CC_SESSION_KEY 或 CC_SESSION（要在 cc-connect 会话里跑）")
    fire = Path(__file__).resolve().with_name("d10-fire")
    cmd = " ".join(shlex.quote(x) for x in (str(fire), tid, argv[1], str(int(time.time())), skey, _team.project()))
    cc = _team.cc_bin()
    if not cc:
        sys.exit("d10: 找不到 bothouse / cc-connect（可设 CC_BIN）")
    r = subprocess.run([cc, "timer", "add", "-p", _team.project(), "-s", skey, "--delay", DELAY, "--desc", f"10分钟砍活:{argv[1]}", "--exec", cmd],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"d10: timer add 失败：{r.stderr.strip() or r.stdout.strip()}")
    print((r.stdout.strip().splitlines() or [""])[0])  # 桥输出第一行就是 timer id


if __name__ == "__main__":
    main(sys.argv[1:])
