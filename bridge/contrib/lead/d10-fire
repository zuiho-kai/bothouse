#!/usr/bin/env -S python3 -I
# d10 到点时由桥（bothouse / cc-connect）的 timer 调用：队友已交回就不发「暂停」，没交回才发。
# 用法：d10-fire <队友id> <简称> <派活epoch> <session_key> <发消息的 cc-connect project> [--renew N] [--dry-run]（d10 填好参数）
# 续期：没交回时再看最近 10 分钟她有没有动静（团队文件里她的 "wt" 目录下有新提交；
#   或她在频道里发了非表态消息；频道消息经桥的 GET /channel/history 读，见 fetch_messages），
#   有就再挂一个 10 分钟的 d10-fire（--renew 计数），有进展就一直续（MAX_RENEW 0 = 不设上限）；
#   没动静、或续期定时没挂上，照发暂停。
# 来源：用户 2026-10-23「复盘一下现在的工作流程，看看怎么样更好的就是我们并行的团队模式的去搞」；
#   事故：2026-10-23 上午 d10 计时 4 次在队友早已交回后白发「暂停」（03:46、10:39 彩虹猫，10:47 前后），
#   还打断了队友手上的下一件活。规则靠自觉管不住，改成到点自动判断。
# 事故二：2026-10-24 队友结果和【接】写在同一条（577 字，没有「交付」等词），被判成接单表态发了暂停，打断了她新接的活。
#   改为：交回 = 派活后她发的非纯表态实质回复；派活后她又被 @ 派了新活，旧 d10 一律不发暂停。
import os, re, shlex, subprocess, sys, time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _team  # noqa: E402
import _watch

STATUS_PREFIXES = ("↪", "⏹", "📬")  # gate 状态行（本任务原话）
MIN_LEN = 80                         # 短于 80 字视为状态行（本任务原话）
# PR 链接一律算交回（接单消息「【接】已派子 agent」不算交回）
PR_LINK_RE = re.compile(r"github\.com/[^\s]+/pull/\d+")
# 【接】开头的消息达到这个长度就算带结果的交回，不是纯表态（事故二：带结果的【接】577 字；纯接单约 90 字）
ACCEPT_WITH_RESULT_LEN = 300
# 开头的 @：原始 <@id>，或桥（Discord ContentWithMentionsReplaced）换成的 @用户名
LEADING_MENTION_RE = re.compile(r"^((<@!?\d+>|@[^\s【@]+)\s*)+")
# 桥给回复加的前缀「[回复 X：被回复正文前 40 字…] 」（discord.go ChannelHistory）；只看她自己写的正文（审查 PR #377）
REPLY_PREFIX_RE = re.compile(r"^\[回复 [^：\n]{1,100}：(?:.{40}…|.{0,40}?)\] ", re.S)
PAUSE_MARK = "暂停（「"
WATCH_MARKS = (PAUSE_MARK, "接着做 ", "到检查时间了", "到了检查时间")
# 续期上限：0 = 不设上限，有进展就一直续（用户 2026-10-26「有进展就一直续，没进展才停」#429）；
# 续期也必须有新进展，否则照发暂停。
MAX_RENEW = 0
STANCE_PREFIXES = ("【接】", "【问】", "【退】", "【升】")
WINDOW = 600  # 看「最近 10 分钟」有没有动静，和 d10 的 10 分钟一致


def body(content: str) -> str:
    # 她自己写的正文：去掉桥加的回复前缀和开头的 @
    c = REPLY_PREFIX_RE.sub("", (content or "").strip(), count=1)
    return LEADING_MENTION_RE.sub("", c.strip())


def is_handback(content: str) -> bool:
    # 交回 = 不是 gate 状态行、不是纯接单表态的实质回复；不靠关键词判断（事故二）
    c = body(content)
    if not c or c.startswith(STATUS_PREFIXES):
        return False
    if PR_LINK_RE.search(c):
        return True
    if c.startswith("【接】"):
        # 纯接单表态里常写「做完交回」，不算交回；结果和【接】写在同一条时算交回（事故二）
        return len(c) >= ACCEPT_WITH_RESULT_LEN
    return len(c) >= MIN_LEN


def redispatched(messages, teammate_id: str, since: float) -> bool:
    # 派活后频道里又有人 @ 她 = 派了新活，旧 d10 不能再打断（事故二）。
    # 第一次 @ 是本次派活本身：d10 在同一轮里挂上，派活消息在这一轮结束才发出，晚于 since。
    # 桥返回的 Discord 正文里 <@id> 已换成 @用户名：先看桥给的被 @ 用户 ID 列表（mentions）；
    # 平台没给 mentions 时退回正文匹配 <@id> 和她在本段历史里发过的消息的用户名
    names = {str(m.get("author", {}).get("username") or "") for m in messages
             if str(m.get("author", {}).get("id")) == str(teammate_id)} - {""}
    alts = [rf"<@!?{re.escape(str(teammate_id))}>"] + [rf"@{re.escape(n)}(?![\w])" for n in sorted(names)]
    mention = re.compile("|".join(alts))
    n = 0
    for m in messages:
        if ts_epoch(m) < since or str(m.get("author", {}).get("id")) == str(teammate_id):
            continue
        content = REPLY_PREFIX_RE.sub("", (m.get("content") or "").strip(), count=1)  # 被回复的原文里的 @ 不算
        ids = m.get("mentions")  # 桥只给正文里明写的 @（回复默认 ping 的那个不算，discord.go mentionIDs）
        hit = str(teammate_id) in ids if ids is not None else bool(mention.search(content))
        if hit and not any(mark in content for mark in WATCH_MARKS):
            n += 1
    return n >= 2


FRAC_RE = re.compile(r"(\.\d{1,6})\d*")  # 桥（Go）的时间带 9 位小数，Python 3.9 fromisoformat 只认 3/6 位


def ts_epoch(m) -> float:
    t = m["timestamp"].replace("Z", "+00:00")
    t = FRAC_RE.sub(lambda x: x.group(1).ljust(7, "0"), t, count=1)
    return datetime.fromisoformat(t).timestamp()


def handed_back(messages, teammate_id: str, since: float) -> bool:
    for m in messages:
        if str(m.get("author", {}).get("id")) != str(teammate_id):
            continue
        if ts_epoch(m) < since:
            continue
        if is_handback(m.get("content", "")):
            return True
    return False


def chat_active(messages, teammate_id: str, start: float) -> bool:
    # 她在 start 之后发过非空、非 gate 状态行、非开头表态的消息 = 还在干（空正文是进度卡；【接】【问】【退】【升】是表态不是进展）
    for m in messages:
        if str(m.get("author", {}).get("id")) != str(teammate_id) or ts_epoch(m) < start:
            continue
        c = body(m.get("content"))
        if c and not c.startswith(STATUS_PREFIXES + STANCE_PREFIXES):
            return True
    return False


def last_commit_epoch(teammate_id: str) -> float:
    # 她工作目录（团队文件成员的 "wt"，见 _team.worktrees）里各 git 副本 HEAD 的最新提交时间
    # （committer date，rebase/amend 也会刷新）；没配或找不到返回 0（只看频道动静）
    latest = 0.0
    for d in _team.worktrees(teammate_id):
        try:
            out = subprocess.run(["git", "-C", str(d), "log", "-1", "--format=%ct", "HEAD"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
            latest = max(latest, float(out or 0))
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
    return latest


def cc_bin():
    return _team.cc_bin()


def renew(tid, what, since, skey, proj, n, dry):
    me = str(Path(__file__).resolve())
    cmd = " ".join(shlex.quote(x) for x in (me, tid, what, f"{since:.0f}", skey, proj, "--renew", str(n)))
    cmd = "D10_API_SOCKET=" + shlex.quote(str(_watch.socket_path())) + " " + cmd
    cc = cc_bin()
    if not cc:
        print("续期定时没挂上（找不到 bothouse / cc-connect，可设 CC_BIN）", file=sys.stderr)
        return 1
    argv = [cc, "timer", "add", "-p", proj, "-s", skey, "--delay", "10m",
            "--desc", f"10分钟砍活:{what}(续{n})", "--exec", cmd]
    if dry:
        print(f"有新动静，会续 10 分钟（第 {n} 次）：{' '.join(argv)}")
        return 0
    print(f"有新动静，续 10 分钟（第 {n} 次）")
    try:
        return subprocess.run(argv).returncode
    except OSError as e:
        print(f"续期定时没挂上（{type(e).__name__}）", file=sys.stderr)
        return 1


def fetch_messages(skey: str, proj: str):
    """skey 所在频道最近的消息（Discord 消息形状：author.id/username、content、timestamp）。
    经桥的 GET /channel/history 读（_team.channel_history），脚本不碰平台 token（#597 K9）。
    平台不支持读历史 → None：没有频道信号，只按提交判断续期，否则照发暂停。"""
    rows = _team.channel_history(skey, proj)
    if rows is None:
        return None
    return [{"author": {"id": str(r.get("author_id") or ""), "username": r.get("author_name") or "", "bot": bool(r.get("is_bot"))},
             "content": r.get("content") or "", "timestamp": r.get("time") or "1970-01-01T00:00:00Z",
             **({"mentions": [str(x) for x in r["mentions"]]} if isinstance(r.get("mentions"), list) else {})} for r in rows]


def main(argv):
    dry = "--dry-run" in argv
    args = [a for a in argv if a != "--dry-run"]
    n = 0
    if "--renew" in args:
        i = args.index("--renew")
        try:
            n = int(args[i + 1])
        except (IndexError, ValueError):
            print("--renew 后要跟次数", file=sys.stderr)
            return 2
        del args[i:i + 2]
    if len(args) != 5:
        print("用法：d10-fire <队友id> <简称> <派活epoch> <session_key> <project> [--renew N] [--dry-run]", file=sys.stderr)
        return 2
    tid, what, since, skey, proj = args[0], args[1], float(args[2]), args[3], args[4]
    state = _watch.request("status", proj, skey, tid, what, since)
    if state and (state.get("covered") or state.get("returned")):
        print("桥已覆盖或任务已交回，跳过")
        return 0
    if state and not state.get("busy"):
        if dry:
            print(f"已停工，会叫醒：接着做 {what}，不用回话")
        else:
            _watch.request("wake", proj, skey, tid, what, since)
        return 0
    active = False
    try:
        msgs = fetch_messages(skey, proj)
        if msgs is None:
            raise LookupError("这个平台不支持读频道历史")
        if redispatched(msgs, tid, since):
            if state and not dry:
                _watch.request("close", proj, skey, tid, what, since)
            print("派活后又派了新活，跳过暂停")
            return 0
        # With registration, only the terminal event / explicit result decides
        # handback. A long progress update must not close an ongoing assignment.
        done = handed_back(msgs, tid, since) if state is None else False
        active = chat_active(msgs, tid, max(since, time.time() - WINDOW))
    except Exception as e:  # 读不到频道就按原行为发暂停，不吞掉打断
        print(f"读频道失败（{type(e).__name__}），只按提交判断续期，否则照发暂停", file=sys.stderr)
        done = False
    if done:
        if state and not dry:
            _watch.request("close", proj, skey, tid, what, since)
        print("已交回，跳过暂停")
        return 0
    if (MAX_RENEW <= 0 or n < MAX_RENEW) and (active or last_commit_epoch(tid) >= max(since, time.time() - WINDOW)):
        # 续期失败（timer 没挂上）就退回发暂停，不吞掉打断（同上面读不到频道的约定）
        if renew(tid, what, since, skey, proj, n + 1, dry) == 0:
            return 0
        print("续期失败，按原行为发暂停", file=sys.stderr)
    msg = f"<@{tid}> 到检查时间了，请交回「{what}」做到哪一步。"
    if dry:
        print(f"未交回，会发暂停：{msg}")
        return 0
    cc = cc_bin()
    if not cc:
        print("暂停没发出（找不到 bothouse / cc-connect，可设 CC_BIN）", file=sys.stderr)
        return 1
    if state:
        _watch.request("close", proj, skey, tid, what, since)
    return subprocess.run([cc, "send", "-p", proj, "-s", skey, "--message", msg]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
