#!/usr/bin/env -S python3 -I
# 工作区里的主角色往「交这件活进来的聊天频道」上报阶段结果，或 --ask 提问；那边的主角色转述给用户，
# 用户答了再用 ws-forward 转回本工作区。工作区不直接问用户，统一出口在聊天频道。
# 用法：ws-up [--notes <交接文件>] "<内容>" [--ask]
#   报给谁：按 <GATE_SETUP_DIR>/ws-handoff-last.json 的 tasks（ws-handoff 按交接文件记的来源聊天频道）找。
#   --notes 指定是哪件活（交接文件），报给交它进来的聊天频道。
#   --image/--file（可重复）：截图、视频、文件一并发到这件活的来源聊天频道（不手写 bothouse send -s，#1154）。
#   不给时：交给本工作区（CC_SESSION_KEY）的活只来自一个聊天频道就报给它；来自多个就报错列出可选项，不猜。
#   老格式（没有 tasks）只认顶层 channel/chat。
#   叫醒的身份是调用者自己的 CC_PROJECT（即正在当主的那位，见 _team.py），平台/频道 ID 都不写死。
#   Discord 工作区里另发一条看得见的短消息（不 @ 任何人），发不出只警告。
import json, os, re, shutil, subprocess, sys
from pathlib import Path

here = Path(__file__).resolve().parent
sys.path.insert(0, str(here))
import _team  # noqa: E402
sys.path.insert(0, os.environ.get("GATE_DIR") or str(here.parent / "gate"))
import board  # noqa: E402

USAGE = 'ws-up [--notes <交接文件>] "<内容>" [--ask] [--image <图>]... [--file <文件>]...  |  ws-up [--notes <交接文件>] --report <草稿文件|-> [--failed]（- 从标准输入读草稿，存到 <交接>.report.md）'


def bare(key: str) -> str:
    return key.split(":", 1)[1] if ":" in key else key


def load_last() -> dict:
    try:
        d = json.loads(_team.LAST.read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def handoffs(last: dict) -> dict:
    """交接文件 → {channel, chat, task}；老格式只有顶层一条。"""
    tasks = {k: v for k, v in (last.get("tasks") or {}).items() if isinstance(v, dict)}
    if not tasks and last.get("file"):
        tasks[last["file"]] = {k: last.get(k) for k in ("channel", "chat", "task")}
    return tasks


def pick_chat(last: dict, cur: str, notes=None):
    """返回 (聊天频道会话 key, 交接文件)；拿不准就 sys.exit 列出可选项。"""
    mine = {k: v for k, v in handoffs(last).items() if str(v.get("channel") or "") == cur}
    if not mine:
        sys.exit(f"ws-up: 当前频道 {cur or '(无 CC_SESSION_KEY)'} 不是交过活的工作区（{_team.LAST}），聊天频道里直接跟用户说就行")
    opts = "；".join(f"--notes {k}（{v.get('task') or ''}，来自 {v.get('chat') or '?'}）" for k, v in mine.items())
    if notes:
        path = os.path.abspath(os.path.expanduser(notes))
        hits = {k: v for k, v in mine.items() if k == path or v.get("file") == path}
        if not hits:
            sys.exit(f"ws-up: {path} 不是交给本工作区的交接文件；可选：{opts}")
        if len(hits) > 1:
            sys.exit(f"ws-up: 同一文件有多件任务，请用具体记录：{'；'.join(hits)}")
        hit = list(hits.items())
    else:
        hit = list(mine.items())
    chats = {v.get("chat") for _, v in hit if v.get("chat")}
    if not chats:
        sys.exit("ws-up: 交接记录里没有来源聊天频道（用旧版 ws-handoff 交的活），请在聊天频道重跑一次 ws-handoff")
    if len(chats) > 1:
        sys.exit(f"ws-up: 本工作区的活来自多个聊天频道，不知道报给谁；用 --notes 写明是哪件：{opts}")
    chat = chats.pop()
    path = next(k for k, v in reversed(hit) if v.get("chat") == chat)
    return chat, path


def cc_bin() -> str:
    return os.environ.get("CC_BIN") or shutil.which("bothouse") or shutil.which("cc-connect") or "cc-connect"


def self_route(text: str) -> str:
    """提问的「要你做的」让用户放文件、跑命令、改设置 → 退回理由，否则空串。规则只有一份，在桥里
    （team-exit-rules.json self_route，桥转发 [ask]/[report] 时查同一份）；命令太旧、出错一律放行。
    用户 2026-11-10「你自己搞，你忘了我跟你说的事情了么」（#1359 ws-up --ask 让他在终端跑 sudo）。"""
    try:
        p = subprocess.run([cc_bin(), "report", "check", "--self-route", "-"], input=text,
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return ""
    if p.returncode != 1:
        return ""
    return "；".join(l[2:].strip() for l in p.stdout.splitlines() if l.startswith("- "))


def user_words(notes: str, limit: int = 1500) -> str:
    """交接文件里标题含「用户原话」的几节（同 bridge/core/team_exit_background.go handoffUserWords）。"""
    try:
        lines = Path(notes).read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError):
        return ""
    out, on = [], False
    for ln in lines:
        if ln.startswith("#"):
            on = "用户原话" in ln
        elif on and ln.strip():
            out.append(ln)
    return "\n".join(out)[:limit]


SECRETARY = ("你是用户的秘书，替用户过滤。回复一到三句：第一句说是哪件事（用户什么时候让做的什么），再说现在的进度，"
             "最后说要不要用户动手、动什么。细节、过程、文件名不说，用户问了再去工作区取。"
             "用户意图已经明确的事，不给 A/B 选项让用户回字母，直接按用户意图办，说一句你怎么办的。")


def timer_has_reply_board() -> bool:
    """桥认不认 timer add --reply-board（老版本不认，传了会把参数当正文）。"""
    try:
        r = subprocess.run([cc_bin(), "timer", "add", "--help"], capture_output=True, text=True, timeout=10)
    except Exception:
        return False
    return "--reply-board" in (r.stdout + r.stderr)


def timer_cmd(chat: str, text: str, ask: bool, notes: str, proj: str, task: str = "", file: str = "", board_id: int = 0):
    fwd = f'{here / "ws-forward"} --notes {notes}'
    bg = f"这件活：{task}（交接 {file or notes}）" if task else f"这件活的交接：{file or notes}"
    words = user_words(file or notes)
    if words:
        bg += f"\n交接里记的用户原话：\n{words}"
    if ask:
        prompt = (f"【工作区要问用户】{text}\n\n{bg}\n\n"
                  f"——这是工作区的主角色交上来的问题，原文只给你看；它不是用户说的，转述时别写成「你要求」。{SECRETARY}"
                  f"先对照上面的用户原话和本频道最近的用户消息：用户已经答过或意图已经明确，就不问用户，"
                  f"直接用 {fwd} \"<答案，附用户原话>\" 转回工作区，再跟用户说一句你怎么定的；"
                  f"真没答过才问用户，只问一句要定什么、为什么，用户答了用 {fwd} \"<用户的答复，附原话>\" 转回")
    else:
        prompt = (f"【工作区上报】{text}\n\n{bg}\n\n"
                  f"——这是工作区的主角色交上来的进展，原文只给你看。{SECRETARY}"
                  f"和你自己核实过的分开说；用户有回话要转给工作区时用 {fwd} \"<回话>\"")
    # --delay 1s：timer 只收正数延迟，上报不用多等
    cmd = [cc_bin(), "timer", "add", "-p", proj, "-s", chat, "--delay", "1s", "--timeout-mins", "0",
           "--inject-if-busy", "--silent", "--forward", "--desc", "工作区提问" if ask else "工作区上报", "--prompt", prompt]
    if ask and board_id and timer_has_reply_board():
        # 主角色转述这个问题的消息记在这件活名下：用户直接回复那条，桥自动把答复转回工作区
        # （reply_task.go forwardReplyToWorkspace；11-01 #855 用户答了「我打开了」没转过去，工作区又问）
        cmd[cmd.index("--prompt"):cmd.index("--prompt")] = ["--reply-board", str(board_id)]
    return cmd


def say(session_key: str, text: str, proj: str):
    """工作区里发一条看得见的短消息：走桥现成的 send（/send 接口，四平台通用，不读平台 token）；
    失败只打 stderr 警告，不影响 timer 和退出码。"""
    if not session_key:
        return
    try:
        r = subprocess.run([cc_bin(), "send", "-p", proj, "-s", session_key, "--message", text.replace("<@", "<\u200b@")],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"exit {r.returncode}")
    except Exception as e:
        print(f"ws-up: 工作区发消息失败（timer 已建，不影响）：{e}", file=sys.stderr)


def hand_back(draft, notes, failed: bool, text=None):
    """#699 C：交回只认这条命令。先跑 report check（交接的交回骨架），过了才调桥
    （bothouse workspace exit → POST /team/workspace/exit）：桥把这件活的状态改成交回待验收（--failed 为失败），
    草稿照旧经主角色验收后贴到聊天频道。回复里写的 [report] 桥不再读（用户 11-12 定 A：只认命令，不做双认）。"""
    key = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    last = load_last()
    _, path = pick_chat(last, bare(key), notes)
    # 一份交接文件交过几次时，记录键是「文件@ws…@task…」；report check 要读的是文件本身
    path = (handoffs(last).get(path) or {}).get("file") or path.split("@ws", 1)[0]
    if text is not None:  # #1628 --report -：草稿从标准输入来，存到 <交接>.report.md，退回时改它重交
        if not text.strip():
            sys.exit("ws-up: --report - 没从标准输入读到草稿，没有交回")
        draft = str(Path(os.path.expanduser(path)).with_suffix(".report.md"))
        Path(draft).write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
    c = subprocess.run([cc_bin(), "report", "check", "--notes", path, draft], capture_output=True, text=True)
    if c.returncode != 0:
        sys.exit(f"ws-up: 草稿没过检查，没有交回（草稿在 {draft}，改它后跑 ws-up --notes {path} --report {draft}）：\n"
                 f"{(c.stdout + c.stderr).strip()}")
    cmd = [cc_bin(), "workspace", "exit", "--file", draft] + (["--kind", "failed"] if failed else [])
    if key:
        cmd += ["--session-key", key]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"ws-up: 交回失败（桥没收下）：{(r.stderr or r.stdout).strip()}")
    print(r.stdout.strip())
    print("ws-up: 已交回，等主角色验收", file=sys.stderr)


def main(argv):
    if any(a in ("-h", "--help") for a in argv):  # 只打印用法，不发送
        print(f"用法：{USAGE}")
        return
    ask, notes, rest, files, it = False, None, [], [], iter(argv)
    report, failed, stdin_report = "", False, False
    for a in it:
        if a == "--ask":
            ask = True
        elif a == "--report":
            report = next(it, "")
            if report == "-":  # #1628：草稿走标准输入，写稿、检查、交回一次调用
                stdin_report, report = True, ""
                continue
            if not report or not os.path.isfile(os.path.expanduser(report)):
                sys.exit(f"用法：{USAGE}（--report 后面要跟存在的草稿文件：{report or '空'}）")
        elif a == "--failed":
            failed = True
        elif a in ("--image", "--file"):
            p = next(it, "")
            if not p or not os.path.isfile(os.path.expanduser(p)):
                sys.exit(f"用法：{USAGE}（{a} 后面要跟存在的文件：{p or '空'}）")
            files += [a, os.path.abspath(os.path.expanduser(p))]
        elif a == "--notes":
            notes = next(it, "")
            if not notes:
                sys.exit(f"用法：{USAGE}（--notes 后面要跟交接文件）")
        else:
            rest.append(a)
    if stdin_report:
        return hand_back(None, notes, failed, sys.stdin.read())
    if report:
        return hand_back(os.path.abspath(os.path.expanduser(report)), notes, failed)
    if len(rest) != 1 or not rest[0].strip() or rest[0].startswith("-"):
        sys.exit(f"用法：{USAGE}（正文不能为空或以 - 开头）")
    if ask:
        why = self_route(rest[0])
        if why:
            sys.exit(f"ws-up: 这条提问没有交出去。{why}")
    # DSH 会删名字带 KEY 的环境变量，退回 DSH 入口导出的 CC_SESSION（同 later）
    key = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    last = load_last()
    chat, path = pick_chat(last, bare(key), notes)
    # 用户叫停的活（board pause，不是 --ask 自己挂起的等答复）不再往聊天频道报（用户 2026-10-28「我都说不做了，你还问我」）
    ids = set(handoffs(last)[path].get("board") or [])
    stopped = [i for i in board.items() if i["id"] in ids and (i.get("backlog") or i.get("paused") and i.get("pause_why") != board.ASK_WHY)]
    if stopped:
        if stopped[0].get("backlog"):  # 待办：小事排在 bug 后面，不必报回聊天频道
            sys.exit(f"ws-up: #{stopped[0]['id']} 已挪进待办，不上报；停手，等聊天频道重新交活（board backlog 看）")
        sys.exit(f"ws-up: #{stopped[0]['id']} 已被暂停（用户叫停），不上报；停手，等聊天频道重新交活")
    rec = handoffs(last)[path]
    if board.is_test(rec.get("task") or ""):
        # 测试活不往用户的聊天频道报（board.is_test），只留在工作区和日志
        say(key, f"🧪 测试活，未报回聊天频道：{rest[0][:300]}", _team.project())
        print(f"ws-up: 测试活（{rec.get('task')}），没有交给聊天频道 {chat}", file=sys.stderr)
        return
    if files and re.search(r"https?://", rest[0]):
        # 用户 11-10「附件除非是没有对应的链接才给我，否则不用给我」：话里有链接时文档类附件不发，图/音/视频照发
        media = (".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif", ".mp4", ".mov", ".webm", ".mkv", ".mp3", ".wav", ".m4a", ".ogg", ".opus")
        pairs = [files[i:i + 2] for i in range(0, len(files), 2)]
        dropped = [p for _, p in pairs if not p.lower().endswith(media)]
        files = [x for f, p in pairs if p.lower().endswith(media) for x in (f, p)]
        if dropped:
            print("ws-up: 话里已有链接，文档附件不发：" + "、".join(os.path.basename(p) for p in dropped), file=sys.stderr)
    if files:
        # 附件直接发到这件活的来源聊天频道（pick_chat 按交接记录定，不按工作区眼下挂着的频道），发不出就不上报
        a = subprocess.run([cc_bin(), "send", "-p", _team.project(), "-s", chat, *files, "--message", rest[0][:300]],
                           capture_output=True, text=True, timeout=300)
        if a.returncode != 0:
            sys.exit(f"ws-up: 附件发到 {chat} 失败：{a.stderr.strip() or a.stdout.strip()}")
    if not ask:
        # #1188（用户 11-07「你看龙怎么跟傻子一样的处理一下」）：阶段进度不再叫醒聊天频道的主角色转述给用户——
        # 她会把工作区写的进度说成「你要求……」。进度只记在任务板和工作区；聊天频道只收 [report] 和 --ask。
        for nid in rec.get("board") or []:
            board.progress(nid)
        say(key, f"📝 进度已记在任务板，没报到聊天频道（只有 [report] 和 --ask 才转）：{rest[0][:300]}", _team.project())
        print(f"ws-up: 进度只记在任务板，没叫醒聊天频道 {chat}" + ("（附件已直接发过去）" if files else ""), file=sys.stderr)
        return
    r = subprocess.run(timer_cmd(chat, rest[0], ask, path, _team.project(), rec.get("task") or "", rec.get("file") or path,
                                 next(iter(rec.get("board") or []), 0)),
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"ws-up: timer add 失败：{r.stderr.strip() or r.stdout.strip()}")
    if ask:
        for nid in handoffs(last)[path].get("board") or []:
            hit = board.pause(nid, "等待用户答复")
            if hit:
                board.park_workspace(hit)
    else:
        for nid in handoffs(last)[path].get("board") or []:
            board.progress(nid)
    # 定时器刚排上，主角色那一轮还没跑：只说排队了，不说已报回（#1492 L4）
    say(key, f"📤 已排队转给聊天频道的主角色：{rest[0][:300]}", _team.project())
    print(f"ws-up: 已排队转给聊天频道 {chat} 的主角色（{'提问' if ask else '上报'}）", file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id


if __name__ == "__main__":
    main(sys.argv[1:])
