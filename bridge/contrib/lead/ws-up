#!/usr/bin/env -S python3 -I
# 工作区里的主角色往「交这件活进来的聊天频道」上报阶段结果，或 --ask 提问；那边的主角色转述给用户，
# 用户答了再用 ws-forward 转回本工作区。工作区不直接问用户，统一出口在聊天频道。
# 用法：ws-up [--notes <交接文件>] "<内容>" [--ask]
#   报给谁：按 <GATE_SETUP_DIR>/ws-handoff-last.json 的 tasks（ws-handoff 按交接文件记的来源聊天频道）找。
#   --notes 指定是哪件活（交接文件），报给交它进来的聊天频道。
#   不给时：交给本工作区（CC_SESSION_KEY）的活只来自一个聊天频道就报给它；来自多个就报错列出可选项，不猜。
#   老格式（没有 tasks）只认顶层 channel/chat。
#   叫醒的身份是调用者自己的 CC_PROJECT（即正在当主的那位，见 _team.py），平台/频道 ID 都不写死。
#   Discord 工作区里另发一条看得见的短消息（不 @ 任何人），发不出只警告。
import json, os, shutil, subprocess, sys
from pathlib import Path

here = Path(__file__).resolve().parent
sys.path.insert(0, str(here))
import _team  # noqa: E402
sys.path.insert(0, os.environ.get("GATE_DIR") or str(here.parent / "gate"))
import board  # noqa: E402

USAGE = 'ws-up [--notes <交接文件>] "<内容>" [--ask]'


def bare(key: str) -> str:
    return key.split(":", 1)[1] if ":" in key else key


def load_last() -> dict:
    try:
        d = json.loads(_team.LAST.read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def handoffs(last: dict) -> dict:
    """交接文件 → {channel, chat, task}；老格式只有顶层一条。"""
    tasks = {k: v for k, v in (last.get("tasks") or {}).items() if isinstance(v, dict)}
    if not tasks and last.get("file"):
        tasks[last["file"]] = {k: last.get(k) for k in ("channel", "chat", "task")}
    return tasks


def pick_chat(last: dict, cur: str, notes=None):
    """返回 (聊天频道会话 key, 交接文件)；拿不准就 sys.exit 列出可选项。"""
    mine = {k: v for k, v in handoffs(last).items() if str(v.get("channel") or "") == cur}
    if not mine:
        sys.exit(f"ws-up: 当前频道 {cur or '(无 CC_SESSION_KEY)'} 不是交过活的工作区（{_team.LAST}），聊天频道里直接跟用户说就行")
    opts = "；".join(f"--notes {k}（{v.get('task') or ''}，来自 {v.get('chat') or '?'}）" for k, v in mine.items())
    if notes:
        path = os.path.abspath(os.path.expanduser(notes))
        hits = {k: v for k, v in mine.items() if k == path or v.get("file") == path}
        if not hits:
            sys.exit(f"ws-up: {path} 不是交给本工作区的交接文件；可选：{opts}")
        if len(hits) > 1:
            sys.exit(f"ws-up: 同一文件有多件任务，请用具体记录：{'；'.join(hits)}")
        hit = list(hits.items())
    else:
        hit = list(mine.items())
    chats = {v.get("chat") for _, v in hit if v.get("chat")}
    if not chats:
        sys.exit("ws-up: 交接记录里没有来源聊天频道（用旧版 ws-handoff 交的活），请在聊天频道重跑一次 ws-handoff")
    if len(chats) > 1:
        sys.exit(f"ws-up: 本工作区的活来自多个聊天频道，不知道报给谁；用 --notes 写明是哪件：{opts}")
    chat = chats.pop()
    path = next(k for k, v in reversed(hit) if v.get("chat") == chat)
    return chat, path


def cc_bin() -> str:
    return os.environ.get("CC_BIN") or shutil.which("bothouse") or shutil.which("cc-connect") or "cc-connect"


def user_words(notes: str, limit: int = 1500) -> str:
    """交接文件里标题含「用户原话」的几节（同 bridge/core/team_exit_background.go handoffUserWords）。"""
    try:
        lines = Path(notes).read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError):
        return ""
    out, on = [], False
    for ln in lines:
        if ln.startswith("#"):
            on = "用户原话" in ln
        elif on and ln.strip():
            out.append(ln)
    return "\n".join(out)[:limit]


SECRETARY = ("你是用户的秘书，替用户过滤。回复一到三句：第一句说是哪件事（用户什么时候让做的什么），再说现在的进度，"
             "最后说要不要用户动手、动什么。细节、过程、文件名不说，用户问了再去工作区取。"
             "用户意图已经明确的事，不给 A/B 选项让用户回字母，直接按用户意图办，说一句你怎么办的。")


def timer_cmd(chat: str, text: str, ask: bool, notes: str, proj: str, task: str = "", file: str = ""):
    fwd = f'{here / "ws-forward"} --notes {notes}'
    bg = f"这件活：{task}（交接 {file or notes}）" if task else f"这件活的交接：{file or notes}"
    words = user_words(file or notes)
    if words:
        bg += f"\n交接里记的用户原话：\n{words}"
    if ask:
        prompt = (f"【工作区要问用户】{text}\n\n{bg}\n\n"
                  f"——这是工作区的主角色交上来的问题，原文只给你看。{SECRETARY}"
                  f"先对照上面的用户原话和本频道最近的用户消息：用户已经答过或意图已经明确，就不问用户，"
                  f"直接用 {fwd} \"<答案，附用户原话>\" 转回工作区，再跟用户说一句你怎么定的；"
                  f"真没答过才问用户，只问一句要定什么、为什么，用户答了用 {fwd} \"<用户的答复，附原话>\" 转回")
    else:
        prompt = (f"【工作区上报】{text}\n\n{bg}\n\n"
                  f"——这是工作区的主角色交上来的进展，原文只给你看。{SECRETARY}"
                  f"和你自己核实过的分开说；用户有回话要转给工作区时用 {fwd} \"<回话>\"")
    # --delay 1s：timer 只收正数延迟，上报不用多等
    return [cc_bin(), "timer", "add", "-p", proj, "-s", chat, "--delay", "1s", "--timeout-mins", "0",
            "--inject-if-busy", "--silent", "--desc", "工作区提问" if ask else "工作区上报", "--prompt", prompt]


def say(session_key: str, text: str, proj: str):
    """工作区里发一条看得见的短消息：走桥现成的 send（/send 接口，四平台通用，不读平台 token）；
    失败只打 stderr 警告，不影响 timer 和退出码。"""
    if not session_key:
        return
    try:
        r = subprocess.run([cc_bin(), "send", "-p", proj, "-s", session_key, "--message", text.replace("<@", "<\u200b@")],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"exit {r.returncode}")
    except Exception as e:
        print(f"ws-up: 工作区发消息失败（timer 已建，不影响）：{e}", file=sys.stderr)


def main(argv):
    if any(a in ("-h", "--help") for a in argv):  # 只打印用法，不发送
        print(f"用法：{USAGE}")
        return
    ask, notes, rest, it = False, None, [], iter(argv)
    for a in it:
        if a == "--ask":
            ask = True
        elif a == "--notes":
            notes = next(it, "")
            if not notes:
                sys.exit(f"用法：{USAGE}（--notes 后面要跟交接文件）")
        else:
            rest.append(a)
    if len(rest) != 1 or not rest[0].strip() or rest[0].startswith("-"):
        sys.exit(f"用法：{USAGE}（正文不能为空或以 - 开头）")
    # DSH 会删名字带 KEY 的环境变量，退回 DSH 入口导出的 CC_SESSION（同 later）
    key = os.environ.get("CC_SESSION_KEY") or os.environ.get("CC_SESSION", "")
    last = load_last()
    chat, path = pick_chat(last, bare(key), notes)
    # 用户叫停的活（board pause，不是 --ask 自己挂起的等答复）不再往聊天频道报（用户 2026-10-28「我都说不做了，你还问我」）
    ids = set(handoffs(last)[path].get("board") or [])
    stopped = [i for i in board.items() if i["id"] in ids and i.get("paused") and i.get("pause_why") != board.ASK_WHY]
    if stopped:
        sys.exit(f"ws-up: #{stopped[0]['id']} 已被暂停（用户叫停），不上报；停手，等聊天频道重新交活")
    rec = handoffs(last)[path]
    r = subprocess.run(timer_cmd(chat, rest[0], ask, path, _team.project(), rec.get("task") or "", rec.get("file") or path),
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"ws-up: timer add 失败：{r.stderr.strip() or r.stdout.strip()}")
    if ask:
        for nid in handoffs(last)[path].get("board") or []:
            hit = board.pause(nid, "等待用户答复")
            if hit:
                board.park_workspace(hit)
    else:
        for nid in handoffs(last)[path].get("board") or []:
            board.progress(nid)
    say(key, f"📤 已报回聊天频道：{rest[0][:300]}", _team.project())
    print(f"ws-up: 已交给聊天频道 {chat}（{'提问' if ask else '上报'}）", file=sys.stderr)
    print((r.stdout.strip().splitlines() or [""])[0])  # cc-connect 第一行就是 timer id


if __name__ == "__main__":
    main(sys.argv[1:])
