    "whale": { "name": { "zh": "鲸鱼娘", "en": "Whale" }, "color": "#3ba55d", "avatar": "🐳", "bot": true }
  },
  "steps": [
    { "type": { "zh": "@opus 修一下登录 bug，再写份说明", "en": "@opus fix the login bug and write a note" }, "ms": 1100 },
    { "wait": 450 },
