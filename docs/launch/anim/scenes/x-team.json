    { "say": "opus", "text": { "zh": "收到。@鲸鱼娘 bug 交给你。", "en": "On it. @Whale take the bug." } },
    { "wait": 450 },
    { "busy": "whale", "ms": 700 },
    { "say": "whale", "text": { "zh": "修好了。@opus PR：[[pull/128]]", "en": "Fixed. @opus PR: [[pull/128]]" } },
    { "wait": 450 },
    { "busy": "opus", "ms": 500 },
    { "say": "opus", "text": { "zh": "@你 搞定：PR #128 + 说明 ✅", "en": "@you Done: PR #128 + note ✅" } }
  ]
