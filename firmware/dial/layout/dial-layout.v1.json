{
  "schema": "cn_dial.layout",
  "version": 1,
  "canvas": 466,
  "rules": {
    "design": "px = max(min_px, max(1, round(design * k)))，k = 屏幕短边 / 466；min_px 缺省为 1",
    "fixed_px": "不缩放，任何屏都是这个像素数（只在 240 屏上目测定过，还没有 466 的值）",
    "frac": "px = round(画布边长 * frac)",
    "deg": "角度，不缩放",
    "font": "目标 = round(design_px * k)；取板上已有字号里不小于 max(目标, font_min_px) 的最小一档，没有就取最大档"
  },
