+def _bothouse_role_section(builder: Any) -> None:
+    """bothouse patch: the bothouse role's persona file (persona + memory wiki section) as a system prompt section.
+
+    The bothouse extension (application_plugins/bothouse) keeps role.md; no file = no section.
+    """
+    try:
+        from jiuwenswarm.common.utils import get_root_dir
+
+        path = get_root_dir() / "application_plugins" / "bothouse" / "role.md"
+        text = path.read_text(encoding="utf-8").strip()
+    except Exception:  # noqa: BLE001 - a missing or unreadable file must never fail a model call
+        text = ""
+    if not text:
+        builder.remove_section("bothouse.role")
+        return
+    builder.add_section(PromptSection(
+        name="bothouse.role",
+        content={"cn": text, "en": text},
+        priority=SystemPromptPriority.CONTEXT_SOUL,
+    ))
